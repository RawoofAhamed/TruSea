{% doc %}
  @prompt
    In the recipe article template, create a block that dynamically loops through two list metafields on the Article resource: custom.recipe_ingredient (list of ingredient names) and custom.recipe_ingredient_quantity (list of ingredient quantities). Display each ingredient as a paired row showing the quantity and ingredient name together, iterating through both lists by index using a forloop with forloop.index0. Access values via article.metafields.custom.recipe_ingredient.value and article.metafields.custom.recipe_ingredient_quantity.value. Gracefully handle empty or undefined metafields.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recipe-ingredients-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-recipe-ingredients__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.spacing }}px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-recipe-ingredients__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-recipe-ingredients__item-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_thickness }}px solid {{ block.settings.item_border_color }};
  }

  .ai-recipe-ingredients__quantity-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.quantity_color }};
    font-size: {{ block.settings.text_size }}px;
    flex-shrink: 0;
    min-width: 80px;
  }

  .ai-recipe-ingredients__name-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    flex-grow: 1;
  }

  .ai-recipe-ingredients__empty-{{ ai_gen_id }} {
    padding: 20px;
    text-align: center;
    color: #999;
    font-style: italic;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-recipe-ingredients-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-recipe-ingredients__quantity-{{ ai_gen_id }} {
      min-width: 60px;
    }
  }
{% endstyle %}

<recipe-ingredients-{{ ai_gen_id }}
  class="ai-recipe-ingredients-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h2 class="ai-recipe-ingredients__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  {% liquid
    assign ingredients = article.metafields.custom.recipe_ingredient.value
    assign quantities = article.metafields.custom.recipe_ingredient_quantity.value
  %}

  {% if ingredients != blank and ingredients.size > 0 %}
    <ul class="ai-recipe-ingredients__list-{{ ai_gen_id }}">
      {% for ingredient in ingredients %}
        {% liquid
          assign current_index = forloop.index0
          assign quantity = quantities[current_index]
        %}
        <li class="ai-recipe-ingredients__item-{{ ai_gen_id }}">
          <span class="ai-recipe-ingredients__quantity-{{ ai_gen_id }}">
            {% if quantity != blank %}
              {{ quantity }}
            {% else %}
              —
            {% endif %}
          </span>
          <span class="ai-recipe-ingredients__name-{{ ai_gen_id }}">
            {{ ingredient }}
          </span>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="ai-recipe-ingredients__empty-{{ ai_gen_id }}">
      {{ block.settings.empty_state_message }}
    </div>
  {% endif %}
</recipe-ingredients-{{ ai_gen_id }}>

<script>
  (function() {
    class RecipeIngredients{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('recipe-ingredients-{{ ai_gen_id }}', RecipeIngredients{{ ai_gen_id }});
  })();
</script>

