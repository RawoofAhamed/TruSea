<div id="mobile-cart-bar" class="mobile-cart-bar hidden" style="display: none;">
  <div class="mobile-cart-bar__content">
    <div class="mobile-cart-bar__info">
      <span class="mobile-cart-bar__count" id="mobile-cart-bar-count">
        {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}
      </span>
      <span class="mobile-cart-bar__total" id="mobile-cart-bar-total">
        {{ cart.total_price | money }}
      </span>
    </div>
    <a href="{{ routes.cart_url }}" class="mobile-cart-bar__button">
      Go to Cart
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</div>

<style>
  /* Override default reward icon position to move it a little down to match pageup */
  #reward-rally-floating-icon {
    bottom: 20px !important;
  }
  @media screen and (max-width: 767px) {
    #reward-rally-floating-icon {
      bottom: 20px !important;
    }
  }

  .mobile-cart-bar {
    position: fixed;
    bottom: 20px;
    left: 16px;
    right: 16px;
    z-index: 1000;
    background: #ffffff;
    border-radius: 12px;
    padding: 12px 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    border: 1px solid #f0f0f0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    display: none;
  }

  @media screen and (min-width: 768px) {
    .mobile-cart-bar {
      display: none !important;
    }
  }

  /* Move sticky icons and reward launcher up when cart bar or drawer is active */
  @media screen and (max-width: 767px) {
    body.mobile-cart-bar-active .sticky-whatsapp,
    body.mobile-cart-bar-active .sticky-pageup,
    body.mobile-cart-bar-active #reward-rally-floating-icon,
    body.cart-drawer-open .sticky-whatsapp,
    body.cart-drawer-open .sticky-pageup,
    body.cart-drawer-open #reward-rally-floating-icon {
      bottom: 100px !important;
      transition: bottom 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    
    .sticky-whatsapp, .sticky-pageup, #reward-rally-floating-icon {
      transition: bottom 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease !important;
    }
  }

  .mobile-cart-bar.hidden {
    transform: translateY(120%);
    opacity: 0;
    pointer-events: none;
  }

  .mobile-cart-bar__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .mobile-cart-bar__info {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .mobile-cart-bar__count {
    color: #0d3d6e;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
  }

  .mobile-cart-bar__total {
    color: #5a7a8a;
    font-size: 13px;
    font-weight: 700;
  }

  .mobile-cart-bar__button {
    background: #0d3d6e;
    color: #fff;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .mobile-cart-bar__button:active {
    transform: scale(0.96);
    background: #1a4a7e;
  }

  /* Adjust for bottom safe area */
  @supports (padding-bottom: env(safe-area-inset-bottom)) {
    .mobile-cart-bar {
      bottom: calc(20px + env(safe-area-inset-bottom));
    }
    body.mobile-cart-bar-active .sticky-whatsapp,
    body.mobile-cart-bar-active .sticky-pageup,
    body.mobile-cart-bar-active #reward-rally-floating-icon {
      bottom: calc(100px + env(safe-area-inset-bottom)) !important;
    }
  }
</style>

<script>
  (function() {
    const cartBar = document.getElementById('mobile-cart-bar');
    if (!cartBar) return;

    let scrollTimeout;
    let isScrolling = false;

    function formatMoney(cents) {
      return '\u20B9' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function showBar() {
      const countContent = document.getElementById('mobile-cart-bar-count').textContent;
      const count = parseInt(countContent.match(/\d+/) || [0], 10);
      
      if (count > 0 && window.innerWidth < 768) {
        cartBar.style.display = 'block';
        cartBar.offsetHeight;
        cartBar.classList.remove('hidden');
        document.body.classList.add('mobile-cart-bar-active');
      }
    }

    function hideBar() {
      cartBar.classList.add('hidden');
      document.body.classList.remove('mobile-cart-bar-active');
    }

    // Initial check
    const initialCount = {{ cart.item_count }};
    if (initialCount > 0) {
      setTimeout(showBar, 1000);
    }

    window.addEventListener('scroll', function() {
      if (!isScrolling) {
        hideBar();
        isScrolling = true;
      }

      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function() {
        showBar();
        isScrolling = false;
      }, 800);
    }, { passive: true });

    document.addEventListener('cart:updated', function(event) {
      const cart = event.detail;
      const countElem = document.getElementById('mobile-cart-bar-count');
      const totalElem = document.getElementById('mobile-cart-bar-total');
      
      if (countElem) countElem.textContent = cart.item_count + (cart.item_count === 1 ? ' item' : ' items');
      if (totalElem) totalElem.textContent = formatMoney(cart.total_price);
      
      if (cart.item_count > 0) {
        showBar();
      } else {
        hideBar();
        setTimeout(() => { if (cartBar.classList.contains('hidden')) cartBar.style.display = 'none'; }, 400);
      }
    });
  })();
</script>
