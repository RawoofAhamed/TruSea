{% comment %}
  TruSea Premium Product Card Snippet
  Usage: {% render 'trusea-product-card', product: product, lazy_load: true %}
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign protein = product.metafields.custom.protein | default: "22g/100g"
  assign pieces = product.metafields.custom.pieces | default: "5-7"
  assign gross = product.metafields.custom.gross_weight | default: "540-600g"
  assign net = product.metafields.custom.net_weight | default: "480-520g"
  assign serves = product.metafields.custom.serves | default: "3-4"
  assign cut = product.metafields.custom.cut | default: "1 inch"
  
  assign pre_book = false
  if product.tags contains 'Pre-Book'
    assign pre_book = true
  endif

  comment
    Head and Tail add-on (standard for fish)
  endcomment
  assign head_tail_addon = all_products['vanjaram-big-slice-cut']
-%}

<ts-product-card class="ts-product-card ts-reveal" data-product-id="{{ product.id }}">
  <div class="ts-card-image-wrap">
    <div class="ts-carousel-container">
      <div class="ts-carousel-track">
        {% if product.media.size > 0 %}
          {% for media in product.media limit: 5 %}
            <div class="ts-slide {% if forloop.first %}active{% endif %}">
              <img 
                src="{{ media | image_url: width: 800 }}" 
                alt="{{ product.title }} - Image {{ forloop.index }}" 
                class="ts-carousel-img"
                loading="{% if lazy_load %}lazy{% else %}eager{% endif %}"
                width="400"
                height="250"
              >
            </div>
          {% endfor %}
        {% else %}
          <div class="ts-slide active">{{ 'product-1' | placeholder_svg_tag: 'ts-carousel-img placeholder-svg' }}</div>
        {% endif %}
      </div>
      <div class="ts-carousel-dots">
        {% for media in product.media limit: 5 %}
          <span class="ts-dot {% if forloop.first %}active{% endif %}"></span>
        {% endfor %}
      </div>
    </div>
    
    <div class="ts-card-badge ts-badge--info">Protein: {{ protein }}</div>
    
    {% if pre_book %}
      <div class="ts-card-badge ts-badge--stock">📋 Pre-Book</div>
    {% elsif product.available %}
      <div class="ts-card-badge ts-badge--stock">✓ In Stock</div>
    {% else %}
      <div class="ts-card-badge ts-badge--stock" style="background: rgba(239, 68, 68, 0.1); color: #EF4444; border-color: #EF4444;">Out of Stock</div>
    {% endif %}
  </div>

  <div class="ts-card-body">
    <div class="ts-card-header">
      <h3 class="ts-card-title">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
      {% if product.metafields.custom.subtitle %}
        <span class="ts-card-subtitle">{{ product.metafields.custom.subtitle }}</span>
      {% else %}
        <span class="ts-card-subtitle">{{ current_variant.title }}</span>
      {% endif %}
    </div>

    <div class="ts-card-stats">
      <div class="ts-stat-item"><span class="ts-stat-label">Slices:</span> {{ pieces }}</div>
      <div class="ts-stat-item"><span class="ts-stat-label">Gross:</span> {{ gross }}</div>
      <div class="ts-stat-item"><span class="ts-stat-label">Net:</span> {{ net }}</div>
      <div class="ts-stat-item"><span class="ts-stat-label">Serves:</span> {{ serves }}</div>
      <div class="ts-stat-item"><span class="ts-stat-label">Cut:</span> {{ cut }}</div>
    </div>

    <form method="post" action="/cart/add" class="ts-card-form" enctype="multipart/form-data">
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      
      {% unless product.has_only_default_variant %}
        <div class="ts-card-variants">
          <span class="ts-variant-label">SELECT WEIGHT</span>
          <div class="ts-variant-pills">
            {% for variant in product.variants %}
              <button 
                type="button" 
                class="ts-variant-pill {% if variant == current_variant %}active{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price | money_without_trailing_zeros }}"
              >
                {{ variant.title }}
              </button>
            {% endfor %}
          </div>
        </div>
      {% endunless %}

      {% if head_tail_addon != blank and product.tags contains 'Fish' %}
        <div class="ts-card-addons">
          <label class="ts-addon-item">
            <input type="checkbox" class="ts-addon-check" data-variant-id="{{ head_tail_addon.variants.first.id }}">
            <span class="ts-addon-text">Add Head and Tail (Curry Cut)</span>
            <span class="ts-addon-price">+ {{ head_tail_addon.price | money_without_trailing_zeros }}</span>
          </label>
        </div>
      {% endif %}

      <div class="ts-card-footer">
        <div class="ts-card-price-row">
          <span class="ts-card-price">
            <span class="ts-card-price-value">{{ current_variant.price | money_without_trailing_zeros }}</span>
            <span class="ts-card-price-info">(Incl. GST & FREE delivery)</span>
          </span>
        </div>
        
        <button 
          type="button" 
          class="ts-btn ts-btn-primary ts-card-add-btn"
          {% unless product.available %}disabled{% endunless %}
        >
          {% if product.available %}Add{% else %}Sold Out{% endif %}
        </button>
      </div>
    </form>
  </div>
</ts-product-card>
