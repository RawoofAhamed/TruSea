{% comment %}
  TruSea Product Card Snippet
  Usage: {% render 'trusea-product-card', product: product %}
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign protein = product.metafields.custom.protein | default: "22g/100g"
  assign pieces = product.metafields.custom.pieces | default: "5-7"
  assign gross = product.metafields.custom.gross_weight | default: "540-600g"
  assign net = product.metafields.custom.net_weight | default: "480-520g"
  assign serves = product.metafields.custom.serves | default: "3-4"
  assign cut = product.metafields.custom.cut | default: "1 inch"
  assign pre_book = false
  if product.tags contains 'Pre-Book'
    assign pre_book = true
  endif
-%}

<div class="ts-product-card ts-reveal" data-product-id="{{ product.id }}">
  <div class="ts-card-image-wrap">
    {% if product.featured_media %}
      <img 
        src="{{ product.featured_media | image_url: width: 800 }}" 
        alt="{{ product.title }}" 
        class="ts-card-img"
        loading="lazy"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'ts-card-img placeholder-svg' }}
    {% endif %}
    
    <div class="ts-card-badge ts-badge--info">Protein: {{ protein }}</div>
    
    {% if pre_book %}
      <div class="ts-card-badge ts-badge--stock">📋 Pre-Book</div>
    {% elsif product.available %}
      <div class="ts-card-badge ts-badge--stock">✓ In Stock</div>
    {% else %}
      <div class="ts-card-badge ts-badge--stock" style="background: rgba(239, 68, 68, 0.1); color: #EF4444; border-color: #EF4444;">Out of Stock</div>
    {% endif %}
  </div>

  <div class="ts-card-body">
    <div class="ts-card-header">
      <h3 class="ts-card-title">{{ product.title }}</h3>
      {% if product.metafields.custom.subtitle %}
        <span class="ts-card-subtitle">{{ product.metafields.custom.subtitle }}</span>
      {% else %}
        <span class="ts-card-subtitle">{{ current_variant.title }}</span>
      {% endif %}
    </div>

    <div class="ts-card-stats">
      <div class="ts-stat-item"><span class="ts-stat-label">Pieces / Slices:</span> {{ pieces }}</div>
      <div class="ts-stat-item"><span class="ts-stat-label">Gross:</span> {{ gross }}</div>
      <div class="ts-stat-item"><span class="ts-stat-label">Net:</span> {{ net }}</div>
      <div class="ts-stat-item"><span class="ts-stat-label">Serves:</span> {{ serves }}</div>
      <div class="ts-stat-item"><span class="ts-stat-label">Cut:</span> {{ cut }}</div>
    </div>

    {% unless product.has_only_default_variant %}
      <div class="ts-card-variants">
        <span class="ts-variant-label">SELECT WEIGHT</span>
        <div class="ts-variant-pills">
          {% for variant in product.variants %}
            <button 
              type="button" 
              class="ts-variant-pill {% if variant == current_variant %}active{% endif %}"
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price }}"
            >
              {{ variant.title }}
            </button>
          {% endfor %}
        </div>
      </div>
    {% endunless %}

    <div class="ts-card-footer">
      <div class="ts-card-price-wrap">
        <div class="ts-card-price" id="price-{{ product.id }}">
          {{ current_variant.price | money_without_trailing_zeros }}
        </div>
        <div class="ts-card-price-info">(Incl. GST & FREE delivery)</div>
      </div>
      
      <button 
        type="button" 
        class="ts-btn ts-btn-primary ts-card-add-btn"
        {% unless product.available %}disabled{% endunless %}
      >
        {% if product.available %}Add{% else %}Sold Out{% endif %}
      </button>
    </div>
  </div>
</div>

<script>
  // Quick Inline variant price switcher for the card
  (function() {
    const card = document.querySelector('.ts-product-card[data-product-id="{{ product.id }}"]');
    if (!card) return;
    
    const pills = card.querySelectorAll('.ts-variant-pill');
    const priceEl = card.querySelector('#price-{{ product.id }}');
    
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        
        // Update price display
        const price = parseInt(pill.dataset.price);
        priceEl.textContent = new Intl.NumberFormat('en-IN', {
          style: 'currency',
          currency: 'INR',
          maximumFractionDigits: 0
        }).format(price / 100);
      });
    });
  })();
</script>
