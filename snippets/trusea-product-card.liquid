  color: #fff;
  border: 1.5px solid rgba(255,255,255,0.2);
}
</style>

<script>
// Move card styles to head to prevent them from being cleared during client-side filtering
document.querySelectorAll('style[data-trusea-card-styles]').forEach(style => {
  if (style.parentNode !== document.head) {
    document.head.appendChild(style);
  }
});
// Hover Slide Carousel
document.addEventListener('DOMContentLoaded', () => {
  const carousels = document.querySelectorAll('.lc-card__carousel');
  carousels.forEach(carousel => {
    let intervalBase = parseInt(carousel.getAttribute('data-interval'));
    let intervalTime = intervalBase > 0 ? intervalBase : 1500; // Slide speed
    
    let container = carousel.querySelector('.lc-card__slides-container');
    let originalSlides = carousel.querySelectorAll('.lc-card__slide');
    let dots = carousel.querySelectorAll('.lc-dot');
    if(originalSlides.length <= 1) return;

    let wrapper = carousel.closest('.lc-card__media-wrap');

    // Infinite Loop Setup - Clean clones of any existing active classes
    const firstClone = originalSlides[0].cloneNode(true);
    const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);
    firstClone.classList.remove('active');
    lastClone.classList.remove('active');
    
    container.appendChild(firstClone);
    container.insertBefore(lastClone, originalSlides[0]);

    let slides = container.querySelectorAll('.lc-card__slide');
    let currentIndex = 1; // Start at the first original slide
    let isTransitioning = false;

    // Initial position - use requestAnimationFrame to ensure DOM is ready
    const initPosition = () => {
      container.style.transition = 'none';
      container.style.transform = `translateX(-${currentIndex * 100}%)`;
      void container.offsetWidth; // Force reflow
      updateSlide(true);
    };

    requestAnimationFrame(initPosition);
    setTimeout(initPosition, 50); // Failsafe for some browsers
    
    let updateSlide = (instant = false) => {
      if (instant) {
        container.style.transition = 'none';
        void container.offsetWidth; // Force reflow
      } else {
        container.style.transition = 'transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        isTransitioning = true;
      }
      
      container.style.transform = `translateX(-${currentIndex * 100}%)`;
      
      // Update dots based on original index
      let dotIndex = currentIndex - 1;
      if (currentIndex === 0) dotIndex = originalSlides.length - 1;
      if (currentIndex === slides.length - 1) dotIndex = 0;
      
      dots.forEach(d => d.classList.remove('active'));
      if(dots[dotIndex]) {
        dots[dotIndex].classList.add('active');
      }
    };

    container.addEventListener('transitionend', (e) => {
      if (e.target !== container) return;
      isTransitioning = false;
      
      // Infinite Jump logic
      if (currentIndex === 0) {
        currentIndex = slides.length - 2;
        updateSlide(true);
      } else if (currentIndex === slides.length - 1) {
        currentIndex = 1;
        updateSlide(true);
      }
    });

    let slideTimer = null;
    let startCarousel = () => {
      if (slideTimer) clearInterval(slideTimer);
      slideTimer = setInterval(() => {
        if (isTransitioning) return;
        currentIndex++;
        updateSlide();
      }, intervalTime);
    };

    let stopCarousel = () => {
      if (slideTimer) {
        clearInterval(slideTimer);
        slideTimer = null;
      }
    };

    let touchStartX = 0;
    let touchEndX = 0;
    let isMouseDown = false;

    if (wrapper) {
      wrapper.addEventListener('mouseenter', startCarousel);
      wrapper.addEventListener('mouseleave', stopCarousel);
      wrapper.addEventListener('dragstart', (e) => e.preventDefault());

      wrapper.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
        if (slideTimer) clearInterval(slideTimer);
      }, { passive: true });

      wrapper.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].clientX;
        handleSwipe();
      }, { passive: true });

      wrapper.addEventListener('mousedown', (e) => {
        isMouseDown = true;
        touchStartX = e.clientX;
        if (slideTimer) clearInterval(slideTimer);
      });

      window.addEventListener('mouseup', (e) => {
        if (!isMouseDown) return;
        isMouseDown = false;
        touchEndX = e.clientX;
        if (Math.abs(touchEndX - touchStartX) > 5) {
           handleSwipe();
        }
      });
    }

    function handleSwipe() {
      const swipeThreshold = 30;
      let moved = false;
      if (touchEndX < touchStartX - swipeThreshold) {
        // Only move forward if not already at the cloned end
        if (currentIndex < slides.length - 1) {
          currentIndex++;
          moved = true;
        }
      } else if (touchEndX > touchStartX + swipeThreshold) {
        // Only move backward if not already at the cloned start
        if (currentIndex > 0) {
          currentIndex--;
          moved = true;
        }
      }
      if (moved) updateSlide();
    }
  });
});

// Define functional Cart JS only once per page
if (typeof addTruSeaToCart !== 'function') {
  // Modal Singleton HTML injection
  if (!document.getElementById('lc-cut-modal')) {
    const modalDiv = document.createElement('div');
    modalDiv.innerHTML = `
      <div id="lc-cut-modal" class="lc-modal">
        <div class="lc-modal__backdrop"></div>
        <div class="lc-modal__content">
          <button class="lc-modal__close">&times;</button>
          <div class="lc-modal__header">
            <div class="lc-modal__header-left">
              <h3 class="lc-modal__title"></h3>
              <div class="lc-modal__subtitle"></div>
            </div>
            <div class="lc-modal__price"></div>
          </div>
          <div class="lc-modal__body">
            <div class="lc-modal__label">SELECT CUT PREFERENCE</div>
            <div class="lc-modal__cuts">
              <!-- Dynamically populated -->
            </div>
            
            <div class="lc-modal__qty-row">
              <div class="lc-modal__label" style="margin:0">QUANTITY</div>
              <div class="lc-modal__qty">
                <button class="lc-modal__qty-btn js-minus">&minus;</button>
                <input type="number" value="1" min="1" class="lc-modal__qty-input">
                <button class="lc-modal__qty-btn js-plus">+</button>
              </div>
            </div>
          </div>
          <div class="lc-modal__footer">
            <button class="lc-modal__add-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <span>Add to Cart <span class="js-modal-btn-price"></span></span>
            </button>
          </div>
        </div>
      </div>
    `;
    document.body.appendChild(modalDiv.firstElementChild);
    
    const m = document.getElementById('lc-cut-modal');
    const closeBtn = m.querySelector('.lc-modal__close');
    const backdrop = m.querySelector('.lc-modal__backdrop');
    
    const closeModal = () => m.classList.remove('is-active');
    closeBtn.onclick = closeModal;
    backdrop.onclick = closeModal;
    
    const qtyInput = m.querySelector('.lc-modal__qty-input');
    m.updatePrice = () => {
      const q = parseInt(qtyInput.value);
      const total = m._unitPrice * q;
      const formatted = (total / 100).toLocaleString('en-IN', { maximumFractionDigits: 0 });
      m.querySelector('.lc-modal__price').innerText = 'Rs. ' + formatted;
      m.querySelector('.js-modal-btn-price').innerText = 'Rs. ' + formatted;
    };

    m.querySelector('.js-minus').onclick = () => { if(qtyInput.value > 1) { qtyInput.value--; m.updatePrice(); } };
    m.querySelector('.js-plus').onclick = () => { qtyInput.value++; m.updatePrice(); };
    qtyInput.oninput = () => { if(qtyInput.value < 1) qtyInput.value = 1; m.updatePrice(); };
  }

  window.openTruSeaCutModal = function(btn, variantId, title, pricePaise, isPreorder, subtitle, group) {
    const modal = document.getElementById('lc-cut-modal');
    
    // Populate Cuts based on group
    const cutsContainer = modal.querySelector('.lc-modal__cuts');
    let cutsHTML = '';
    if (group === 'A') {
      cutsHTML = `
        <label class="lc-modal__cut-item"><input type="radio" name="lc-cut" value="Steaks" checked><div class="lc-modal__cut-box"><div class="lc-modal__cut-name">Steaks</div><div class="lc-modal__cut-desc">Premium thick uniform slices</div><div class="lc-modal__check"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"></polyline></svg></div></div></label>
        <label class="lc-modal__cut-item"><input type="radio" name="lc-cut" value="Curry Cuts"><div class="lc-modal__cut-box"><div class="lc-modal__cut-name">Curry Cuts</div><div class="lc-modal__cut-desc">Standard medium pieces</div><div class="lc-modal__check"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"></polyline></svg></div></div></label>
        <label class="lc-modal__cut-item"><input type="radio" name="lc-cut" value="Fillets"><div class="lc-modal__cut-box"><div class="lc-modal__cut-name">Fillets</div><div class="lc-modal__cut-desc">Boneless skinless portions</div><div class="lc-modal__check"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"></polyline></svg></div></div></label>
      `;
    } else if (group === 'B') {
      cutsHTML = `<label class="lc-modal__cut-item"><input type="radio" name="lc-cut" value="Cleaned & Whole" checked><div class="lc-modal__cut-box"><div class="lc-modal__cut-name">Cleaned & Whole</div><div class="lc-modal__cut-desc">Fully cleaned and ready to cook</div><div class="lc-modal__check"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"></polyline></svg></div></div></label>`;
    } else if (group === 'C') {
      cutsHTML = `
        <label class="lc-modal__cut-item"><input type="radio" name="lc-cut" value="Whole Fish" checked><div class="lc-modal__cut-box"><div class="lc-modal__cut-name">Whole Fish</div><div class="lc-modal__cut-desc">Uncut whole fish</div><div class="lc-modal__check"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"></polyline></svg></div></div></label>
        <label class="lc-modal__cut-item"><input type="radio" name="lc-cut" value="Thick Slices"><div class="lc-modal__cut-box"><div class="lc-modal__cut-name">Thick Slices</div><div class="lc-modal__cut-desc">Large uniform steaks</div><div class="lc-modal__check"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"></polyline></svg></div></div></label>
      `;
    }
    cutsContainer.innerHTML = cutsHTML;

    // Show/hide the cut preference section based on whether the product has a cut group
    const cutSection = modal.querySelector('.lc-modal__label');
    const hasCutGroup = group === 'A' || group === 'B' || group === 'C';
    if (cutSection) cutSection.style.display = hasCutGroup ? '' : 'none';
    cutsContainer.style.display = hasCutGroup ? '' : 'none';

    modal._unitPrice = pricePaise;
    modal.querySelector('.lc-modal__title').innerText = title;
    modal.querySelector('.lc-modal__subtitle').innerText = subtitle || 'Premium Seafood';
    
    const qtyInput = modal.querySelector('.lc-modal__qty-input');
    qtyInput.value = 1;

    // Set initial price
    modal.querySelector('.lc-modal__price').innerText = 'Rs. ' + (pricePaise / 100).toLocaleString('en-IN', { maximumFractionDigits: 0 });
    
    modal.classList.add('is-active');
    
    // Override Add Button
    const addBtn = modal.querySelector('.lc-modal__add-btn');
    const addBtnSpan = addBtn.querySelector('span');
    const isPrebook = String(isPreorder) === 'true';
    
    if (addBtnSpan) {
      if (isPrebook) {
        addBtn.classList.add('is-prebook');
        addBtnSpan.innerHTML = 'Prebook Now <span class="js-modal-btn-price"></span>';
      } else {
        addBtn.classList.remove('is-prebook');
        addBtnSpan.innerHTML = 'Add to Cart <span class="js-modal-btn-price"></span>';
      }
    }

    addBtn.onclick = async () => {
      const checkedCut = modal.querySelector('input[name="lc-cut"]:checked');
      const cut = checkedCut ? checkedCut.value : null;
      const qty = parseInt(modal.querySelector('.lc-modal__qty-input').value);
      addBtn.disabled = true;
      const originalHTML = addBtn.innerHTML;
      addBtn.innerText = isPrebook ? 'Prebooking...' : 'Adding...';
      
      await addTruSeaToCart(btn, variantId, isPreorder, qty, cut);
      
      addBtn.disabled = false;
      addBtn.innerHTML = originalHTML;
      modal.classList.remove('is-active');
    };
    
    // Update initial price display in button
    modal.updatePrice();
  };

  window.addTruSeaToCart = async function(btn, variantId, isPreorder = false, quantity = 1, cutSelected = null) {
    if(!variantId) return;
    const parent = btn.parentElement;
    // btn.innerHTML = 'Add...';
    btn.disabled = true;

    try {
      const props = {};
      if (isPreorder) props['Preorder'] = 'Yes';
      if (cutSelected) props['Cut Preference'] = cutSelected;
      
      const payload = { 
        items: [{
          id: variantId, 
          quantity: quantity,
          properties: props
        }],
        sections: "cart-drawer,cart-icon-bubble"
      };

      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/javascript' },
        body: JSON.stringify(payload)
      });
      const parsedAdd = await res.json();

      if (res.ok) {
        // btn.style.display = 'none'; // Don't hide the add button
        const addedItem = (parsedAdd.items && parsedAdd.items[0]) ? parsedAdd.items[0] : parsedAdd;
        const itemTitle = addedItem.title || addedItem.product_title || 'Product';
        showToast(itemTitle + ' added!');
        
        // const qtyControl = parent.querySelector('.lc-qty-control');
        // qtyControl.style.display = 'flex';
        // qtyControl.querySelector('.lc-qty-input').value = quantity;
        
        // btn.innerHTML = 'Add <span>+</span>';

        if (parsedAdd.sections) {
          // Update Bubble
          const bubble = document.getElementById('cart-icon-bubble');
          if (bubble && parsedAdd.sections['cart-icon-bubble']) {
            const newBubble = new DOMParser().parseFromString(parsedAdd.sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
            if (newBubble) bubble.innerHTML = newBubble.innerHTML;
          }

          // Update Drawer
          const drawerInner = document.querySelector('cart-drawer .drawer__inner');
          if (drawerInner && parsedAdd.sections['cart-drawer']) {
            const newDrawer = new DOMParser().parseFromString(parsedAdd.sections['cart-drawer'], 'text/html').querySelector('.drawer__inner');
            if (newDrawer) drawerInner.innerHTML = newDrawer.innerHTML;
          }
        }
      }
    } catch(e) { console.error(e); }
    btn.disabled = false;
  };

  window.updateTruSeaQty = async function(btn, variantId, delta) {
    const parent = btn.parentElement;
    const input = parent.querySelector('.lc-qty-input');
    let newQty = parseInt(input.value) + delta;
    if (newQty < 0) newQty = 0;

    btn.disabled = true;
    try {
      const res = await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/javascript' },
        body: JSON.stringify({ 
          updates: { [variantId]: newQty },
          sections: "cart-drawer,cart-icon-bubble"
        })
      });
      const parsedUpdate = await res.json();
      
      if (parsedUpdate.status && parsedUpdate.message) {
        throw new Error(parsedUpdate.message);
      }

      if (res.ok) {
        input.value = newQty;
        if (newQty === 0) {
          parent.style.display = 'none';
          const addBtn = parent.parentElement.querySelector('.lc-btn-add');
          addBtn.style.display = 'flex';
        }
        
        if (parsedUpdate.sections) {
          // Update Bubble
          const bubble = document.getElementById('cart-icon-bubble');
          if (bubble && parsedUpdate.sections['cart-icon-bubble']) {
            const newBubble = new DOMParser().parseFromString(parsedUpdate.sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
            if (newBubble) bubble.innerHTML = newBubble.innerHTML;
          }

          // Update Drawer
          const drawerInner = document.querySelector('cart-drawer .drawer__inner');
          if (drawerInner && parsedUpdate.sections['cart-drawer']) {
            const newDrawer = new DOMParser().parseFromString(parsedUpdate.sections['cart-drawer'], 'text/html').querySelector('.drawer__inner');
            if (newDrawer) drawerInner.innerHTML = newDrawer.innerHTML;
          }
        }
      }
    } catch(e) { console.error(e); }
    btn.disabled = false;
  };
}
</script>

