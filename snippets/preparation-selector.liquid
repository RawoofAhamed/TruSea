{% comment %}
  ============================================================
  FILE: snippets/preparation-selector.liquid
  
  USAGE: Include this in your product template like:
    {% render 'preparation-selector', product: product %}
  
  HOW IT WORKS:
  - Reads product tags to know which category the product is
  - Shows the relevant pill tabs for that product only
  - Writes selection into the cart "note" field as a cutter instruction
  - Uses Shopify's native cart note (no app needed)
  ============================================================
{% endcomment %}

{% assign product_tags = product.tags | join: ',' | downcase %}

{% assign is_lobster = false %}
{% assign is_fish    = false %}
{% assign is_clam    = false %}
{% assign is_prawn   = false %}
{% assign is_crab    = false %}
{% assign is_squid   = false %}

{% if product_tags contains 'lobster' %}{% assign is_lobster = true %}{% endif %}
{% if product_tags contains 'fish'    %}{% assign is_fish    = true %}{% endif %}
{% if product_tags contains 'clam'    %}{% assign is_clam    = true %}{% endif %}
{% if product_tags contains 'prawn'   %}{% assign is_prawn   = true %}{% endif %}
{% if product_tags contains 'crab'    %}{% assign is_crab    = true %}{% endif %}
{% if product_tags contains 'squid'   %}{% assign is_squid   = true %}{% endif %}

{% if is_lobster or is_fish or is_clam or is_prawn or is_crab or is_squid %}

<div class="ts-cut-selector" id="prep-selector-{{ product.id }}">
  <h4 class="ts-cut-heading">CUT PREFERENCES</h4>

  {% if is_lobster %}
  <div class="ts-cut-group">
    <div class="ts-cut-cards" data-group="Lobster Prep">
      <button type="button" class="ts-cut-card" data-value="Live Whole">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Live Whole</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9.5" fill="#fff" stroke="currentColor"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="ts-cut-card__desc">Delivered live and whole.</span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Cleaned &amp; Cut">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Cleaned &amp; Cut</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9.5" fill="#fff" stroke="currentColor"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="ts-cut-card__desc">Pre-cleaned and sectioned.</span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Butterfly">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Butterfly</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9.5" fill="#fff" stroke="currentColor"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="ts-cut-card__desc">Split down the back for grilling.</span>
      </button>
    </div>
  </div>
  {% endif %}

  {% if is_fish %}
  <div class="ts-cut-group">
    <div class="ts-cut-cards" data-group="Fish Cut">
      <button type="button" class="ts-cut-card is-active" data-value="Steak Cut">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Steak Cut</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#177ff2"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="ts-cut-card__desc">Thick transverse slices with bone-in</span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Fry Cut">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Fry Cut</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="ts-cut-card__desc">Skin-on fillets, perfect for pan searing</span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Curry Cut">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Curry Cut</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="ts-cut-card__desc">Medium bite-sized cubes for slow cooking</span>
      </button>
    </div>
  </div>
  {% endif %}

  {% if is_clam %}
  <div class="ts-cut-group">
    <div class="ts-cut-cards" data-group="Clam Prep">
      <button type="button" class="ts-cut-card is-active" data-value="Washed">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Washed</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#177ff2"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Cleaned (Sand Removed)">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Cleaned (Sand Removed)</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
    </div>
  </div>
  {% endif %}

  {% if is_squid %}
  <div class="ts-cut-group">
    <div class="ts-cut-cards" data-group="Squid Prep">
      <button type="button" class="ts-cut-card is-active" data-value="Whole">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Whole</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#177ff2"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Cleaned">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Cleaned</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Rings">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Rings</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
    </div>
  </div>
  {% endif %}

  {% if is_crab %}
  <div class="ts-cut-group">
    <div class="ts-cut-cards" data-group="Crab Prep">
      <button type="button" class="ts-cut-card is-active" data-value="Whole">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Whole</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#177ff2"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Cleaned &amp; Cut">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Cleaned &amp; Cut</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
    </div>
  </div>
  {% endif %}

  {% if is_prawn %}
  <div class="ts-cut-group">
    <div class="ts-cut-cards" data-group="Prawn Prep">
      <button type="button" class="ts-cut-card is-active" data-value="Shell-on Deveined">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Shell-on Deveined</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#177ff2"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Peeled &amp; Deveined">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Peeled &amp; Deveined</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <button type="button" class="ts-cut-card" data-value="Butterfly Cut">
        <span class="ts-cut-card__top">
          <span class="ts-cut-card__title">Butterfly Cut</span>
          <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
    </div>
  </div>
  {% endif %}

  <div class="ts-cut-group">
    <h4 class="ts-cut-heading">ADD-ONS</h4>
    <div class="ts-addons-grid">
      <label class="ts-addon-checkbox">
        <input type="checkbox" name="properties[Add-on Extra Slice]" value="Yes">
        <span class="ts-addon-checkbox__box"><svg viewBox="0 0 14 14" fill="none"><path d="M3 7l2.5 2.5L11 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="ts-addon-checkbox__label">Extra Slice</span>
      </label>
      <label class="ts-addon-checkbox">
        <input type="checkbox" name="properties[Add-on Head Included]" value="Yes">
        <span class="ts-addon-checkbox__box"><svg viewBox="0 0 14 14" fill="none"><path d="M3 7l2.5 2.5L11 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="ts-addon-checkbox__label">Head included</span>
      </label>
      <label class="ts-addon-checkbox">
        <input type="checkbox" name="properties[Add-on Tail Included]" value="Yes">
        <span class="ts-addon-checkbox__box"><svg viewBox="0 0 14 14" fill="none"><path d="M3 7l2.5 2.5L11 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="ts-addon-checkbox__label">Tail included</span>
      </label>
    </div>
  </div>

  <!-- Hidden field that stores the combined note string -->
  <input
    type="hidden"
    name="note"
    id="prep-note-{{ product.id }}"
    value="Steak Cut"
  >
</div>

<style>
  .ts-addons-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ts-addon-checkbox {
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .ts-addon-checkbox input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .ts-addon-checkbox__box {
    width: 20px;
    height: 20px;
    border: 2px solid #cbd5e1;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    transition: all 0.2s;
    background: #fff;
    color: #fff;
  }
  .ts-addon-checkbox input:checked + .ts-addon-checkbox__box {
    background: #177ff2;
    border-color: #177ff2;
    color: #fff;
  }
  .ts-addon-checkbox__label {
    font-size: 13px;
    color: #4b5563;
    font-weight: 500;
  }
  .ts-cut-selector {
    margin: 24px 0;
  }
  .ts-cut-heading {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #4b5563;
    margin-bottom: 12px;
    font-family: inherit;
  }
  .ts-cut-group {
    margin-bottom: 16px;
  }
  .ts-cut-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ts-cut-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    width: 100%;
    padding: 16px 20px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ts-cut-card.is-active {
    background: #eff6ff; /* light blue */
    border-color: #177ff2;
  }
  .ts-cut-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .ts-cut-card__title {
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
  }
  .ts-cut-card__desc {
    display: block;
    font-size: 13px;
    color: #64748b;
    margin-top: 4px;
    font-weight: 400;
  }
  .ts-cut-icon {
    width: 20px;
    height: 20px;
  }
  .ts-cut-card.is-active .ts-cut-icon circle {
    fill: #177ff2;
  }
  .ts-cut-card:not(.is-active) .ts-cut-icon circle {
    fill: #e5e7eb;
  }
</style>

<script>
(function() {
  var selectorEl  = document.getElementById('prep-selector-{{ product.id }}');
  var noteInput   = document.getElementById('prep-note-{{ product.id }}');
  var selections  = {};

  selectorEl.querySelectorAll('.ts-cut-cards').forEach(function(group) {
    var cards = group.querySelectorAll('.ts-cut-card');
    
    // Auto-select first if none is set
    var activeCard = group.querySelector('.is-active') || cards[0];
    if(activeCard) {
      activeCard.classList.add('is-active');
      selections[group.dataset.group] = activeCard.dataset.value;
      updateNote();
    }

    cards.forEach(function(card) {
      card.addEventListener('click', function() {
        cards.forEach(function(p) {
          p.classList.remove('is-active');
        });
        card.classList.add('is-active');
        selections[group.dataset.group] = card.dataset.value;
        updateNote();
      });
    });
  });

  function updateNote() {
    var parts = [];
    Object.keys(selections).forEach(function(k) {
      parts.push(k + ': ' + selections[k]);
    });
    if(noteInput) noteInput.value = parts.join(' | ');
  }
})();
</script>

{% endif %}
