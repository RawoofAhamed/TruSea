{% comment %}
  ============================================================
  FILE: snippets/preparation-selector.liquid
  
  USAGE: Include this in your product template like:
    {% render 'preparation-selector', product: product %}
  
  HOW IT WORKS:
  - Reads product tags to know which category the product is
  - Shows the relevant pill tabs for that product only
  - Writes selection into the cart "note" field as a cutter instruction
  - Uses Shopify's native cart note (no app needed)
  ============================================================
{% endcomment %}

{% assign product_tags = product.tags | join: ',' | downcase %}
{% assign current_group = "" %}

{% if product_tags contains 'cut_slices' %}
  {% assign current_group = "A" %}
{% elsif product_tags contains 'cut_cleaned' %}
  {% assign current_group = "B" %}
{% elsif product_tags contains 'cut_whole' %}
  {% assign current_group = "C" %}
{% endif %}

{% if current_group != "" %}
<div class="ts-cut-selector" id="prep-selector-{{ product.id }}">
  <h4 class="ts-cut-heading">SELECT CUT PREFERENCE</h4>

  <div class="ts-cut-group">
    <div class="ts-cut-cards" data-group="Preparation">
      
      {% if current_group == "A" %}
        <button type="button" class="ts-cut-card" data-value="Premium Slices">
          <span class="ts-cut-card__top">
            <span class="ts-cut-card__title">Premium Slices</span>
            <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="ts-cut-card__desc">Thick uniform center cuts</span>
        </button>
        <button type="button" class="ts-cut-card" data-value="Regular Slices">
          <span class="ts-cut-card__top">
            <span class="ts-cut-card__title">Regular Slices</span>
            <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="ts-cut-card__desc">Standard cuts with head & tail portions</span>
        </button>
      
      {% elsif current_group == "B" %}
        <button type="button" class="ts-cut-card" data-value="Cleaned & Whole">
          <span class="ts-cut-card__top">
            <span class="ts-cut-card__title">Cleaned & Whole</span>
            <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="ts-cut-card__desc">Fully cleaned and ready to cook</span>
        </button>

      {% elsif current_group == "C" %}
        <button type="button" class="ts-cut-card" data-value="Whole Fish">
          <span class="ts-cut-card__top">
            <span class="ts-cut-card__title">Whole Fish</span>
            <svg class="ts-cut-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#e5e7eb"/><path d="M6 10l3 3 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="ts-cut-card__desc">Uncut whole fish</span>
        </button>
      {% endif %}

    </div>
  </div>

  <!-- Hidden field that stores the selection -->
  <input
    type="hidden"
    name="properties[Cut preference]"
    id="prep-note-{{ product.id }}"
    value=""
  >
</div>
{% endif %}

<style>
  .ts-addons-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ts-addon-checkbox {
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .ts-addon-checkbox input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .ts-addon-checkbox__box {
    width: 20px;
    height: 20px;
    border: 2px solid #cbd5e1;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    transition: all 0.2s;
    background: #fff;
    color: #fff;
  }
  .ts-addon-checkbox input:checked + .ts-addon-checkbox__box {
    background: #177ff2;
    border-color: #177ff2;
    color: #fff;
  }
  .ts-addon-checkbox__label {
    font-size: 13px;
    color: #4b5563;
    font-weight: 500;
  }
  .ts-cut-selector {
    margin: 24px 0;
  }
  .ts-cut-heading {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #4b5563;
    margin-bottom: 12px;
    font-family: inherit;
  }
  .ts-cut-group {
    margin-bottom: 16px;
  }
  .ts-cut-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ts-cut-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    width: 100%;
    padding: 16px 20px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ts-cut-card.is-active {
    background: #eff6ff; /* light blue */
    border-color: #177ff2;
  }
  .ts-cut-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .ts-cut-card__title {
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
  }
  .ts-cut-card__desc {
    display: block;
    font-size: 13px;
    color: #64748b;
    margin-top: 4px;
    font-weight: 400;
  }
  .ts-cut-icon {
    width: 20px;
    height: 20px;
  }
  .ts-cut-card.is-active .ts-cut-icon circle {
    fill: #177ff2;
  }
  .ts-cut-card:not(.is-active) .ts-cut-icon circle {
    fill: #e5e7eb;
  }
</style>

<script>
(function() {
  var selectorEl  = document.getElementById('prep-selector-{{ product.id }}');
  var noteInput   = document.getElementById('prep-note-{{ product.id }}');
  var selections  = {};

  selectorEl.querySelectorAll('.ts-cut-cards').forEach(function(group) {
    var cards = group.querySelectorAll('.ts-cut-card');
    
    // Auto-select first if none is set
    var activeCard = group.querySelector('.is-active') || cards[0];
    if(activeCard) {
      activeCard.classList.add('is-active');
      selections[group.dataset.group] = activeCard.dataset.value;
      updateNote();
    }

    cards.forEach(function(card) {
      card.addEventListener('click', function() {
        cards.forEach(function(p) {
          p.classList.remove('is-active');
        });
        card.classList.add('is-active');
        selections[group.dataset.group] = card.dataset.value;
        updateNote();
      });
    });
  });

  function updateNote() {
    var parts = [];
    Object.keys(selections).forEach(function(k) {
      parts.push(k + ': ' + selections[k]);
    });
    if(noteInput) noteInput.value = parts.join(' | ');
  }
})();
</script>
