    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hero Background Image"
    },
    {
      "type": "checkbox",
      "id": "show_decorations",
      "label": "Show floating decorations",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Overlay Fallback Color",
      "default": "#0E2541"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#3CBFA0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "MEMBER EXCLUSIVE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "SelFish Club"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Once you taste our fish, your tongue wants more."
    },
    {
      "type": "header",
      "content": "🔘 Buttons"
    },
    {
      "type": "text",
      "id": "plan_text",
      "label": "Plans Button Text",
      "default": "Membership Plans"
    },
    {
      "type": "text",
      "id": "plan_anchor",
      "label": "Plans Anchor ID",
      "default": "selfish-pricing"
    },
    {
      "type": "text",
      "id": "faq_text",
      "label": "FAQ Button Text",
      "default": "FAQs"
    },
    {
      "type": "text",
      "id": "faq_anchor",
      "label": "FAQ Anchor ID",
      "default": "selfish-faq"
    },
    {
      "type": "text",
      "id": "whatsapp_text",
      "label": "WhatsApp Button Text",
      "default": "Join on WhatsApp"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "WhatsApp Link"
    }
  ],
  "presets": [
    {
      "name": "SelFish Hero (Premium)"
    }
  ]
}
{% endschema %}
