{%- liquid
  assign combo_products = product.metafields.custom.combo_products.value
  assign is_editor = request.design_mode
-%}

{%- if combo_products != blank or is_editor -%}
<section class="ts-combo" id="ts-combo-{{ section.id }}">
  <div class="page-width">
    <div class="ts-combo__header">
      <h2 class="ts-combo__title">{{ section.settings.heading | default: 'Frequently Bought Together' }}</h2>
      <p class="ts-combo__subtitle">Curated pairings to complete your TruSea experience.</p>
    </div>

    <div class="ts-combo__container">
      <div class="ts-combo__items">
        <!-- Main Product -->
        <div class="ts-combo-item" data-price="{{ product.price }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
          <div class="ts-combo-item__inner">
            <div class="ts-combo-item__image">
              <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title }}" loading="lazy">
              {% if product.available == false %}
                <div class="ts-combo-item__badge ts-combo-item__badge--soldout">Sold Out</div>
              {% endif %}
              <div class="ts-combo-item__check">
                <input type="checkbox" checked disabled id="combo-main-{{ section.id }}">
                <label for="combo-main-{{ section.id }}"></label>
              </div>
            </div>
            <div class="ts-combo-item__info">
              <span class="ts-combo-item__name">{{ product.title }}</span>
              <span class="ts-combo-item__price">{{ product.price | money_without_trailing_zeros }}</span>
            </div>
          </div>
        </div>

        {%- for combo in combo_products -%}
          <div class="ts-combo-separator"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
          
          <div class="ts-combo-item" data-price="{{ combo.price }}" data-variant-id="{{ combo.selected_or_first_available_variant.id }}">
            <div class="ts-combo-item__inner">
              <div class="ts-combo-item__image">
                <img src="{{ combo.featured_media | image_url: width: 300 }}" alt="{{ combo.title }}" loading="lazy">
                {% if combo.available == false %}
                  <div class="ts-combo-item__badge ts-combo-item__badge--soldout">Sold Out</div>
                {% endif %}
                <div class="ts-combo-item__check">
                  <input type="checkbox" {% if combo.available %}checked{% else %}disabled{% endif %} id="combo-{{ combo.id }}-{{ section.id }}" class="ts-combo-checkbox">
                  <label for="combo-{{ combo.id }}-{{ section.id }}"></label>
                </div>
              </div>
              <div class="ts-combo-item__info">
                <a href="{{ combo.url }}" class="ts-combo-item__name">{{ combo.title }}</a>
                <span class="ts-combo-item__price">{{ combo.price | money_without_trailing_zeros }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="ts-combo__summary">
        <div class="ts-combo__total-wrap">
          <span class="ts-combo__total-label">Total Price</span>
          <div class="ts-combo__total-price" data-base-currency="{{ cart.currency.symbol }}">{{ product.price | money_without_trailing_zeros }}</div>
        </div>
        <button type="button" class="ts-btn ts-btn-primary ts-combo__submit">
          Add <span class="ts-combo__count"></span> items to Cart
        </button>
      </div>
    </div>
  </div>
</section>

<style>
.ts-combo {
  padding: 80px 0;
  background: #f8fafc;
  border-top: 1px solid #eef2f7;
  border-bottom: 1px solid #eef2f7;
}
.ts-combo__header {
  margin-bottom: 40px;
  text-align: left;
}
.ts-combo__title {
  font-size: 24px;
  font-weight: 800;
  color: #0d3d6e;
  margin: 0 0 8px;
}
.ts-combo__subtitle {
  font-size: 14px;
  color: #64748b;
  margin: 0;
}

.ts-combo__container {
  display: flex;
  align-items: flex-start;
  gap: 40px;
}

.ts-combo__items {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20px;
  background: #fff;
  padding: 30px;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.03);
}

.ts-combo-item {
  width: 140px;
  text-align: center;
}
.ts-combo-item__image {
  position: relative;
  width: 120px;
  height: 120px;
  margin: 0 auto 15px;
  background: #f1f5f9;
  border-radius: 16px;
  overflow: hidden;
}
.ts-combo-item__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ts-combo-item__badge {
  position: absolute;
  top: 0;
  left: 0;
  background: #EF4444;
  color: #fff;
  font-size: 8px;
  font-weight: 900;
  text-transform: uppercase;
  padding: 3px 6px;
  z-index: 3;
  border-bottom-right-radius: 8px;
}

/* Custom Flipkart Style Checkbox */
.ts-combo-item__check {
  position: absolute;
  top: 8px;
  left: 8px;
  z-index: 2;
}
.ts-combo-item__check input {
  display: none;
}
.ts-combo-item__check label {
  display: block;
  width: 22px;
  height: 22px;
  background: #fff;
  border: 2px solid #cbd5e1;
  border-radius: 4px;
  cursor: pointer;
  position: relative;
  transition: all 0.2s;
}
.ts-combo-item__check input:checked + label {
  background: #3cbfa0; /* Mint Green */
  border-color: #3cbfa0;
}
.ts-combo-item__check input:checked + label::after {
  content: '';
  position: absolute;
  left: 6px;
  top: 2px;
  width: 6px;
  height: 10px;
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

.ts-combo-item__info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.ts-combo-item__name {
  font-size: 13px;
  font-weight: 700;
  color: #0d3d6e;
  text-decoration: none;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.3;
}
.ts-combo-item__price {
  font-size: 15px;
  font-weight: 800;
  color: #3cbfa0;
}

.ts-combo-separator {
  color: #cbd5e1;
  display: flex;
  align-items: center;
}

.ts-combo__summary {
  width: 300px;
  background: #fff;
  padding: 30px;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(13, 61, 110, 0.08);
  border: 1px solid #eef2f7;
}

.ts-combo__total-wrap {
  margin-bottom: 24px;
}
.ts-combo__total-label {
  font-size: 12px;
  font-weight: 800;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 4px;
}
.ts-combo__total-price {
  font-size: 32px;
  font-weight: 900;
  color: #0d3d6e;
}

.ts-combo__submit {
  width: 100%;
  height: 56px;
  border-radius: 12px;
  font-weight: 800;
  text-transform: none;
  letter-spacing: 0;
  font-size: 16px;
  box-shadow: 0 4px 15px rgba(60, 191, 160, 0.2);
  transition: all 0.3s ease;
}

.ts-combo__submit.loading {
  opacity: 0.7;
  cursor: wait;
}

@media (max-width: 1024px) {
  .ts-combo__container {
    flex-direction: column;
    gap: 20px;
  }
  .ts-combo__summary {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
  }
  .ts-combo__total-wrap { margin: 0; }
  .ts-combo__submit { width: auto; min-width: 200px; }
}

@media (max-width: 768px) {
  .ts-combo__items {
    padding: 20px;
    overflow-x: auto;
    justify-content: flex-start;
    -webkit-overflow-scrolling: touch;
  }
  .ts-combo-item { flex-shrink: 0; }
  .ts-combo__summary {
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }
  .ts-combo__submit { width: 100%; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('#ts-combo-{{ section.id }}');
  if (!section) return;

  const checkboxes = section.querySelectorAll('.ts-combo-checkbox');
  const totalPriceEl = section.querySelector('.ts-combo__total-price');
  const countEl = section.querySelector('.ts-combo__count');
  const submitBtn = section.querySelector('.ts-combo__submit');
  const symbol = totalPriceEl.dataset.baseCurrency || '₹';

  const updateBundle = () => {
    let total = 0;
    let count = 0;
    const items = section.querySelectorAll('.ts-combo-item');
    
    items.forEach(item => {
      const checkbox = item.querySelector('input[type="checkbox"]');
      if (checkbox && checkbox.checked) {
        total += parseFloat(item.dataset.price) / 100;
        count++;
      }
    });

    totalPriceEl.textContent = symbol + ' ' + total.toLocaleString('en-IN');
    if (countEl) countEl.textContent = count;
    
    // Reset button state
    submitBtn.disabled = count === 0;
    submitBtn.classList.remove('loading');
    submitBtn.style.backgroundColor = '';
    submitBtn.style.borderColor = '';
    submitBtn.innerHTML = `Add <span class="ts-combo__count">${count}</span> items to Cart`;
  };

  checkboxes.forEach(cb => cb.addEventListener('change', updateBundle));
  updateBundle(); // Init

  submitBtn.addEventListener('click', async (e) => {
    e.preventDefault();
    if (submitBtn.classList.contains('loading')) return;

    submitBtn.classList.add('loading');
    submitBtn.disabled = true;
    submitBtn.innerText = 'Adding...';

    const itemsToAdd = [];
    section.querySelectorAll('.ts-combo-item').forEach(item => {
      const cb = item.querySelector('input[type="checkbox"]');
      if (cb && cb.checked) {
        itemsToAdd.push({ id: item.dataset.variantId, quantity: 1 });
      }
    });

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: itemsToAdd, sections: "cart-drawer,cart-icon-bubble" })
      });
      const parsed = await res.json();
      
      if (res.ok) {
        handleCartUpdate(parsed);
        submitBtn.innerText = 'Added!';
        setTimeout(updateBundle, 2000);
      } else if (res.status === 422) {
        let errors = [];
        for (const item of itemsToAdd) {
          const sRes = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [item], sections: "cart-drawer,cart-icon-bubble" })
          });
          const sData = await sRes.json();
          if (sRes.ok) {
            handleCartUpdate(sData);
          } else {
            errors.push(`${sData.title || 'Item'}: ${sData.description || sData.message}`);
          }
        }
        if (errors.length > 0) {
          if (window.showToast) window.showToast(errors[0]);
          submitBtn.style.backgroundColor = '#ef4444';
          submitBtn.style.borderColor = '#ef4444';
          submitBtn.innerText = 'Limit Reached';
          setTimeout(updateBundle, 3000);
        } else {
          submitBtn.innerText = 'Added!';
          setTimeout(updateBundle, 2000);
        }
      } else {
        const errorMsg = parsed.description || parsed.message || 'Error adding items';
        if (window.showToast) window.showToast(errorMsg);
        submitBtn.innerText = 'Error';
        setTimeout(updateBundle, 3000);
      }
    } catch (err) {
      console.error('Bundle add failed', err);
      updateBundle();
    } finally {
      submitBtn.classList.remove('loading');
    }
  });

  function handleCartUpdate(parsed) {
    if (window.openMiniCart) {
      window.openMiniCart();
      return;
    }

    if (!parsed || !parsed.sections) return;
    const bubble = document.getElementById('cart-icon-bubble');
    if (bubble && parsed.sections['cart-icon-bubble']) {
      const newB = new DOMParser().parseFromString(parsed.sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
      if (newB) bubble.innerHTML = newB.innerHTML;
    }
    const drawer = document.querySelector('cart-drawer');
    const dInner = document.querySelector('cart-drawer .drawer__inner');
    if (dInner && parsed.sections['cart-drawer']) {
      const newD = new DOMParser().parseFromString(parsed.sections['cart-drawer'], 'text/html').querySelector('.drawer__inner');
      if (newD) dInner.innerHTML = newD.innerHTML;
    }
    if (drawer && typeof drawer.open === 'function') drawer.open();
    else if (drawer) drawer.classList.add('active');
  }
});
</script>
{%- endif -%}

{% schema %}
{
  "name": "TruSea Combo Buy",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    }
  ],
  "presets": [
    {
      "name": "TruSea Combo Buy"
    }
  ],
  "templates": ["product"]
}
{% endschema %}
