<div class="lc-related-wrap" style="--lc-rw-max-width: {{ section.settings.max_width }}px;">
  <div class="lc-related-header">
    <h2 class="lc-related-title">{{ section.settings.heading }}</h2>
  </div>

  <div class="lc-related-grid">
    {% assign active_collection = collection %}
    {% if active_collection == blank %}
      {% assign active_collection = product.collections.first %}
    {% endif %}

    {% assign counter = 0 %}
    {% for related_product in active_collection.products %}
      {% if related_product.id != product.id and counter < section.settings.limit %}
        <div class="lc-related-item">
          {% render 'licious-product-card', product: related_product, section: section %}
        </div>
        {% assign counter = counter | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if counter == 0 %}
      {% for i in (1..4) %}
        <div class="lc-related-item">
          {% render 'licious-product-card', placeholder: true, index: i, section: section %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

<style>
.lc-related-wrap {
  width: 100%;
  max-width: var(--lc-rw-max-width, 1100px);
  margin: 60px auto 40px;
  padding: 0 20px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  overflow: hidden; /* Prevent any child from bleeding out */
}
.lc-related-title {
  font-size: 20px;
  font-weight: 800;
  color: #1a1a1a;
  margin: 0 0 24px;
}
.lc-related-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  padding-bottom: 20px;
}
.lc-related-grid::-webkit-scrollbar {
  display: none;
}
.lc-related-item {
  flex: 0 0 calc(25% - 15px);
}

@media (max-width: 1024px) {
  .lc-related-item { flex: 0 0 calc(33.333% - 14px); }
}
@media (max-width: 768px) {
  .lc-related-item { flex: 0 0 calc(50% - 10px); }
}
@media (max-width: 480px) {
  .lc-related-wrap { padding: 0 12px; }
  .lc-related-grid { gap: 12px; }
  .lc-related-item { 
    flex: 0 0 calc(100%); /* Stack one below another as requested, or keep 50%? User said "one below another" */
  }
}
</style>

{% schema %}
{
  "name": "Licious Related Products",
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "default": 1100,
      "label": "Max Width"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "label": "Show Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_weight",
      "label": "Show Weight",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show Discount",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show Delivery Target",
      "default": true
    },
    {
      "type": "text",
      "id": "image_ratio",
      "label": "Image Ratio (e.g. 75%)",
      "default": "75%"
    }
  ],
  "presets": [
    {
      "name": "Licious Related Products"
    }
  ]
}
{% endschema %}
