<section id="selfish-faqs" class="sc-faq">
  <div class="sc-faq__wrap page-width">
    <h2 class="sc-faq__title">{{ section.settings.heading }}</h2>

    <div class="sc-faq__list">
      {% for block in section.blocks %}
        <details class="sc-faq__item" {% if forloop.first and section.settings.first_open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="sc-faq__q">
            <span class="sc-faq__qtext">{{ block.settings.question }}</span>
            <span class="sc-faq__icon" aria-hidden="true"></span>
          </summary>

          <div class="sc-faq__a">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>

  <style>
    .sc-faq{
      padding: 44px 0 34px;
      background: #eef6ff;
    }

    .sc-faq__wrap{
      max-width: 1100px;
      margin: 0 auto;
    }

    .sc-faq__title{
      text-align: center;
      font-size: 30px;
      font-weight: 800;
      margin: 0 0 18px;
      color: #0b1f33;
      text-shadow: 0 1px 0 rgba(255,255,255,.7);
    }

    .sc-faq__list{
      display: grid;
      gap: 12px;
    }

    .sc-faq__item{
      border-radius: 12px;
      border: 1px solid rgba(15,35,55,0.18);
      background: rgba(255,255,255,0.72);
      box-shadow: 0 10px 22px rgba(0,30,60,0.08);
      overflow: hidden;
      transition: box-shadow .25s ease, transform .25s ease, border-color .25s ease;
    }

    .sc-faq__item:hover{
      transform: translateY(-1px);
      border-color: rgba(210,173,86,0.45);
      box-shadow:
        0 14px 28px rgba(0,30,60,0.10),
        0 0 18px rgba(210,173,86,0.14);
    }

    .sc-faq__q{
      list-style: none;
      cursor: pointer;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      user-select: none;
    }

    /* Remove default marker */
    .sc-faq__q::-webkit-details-marker{ display:none; }
    .sc-faq__q::marker{ content:""; }

    .sc-faq__qtext{
      font-size: 15px;
      font-weight: 700;
      color: #0d2b44;
      line-height: 1.35;
    }

    /* Plus icon (premium thin) */
    .sc-faq__icon{
      width: 28px;
      height: 28px;
      border-radius: 10px;
      border: 1px solid rgba(15,35,55,0.18);
      background: rgba(240,247,255,0.65);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      flex: 0 0 auto;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
    }
    .sc-faq__icon::before,
    .sc-faq__icon::after{
      content:"";
      position:absolute;
      background: rgba(11,31,51,0.85);
      border-radius: 2px;
    }
    .sc-faq__icon::before{ width: 12px; height: 2px; }
    .sc-faq__icon::after{ width: 2px; height: 12px; }

    /* Open state: rotate to minus */
    details[open] .sc-faq__icon{
      background: linear-gradient(180deg, #f6de97 0%, #d4af63 100%);
      border-color: rgba(150,110,35,0.30);
      box-shadow:
        0 10px 18px rgba(212,175,99,0.25),
        inset 0 1px 0 rgba(255,255,255,0.55);
    }
    details[open] .sc-faq__icon::before,
    details[open] .sc-faq__icon::after{
      background: rgba(11,31,51,0.92);
    }
    details[open] .sc-faq__icon::after{
      transform: scaleY(0); /* hide vertical line = minus */
      transition: transform .18s ease;
    }

    .sc-faq__a{
      padding: 0 16px 14px;
      color: rgba(13,43,68,0.85);
      font-size: 14px;
      line-height: 1.55;
    }

    /* Smooth reveal */
    details .sc-faq__a{
      animation: scFaqIn .18s ease;
    }
    @keyframes scFaqIn{
      from{ opacity: 0; transform: translateY(-3px); }
      to{ opacity: 1; transform: translateY(0); }
    }

    /* Mobile */
    @media (max-width: 768px){
      .sc-faq__title{ font-size: 26px; }
      .sc-faq__qtext{ font-size: 14px; }
      .sc-faq__icon{ width: 26px; height: 26px; }
    }
  </style>
</section>

{% schema %}
{
  "name": "SelFish FAQs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ Section" },
    { "type": "checkbox", "id": "first_open", "label": "Open first FAQ by default", "default": false }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I get first access to the day’s catch?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Members can order from 5:45 AM. Public orders open at 7:00 AM — so you get the best selection first." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SelFish FAQs",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}>