{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-featured-products ts-section" id="ts-featured-products"
  style="
    --ts-prod-bg: {{ section.settings.bg_color | default: '#FAFAFA' }};
  "
>
  <div class="ts-container">
    <div class="ts-section-header">
      <div class="ts-tag">{{ section.settings.eyebrow | default: 'Truly Fresh' }}</div>
      <h2 class="ts-section-heading">{{ section.settings.heading | default: 'Featured Products' }}</h2>
      <p class="ts-section-sub">{{ section.settings.subtext | default: 'Expertly sourced and cut to your perfection.' }}</p>
    </div>

    <div class="ts-product-grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.limit %}
          {% render 'trusea-product-card', product: product %}
        {% endfor %}
      {% else %}
        <!-- Placeholder Cards -->
        {% assign p_names = "Seer - Vanjaram (வஞ்சரம்),Yellowfin Tuna (சூரை),Red Snapper (சங்கரா)" | split: "," %}
        {% assign p_subs = "LARGE SLICES,CURRY CUT,WHOLE CLEANED" | split: "," %}
        {% assign p_imgs = "https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?auto=format&fit=crop&q=80&w=800,https://images.unsplash.com/photo-1534353436294-0dbd4bdac845?auto=format&fit=crop&q=80&w=800,https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&q=80&w=800" | split: "," %}
        
        {% for i in (0..2) %}
          <div class="ts-product-card ts-revealed">
            <div class="ts-card-image-wrap">
              <img src="{{ p_imgs[i] }}" alt="Fish" class="ts-card-img">
              <div class="ts-card-badge ts-badge--info">Protein: 22g/100g</div>
              <div class="ts-card-badge ts-badge--stock">✓ In Stock</div>
            </div>
            
            <div class="ts-card-body">
              <div class="ts-card-header">
                <h3 class="ts-card-title">{{ p_names[i] }}</h3>
                <span class="ts-card-subtitle">{{ p_subs[i] }}</span>
              </div>

              <div class="ts-card-stats">
                <div class="ts-stat-item"><span class="ts-stat-label">Pieces:</span> 5-7</div>
                <div class="ts-stat-item"><span class="ts-stat-label">Gross:</span> 540-600g</div>
                <div class="ts-stat-item"><span class="ts-stat-label">Net:</span> 480-520g</div>
                <div class="ts-stat-item"><span class="ts-stat-label">Serves:</span> 3-4</div>
                <div class="ts-stat-item"><span class="ts-stat-label">Cut:</span> 1 inch</div>
              </div>

              <div class="ts-card-variants">
                <span class="ts-variant-label">SELECT WEIGHT</span>
                <div class="ts-variant-pills">
                  <button class="ts-variant-pill active">500g</button>
                  <button class="ts-variant-pill">1kg</button>
                </div>
              </div>

              <div class="ts-card-price-row">
                <div class="ts-card-price">₹784 <span class="ts-card-price-info">(Incl. GST & Free Delivery)</span></div>
              </div>

              <div class="ts-card-addons">
                 <label class="ts-addon-item">
                    <input type="checkbox" class="ts-addon-check">
                    <span class="ts-addon-text">Add Head and Tail</span>
                    <span class="ts-addon-price">+ ₹199</span>
                 </label>
                 <label class="ts-addon-item">
                    <input type="checkbox" class="ts-addon-check">
                    <span class="ts-addon-text">Need more? Add Extra Pieces</span>
                    <span class="ts-addon-price">+ ₹131/pc</span>
                 </label>
              </div>

              <div class="ts-card-footer">
                <div class="ts-delivery-info">Delivery time: <span class="ts-delivery-value">At your convenience</span></div>
                <button class="ts-btn ts-btn-primary ts-card-add-btn">Add</button>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-featured-products {
  background: var(--ts-prod-bg);
  padding: 100px 0;
}

.ts-section-header {
  text-align: center;
  margin-bottom: 60px;
}
.ts-section-heading {
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 800;
  color: var(--ts-navy);
  margin: 12px 0 16px;
}
.ts-section-sub {
  color: #4B5563; /* Explicit dark gray */
  font-size: 18px;
  max-width: 600px;
  margin: 0 auto;
}

.ts-product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 32px;
}

@media (max-width: 768px) {
  .ts-product-grid {
    grid-template-columns: 1fr;
    padding: 0 10px;
  }
}

.ts-product-card {
  background: var(--ts-white);
  border: 1px solid rgba(14, 37, 65, 0.08);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(14, 37, 65, 0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  color: var(--ts-navy);
  display: flex;
  flex-direction: column;
}

.ts-product-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 30px 60px rgba(14, 37, 65, 0.25);
}

/* Image Wrap */
.ts-card-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
}
.ts-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.ts-product-card:hover .ts-card-img {
  transform: scale(1.05);
}

.ts-card-badge {
  position: absolute;
  top: 16px;
  padding: 6px 14px;
  border-radius: 99px;
  font-size: 13px;
  font-weight: 700;
  z-index: 2;
}
.ts-badge--info {
  left: 16px;
  background: rgba(255, 255, 255, 0.95);
  color: var(--ts-navy);
  border: 1px solid var(--ts-navy);
}
.ts-badge--stock {
  right: 16px;
  background: rgba(60, 191, 160, 0.2);
  color: var(--ts-mint);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid var(--ts-mint);
}

/* Card Body */
.ts-card-body {
  padding: 24px;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.ts-card-header {
  margin-bottom: 20px;
}
.ts-card-title {
  font-size: 24px;
  font-weight: 800;
  margin: 0 0 4px 0;
  letter-spacing: -0.01em;
}
.ts-card-subtitle {
  color: var(--ts-mint);
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* Stats Row */
.ts-card-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  margin-bottom: 20px;
}
.ts-stat-item {
  font-size: 14px;
  display: flex;
  align-items: center;
  gap: 4px;
  color: var(--ts-navy);
  font-weight: 700;
}
.ts-stat-label {
  color: var(--ts-gray);
  font-weight: 400;
}

/* Variants */
.ts-card-variants {
  margin-bottom: 24px;
}
.ts-variant-label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: var(--ts-gray);
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.ts-variant-pills {
  display: flex;
  gap: 12px;
}
.ts-variant-pill {
  flex: 1;
  background: #F3F4F6;
  border: 1px solid #E5E7EB;
  color: var(--ts-navy);
  padding: 14px;
  border-radius: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: var(--ts-transition);
}
.ts-variant-pill:hover {
  background: #E5E7EB;
}
.ts-variant-pill.active {
  background: var(--ts-mint);
  border-color: var(--ts-mint);
  color: var(--ts-white);
}

/* Price */
.ts-card-price-row {
  margin-bottom: 20px;
}
.ts-card-price {
  font-size: 32px;
  font-weight: 900;
  color: #D97706; /* Darker amber for light background */
}
.ts-card-price-info {
  font-size: 14px;
  font-weight: 400;
  color: var(--ts-gray);
  margin-left: 8px;
}

/* Addons */
.ts-card-addons {
  margin-bottom: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.ts-addon-item {
  display: flex;
  align-items: center;
  background: #F9FAFB;
  border: 1px solid #E5E7EB;
  padding: 12px 16px;
  border-radius: 12px;
  cursor: pointer;
  transition: var(--ts-transition);
}
.ts-addon-item:hover {
  background: rgba(255, 255, 255, 0.08);
}
.ts-addon-check {
  width: 20px;
  height: 20px;
  accent-color: var(--ts-mint);
  margin-right: 12px;
}
.ts-addon-text {
  flex-grow: 1;
  font-size: 15px;
  font-weight: 600;
  color: var(--ts-navy);
}
.ts-addon-price {
  font-weight: 800;
  color: var(--ts-mint);
  font-size: 15px;
}

/* Footer & Add Btn */
.ts-card-footer {
  margin-top: auto;
  padding-top: 20px;
  border-top: 1px solid #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ts-delivery-info {
  font-size: 14px;
  color: var(--ts-gray);
}
.ts-delivery-value {
  display: block;
  font-weight: 700;
  color: var(--ts-navy);
}
.ts-card-add-btn {
  padding: 12px 32px;
}
</style>

<script>
(function() {
  // Variant Selection
  const cards = document.querySelectorAll('.ts-product-card');
  cards.forEach(card => {
    const pills = card.querySelectorAll('.ts-variant-pill');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        
        // Update price logic could go here if variant prices differ
      });
    });

    // Add-ons
    const checks = card.querySelectorAll('.ts-addon-check');
    checks.forEach(check => {
      check.addEventListener('change', () => {
        const item = check.closest('.ts-addon-item');
        if (check.checked) {
          item.style.borderColor = 'var(--ts-mint)';
          item.style.background = 'rgba(60, 191, 160, 0.1)';
        } else {
          item.style.borderColor = 'rgba(255, 255, 255, 0.1)';
          item.style.background = 'rgba(255, 255, 255, 0.05)';
        }
      });
    });

    // Simple reveal observer for the products
    const revealEls = card.querySelectorAll('.ts-reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('ts-revealed');
        }
      });
    }, { threshold: 0.1 });
    
    // Target the card itself if it still has ts-reveal
    if (card.classList.contains('ts-reveal')) observer.observe(card);
    revealEls.forEach(el => observer.observe(el));
  });

  // Also reveal header if it has ts-reveal
  const headers = document.querySelectorAll('#ts-featured-products .ts-reveal');
  const hObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('ts-revealed'); });
  }, { threshold: 0.1 });
  headers.forEach(h => hObserver.observe(h));
})();
</script>

{% schema %}
{
  "name": "TruSea Product Grid",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAFAFA"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Truly Fresh" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Expertly sourced and cut to your perfection." },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "TruSea Product Grid"
    }
  ]
}
{% endschema %}
