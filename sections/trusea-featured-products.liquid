{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}
{{ 'trusea-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'trusea-product-card.js' | asset_url }}" defer="defer"></script>

{% if section.settings.show_section != false %}
<section class="ts-featured-products ts-section" id="ts-featured-products"
  style="
    --ts-prod-bg: {{ section.settings.bg_color | default: '#FAFAFA' }};
  "
>
  <div class="ts-container">
    <div class="ts-section-header">
      <div class="ts-tag">{{ section.settings.eyebrow | default: 'Truly Fresh' }}</div>
      <h2 class="ts-section-heading">{{ section.settings.heading | default: 'Featured Products' }}</h2>
      <p class="ts-section-sub">{{ section.settings.subtext | default: 'Expertly sourced and cut to your perfection.' }}</p>
    </div>

    <div class="ts-product-grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.limit %}
          {% render 'trusea-product-card', product: product %}
        {% endfor %}
      {% else %}
        <!-- No collection selected message -->
        <p style="text-align: center; width: 100%;">Please select a collection in the settings to display products.</p>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-featured-products {
  background: var(--ts-prod-bg);
  padding: 100px 0;
}

.ts-product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 32px;
}

@media (max-width: 768px) {
  .ts-product-grid {
    grid-template-columns: 1fr;
    padding: 0 10px;
  }
}
</style>


{% schema %}
{
  "name": "TruSea Product Grid",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAFAFA"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Truly Fresh" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Expertly sourced and cut to your perfection." },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "TruSea Product Grid"
    }
  ]
}
{% endschema %}
