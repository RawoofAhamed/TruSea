{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-cat-grid ts-section" id="ts-cat-grid"
  style="
    --ts-cat-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --ts-cat-heading: {{ section.settings.heading_color | default: '#0E2541' }};
    --ts-cat-accent: {{ section.settings.accent_color | default: '#3CBFA0' }};
  "
>
  <div class="ts-container">
    <div class="ts-cat-grid-layout">

    <div class="ts-cat-grid-header ts-reveal">
      <div class="ts-cat-header-left">
        <div class="ts-tag">{{ section.settings.eyebrow | default: 'Fresh Every Morning' }}</div>
        <h2 class="ts-cat-heading">
          {{ section.settings.heading_line1 | default: 'Our' }} <span style="color:var(--ts-cat-accent)">{{ section.settings.heading_accent | default: 'Best Delivered' }}</span><br>{{ section.settings.heading_line2 | default: 'Categories' }}
        </h2>
      </div>
      <div class="ts-cat-header-right">
        {% if section.settings.subtext != blank %}
          <p class="ts-cat-sub">{{ section.settings.subtext }}</p>
        {% endif %}
        {% if section.settings.cta_url != blank %}
          <a href="{{ section.settings.cta_url }}" class="ts-cat-cta-link">
            {{ section.settings.cta_text | default: 'View all' }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

      <!-- Right: category circles -->
      <div class="ts-cat-circles-wrap">
        <div class="ts-cat-circles">
          {% assign cat_i = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'category' %}
              {% assign cat_i = cat_i | plus: 1 %}
              {% assign cat_link = block.settings.link | default: '/collections/all' %}
              {% assign cat_img = block.settings.image %}
              {% assign cat_name = block.settings.name %}
              {% if block.settings.collection != blank %}
                {% assign cat_link = block.settings.collection.url %}
                {% unless block.settings.image != blank %}
                  {% assign cat_img = block.settings.collection.featured_image %}
                {% endunless %}
                {% if block.settings.name == blank %}
                  {% assign cat_name = block.settings.collection.title %}
                {% endif %}
              {% endif %}
              <a href="{{ cat_link }}" class="ts-cat-item ts-reveal ts-delay-{{ cat_i }}" {{ block.shopify_attributes }}>
                <div class="ts-cat-circle-container">
                  <!-- Decorative Arcs -->
                  <div class="ts-cat-arcs">
                    <svg viewBox="0 0 100 100" class="ts-cat-arc-svg">
                      <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="25 50 25 50" stroke-dashoffset="15" opacity="0.3"></circle>
                      <circle cx="50" cy="50" r="48" fill="none" stroke="var(--ts-cat-accent)" stroke-width="1.5" stroke-dasharray="20 130" stroke-dashoffset="-60"></circle>
                    </svg>
                  </div>
                  
                  <div class="ts-cat-circle">
                    {% if cat_img != blank %}
                      <img
                        src="{{ cat_img | image_url: width: 300 }}"
                        alt="{{ cat_name }}"
                        loading="lazy"
                        width="200"
                        height="200"
                      >
                    {% else %}
                      <div class="ts-cat-placeholder">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(60,191,160,.5)" stroke-width="1.5">
                          <path d="M3 12s3-8 9-8 9 8 9 8-3 8-9 8-9-8-9-8z"/>
                          <circle cx="12" cy="12" r="3"/>
                        </svg>
                      </div>
                    {% endif %}
                  </div>
                </div>
                <div class="ts-cat-label">
                  <span class="ts-cat-name">{{ cat_name | default: 'Seafood' }}</span>
                  {% if block.settings.subtitle != blank %}
                    <span class="ts-cat-sub-label">{{ block.settings.subtitle }}</span>
                  {% endif %}
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

    </div>
  </div>

  <!-- Decorative -->
  <div class="ts-cat-deco" aria-hidden="true">
    <div class="ts-cat-deco-circle ts-cat-deco-circle--1"></div>
    <div class="ts-cat-deco-circle ts-cat-deco-circle--2"></div>
  </div>
</section>

<style>
.ts-cat-grid {
  position: relative;
  background: var(--ts-cat-bg, var(--ts-white));
  padding: 80px 0 90px;
  font-family: var(--ts-font);
  overflow: hidden;
}

/* Layout */
.ts-cat-grid-layout {
  display: flex;
  flex-direction: column;
  gap: 52px;
}

/* Header Rewrite */
.ts-cat-grid-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  border-bottom: 1px solid rgba(14,37,65,0.06);
  padding-bottom: 32px;
}
.ts-cat-header-left { flex: 1; }
.ts-cat-header-right { 
  flex: 1; 
  max-width: 480px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
}

.ts-cat-heading {
  font-size: clamp(24px, 4vw, 42px);
  font-weight: 800;
  line-height: 1.1;
  color: var(--ts-cat-heading, var(--ts-navy));
  margin: 12px 0 0;
  letter-spacing: -.02em;
}
.ts-cat-sub {
  font-size: 15px;
  color: var(--ts-gray);
  line-height: 1.65;
  margin: 0;
}
.ts-cat-cta-link {
  font-size: 14px;
  font-weight: 700;
  color: var(--ts-cat-heading);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: var(--ts-transition);
}
.ts-cat-cta-link:hover { color: var(--ts-cat-accent); }

/* Circles Grid */
.ts-cat-circles-wrap { width: 100%; }
.ts-cat-circles {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48px 32px;
}

/* Category Item */
.ts-cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  text-decoration: none;
}

.ts-cat-circle-container {
  position: relative;
  width: 200px;
  height: 200px;
  padding: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ts-cat-arcs {
  position: absolute;
  inset: 0;
  pointer-events: none;
  color: var(--ts-cat-heading);
}
.ts-cat-arc-svg {
  width: 100%;
  height: 100%;
  transform: rotate(-45deg);
  transition: transform 1s ease;
}
.ts-cat-item:hover .ts-cat-arc-svg { transform: rotate(45deg); }

.ts-cat-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f4f7; /* Light ice-blue base */
  transition: transform .4s cubic-bezier(.34,1.56,.64,1);
  position: relative;
  z-index: 2;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
.ts-cat-circle img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .6s ease;
}
.ts-cat-item:hover .ts-cat-circle { transform: scale(1.03); }
.ts-cat-item:hover .ts-cat-circle img { transform: scale(1.1); }

.ts-cat-label { text-align: center; }
.ts-cat-name {
  display: block;
  font-size: 18px;
  font-weight: 800;
  color: var(--ts-navy);
  margin-bottom: 4px;
}
.ts-cat-sub-label {
  display: block;
  font-size: 14px;
  color: var(--ts-gray);
  font-weight: 500;
}

/* Cleanup old deco */
.ts-cat-deco-circle--1, .ts-cat-deco-circle--2 { display: none; }

/* Responsive */
@media (max-width: 1100px) {
  .ts-cat-grid-header { flex-direction: column; align-items: flex-start; gap: 24px; }
  .ts-cat-header-right { max-width: 100%; }
}
@media (max-width: 900px) {
  .ts-cat-circles { grid-template-columns: repeat(2, 1fr); gap: 40px 24px; }
  .ts-cat-circle-container { width: 180px; height: 180px; }
}
@media (max-width: 600px) {
  .ts-cat-circles { grid-template-columns: 1fr; gap: 36px; }
  .ts-cat-circle-container { width: 220px; height: 220px; }
  .ts-cat-heading { font-size: 30px; }
}
</style>

<script>
(function() {
  const catRevealEls = document.querySelectorAll('#ts-cat-grid .ts-reveal, #ts-cat-grid .ts-reveal-left');
  if (!catRevealEls.length) return;
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  catRevealEls.forEach(el => observer.observe(el));
})();
</script>

{% endif %}

{% schema %}
{
  "name": "Category Grid",
  "settings": [
    {
      "type": "header",
      "content": "⚙️ Section Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "header",
      "content": "🎨 Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0E2541"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#3CBFA0"
    },
    {
      "type": "header",
      "content": "📝 Split Header Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Fresh Every Morning"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading — Line 1",
      "default": "Our"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading — Accent word (colored)",
      "default": "Best Delivered"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading — Line 2",
      "default": "Categories"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Header Description (Right side)",
      "default": "Zero formalin. Just 100% pure, safe fish for your family. Every batch tested twice."
    },
    {
      "type": "header",
      "content": "🔘 View All Link"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Link Text",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to Collection (auto-fills image & URL)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (overrides collection image)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Category Name (leave blank to use collection title)",
          "default": "Category Name"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Tag",
          "default": "So Fresh, It Wiggles"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (overrides collection URL)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "category", "settings": { "name": "Hilsa – Whole", "subtitle": "So Fresh, It Wiggles" } },
        { "type": "category", "settings": { "name": "Salmon Fillets", "subtitle": "Perfect Cut" } },
        { "type": "category", "settings": { "name": "Jumbo Prawns", "subtitle": "Ready to Cook" } },
        { "type": "category", "settings": { "name": "Seer Fish", "subtitle": "Premium Quality" } },
        { "type": "category", "settings": { "name": "Crabs", "subtitle": "Caught Daily" } },
        { "type": "category", "settings": { "name": "Mackerel", "subtitle": "Rich in Omega-3" } }
      ]
    }
  ]
}
{% endschema %}
