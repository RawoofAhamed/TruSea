{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<div class="ts-sc-cta-container">
  <!-- Inline CTA Section -->
  <section class="ts-sc-cta ts-section" id="ts-sc-cta" 
    style="--ts-sc-bg: {{ section.settings.bg_color | default: 'var(--ts-bg-secondary)' }};"
  >


  <div class="ts-container">
      <div class="ts-sc-grid">
        <div class="ts-sc-content ts-reveal-left">
          <h2 class="ts-sc-heading">{{ section.settings.heading | default: 'Join the TruSea Selfish Club' }}</h2>
          <p class="ts-sc-sub">{{ section.settings.subheading | default: '3,200+ seafood lovers are already in. Join them for free.' }}</p>
          
          <ul class="ts-sc-bullets">
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3CBFA0" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Daily fresh catch availability at 5 AM</span>
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3CBFA0" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Members-only discounts before they go public</span>
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3CBFA0" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Weekly recipes from our in-house chef</span>
            </li>
          </ul>

          <div class="ts-sc-social-proof">
             <div class="ts-sc-avatars">
               <div class="ts-sc-avatar" style="background:var(--ts-mint)">A</div>
               <div class="ts-sc-avatar" style="background:var(--ts-navy-dark)">K</div>
               <div class="ts-sc-avatar" style="background:var(--ts-text-muted)">D</div>
             </div>
             <span class="ts-sc-member-count">{{ section.settings.member_count | default: '3,247 members joined' }}</span>
          </div>
        </div>

        <div class="ts-sc-actions ts-reveal-right">
          <div class="ts-sc-card">
            <h3 class="ts-sc-card-title">Login and Join Selfish Club</h3>
            <p class="ts-sc-card-text">Get Daily Catch Updates, Exclusive Offers & Easy Recipes</p>
            <a href="{{ section.settings.cta_url | default: '/account/login' }}" class="ts-btn ts-btn-sc">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.412 2.503 1.112 3.487l-.751 2.742 2.809-.736c.943.515 2.021.808 3.167.809 3.181 0 5.767-2.586 5.768-5.766 0-3.181-2.587-5.767-5.768-5.767-.001 0-.001 0 0 0zm3.428 8.169c-.147.414-.733.754-1.011.808-.242.046-.554.081-1.393-.266-.84-.347-1.381-1.196-1.423-1.252-.042-.056-.743-.986-.743-1.874 0-.888.461-1.321.628-1.503.167-.182.366-.227.487-.227h.346c.112 0 .261-.042.408.315.147.357.502 1.228.546 1.318.045.09.075.195.015.315s-.09.195-.181.299c-.09.105-.19.232-.271.315-.09.09-.184.188-.079.368.105.18.467.77.999 1.242.686.611 1.265.801 1.445.891.18.09.285.075.39-.045s.451-.525.571-.705c.12-.18.24-.15.405-.09.165.06 1.051.495 1.231.585s.3.135.345.225.147.611-.001 1.025zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.434 5.168L2 22l4.958-1.301C8.416 21.579 10.141 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.724 0-3.335-.486-4.704-1.324l-.337-.205-2.455.644.655-2.392-.225-.358C4.093 15.22 3.5 13.681 3.5 12c0-4.687 3.813-8.5 8.5-8.5s8.5 3.813 8.5 8.5-3.813 8.5-8.5 8.5z"/></svg>
              Join the Club
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Floating Mobile Button -->
  <a href="{{ section.settings.cta_url | default: '/account/login' }}" class="ts-sc-floating-btn" id="ts-sc-floating-btn" aria-label="Join Selfish Club">
    <div class="ts-sc-floating-inner">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.412 2.503 1.112 3.487l-.751 2.742 2.809-.736c.943.515 2.021.808 3.167.809 3.181 0 5.767-2.586 5.768-5.766 0-3.181-2.587-5.767-5.768-5.767-.001 0-.001 0 0 0zm3.428 8.169c-.147.414-.733.754-1.011.808-.242.046-.554.081-1.393-.266-.84-.347-1.381-1.196-1.423-1.252-.042-.056-.743-.986-.743-1.874 0-.888.461-1.321.628-1.503.167-.182.366-.227.487-.227h.346c.112 0 .261-.042.408.315.147.357.502 1.228.546 1.318.045.09.075.195.015.315s-.09.195-.181.299c-.09.105-.19.232-.271.315-.09.09-.184.188-.079.368.105.18.467.77.999 1.242.686.611 1.265.801 1.445.891.18.09.285.075.39-.045s.451-.525.571-.705c.12-.18.24-.15.405-.09.165.06 1.051.495 1.231.585s.3.135.345.225.147.611-.001 1.025zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.434 5.168L2 22l4.958-1.301C8.416 21.579 10.141 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.724 0-3.335-.486-4.704-1.324l-.337-.205-2.455.644.655-2.392-.225-.358C4.093 15.22 3.5 13.681 3.5 12c0-4.687 3.813-8.5 8.5-8.5s8.5 3.813 8.5 8.5-3.813 8.5-8.5 8.5z"/></svg>
      <span>Join the Club</span>
    </div>
  </a>
</div>
{% endif %}

<style>
.ts-sc-cta {
  background: var(--ts-sc-bg);
  padding: 80px 0;
  color: white;
  overflow: hidden;
  border-radius: var(--ts-radius-lg);
  margin: 0 24px 80px;
}
.ts-sc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 60px;
}
.ts-sc-heading {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 900;
  color: white;
  margin: 0 0 12px;
  letter-spacing: -0.02em;
}
.ts-sc-sub {
  font-size: 16px;
  color: rgba(255,255,255,0.7);
  margin-bottom: 32px;
}
.ts-sc-bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 40px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.ts-sc-bullets li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 15px;
  font-weight: 500;
  color: rgba(255,255,255,0.9);
}
.ts-sc-social-proof {
  display: flex;
  align-items: center;
  gap: 16px;
}
.ts-sc-avatars {
  display: flex;
  margin-right: -10px;
}
.ts-sc-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid var(--ts-sc-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  margin-left: -8px;
}
.ts-sc-member-count {
  font-size: 14px;
  font-weight: 600;
  color: var(--ts-mint);
}

.ts-sc-actions {
  display: flex;
  justify-content: center;
}
.ts-sc-card {
  background: var(--ts-bg-card);
  padding: 40px;
  border-radius: 24px;
  text-align: center;
  max-width: 400px;
  box-shadow: var(--ts-shadow-lg);
  border: 1px solid var(--ts-border);
}
.ts-sc-card-title {
  color: var(--ts-text-heading);
  font-size: 20px;
  font-weight: 800;
  margin: 0 0 12px;
}
.ts-sc-card-text {
  color: var(--ts-text);
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 28px;
}
.ts-btn-sc {
  background: #25D366;
  color: white;
  width: 100%;
  justify-content: center;
}
.ts-btn-sc:hover {
  background: #20BA5A;
  color: white;
  transform: translateY(-2px);
}

/* Decorative Styling */
.ts-sc-cta { overflow: visible !important; }
.ts-deco--fish-sc { top: 20%; left: -60px; animation: ts-pop-in 1.1s ease-out, ts-float 9s ease-in-out infinite 1.1s; }
.ts-deco--lobster-sc { bottom: 15%; right: -80px; animation: ts-pop-in-right 1.5s ease-out, ts-float-alt 12s ease-in-out infinite 1.5s; }
.ts-deco--fish2-sc { top: 10%; right: -40px; animation: ts-pop-in-right 1.3s ease-out, ts-float 8s ease-in-out infinite 1.3s; }

@media (max-width: 900px) {
  .ts-deco--fish-sc { left: -30px; transform: scale(0.6); }
  .ts-deco--lobster-sc { right: -50px; transform: scale(0.6); }
  .ts-deco--fish2-sc { right: -20px; transform: scale(0.6); }
}

/* Floating Button */
.ts-sc-floating-btn {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: #25D366;
  color: white;
  padding: 12px 20px;
  border-radius: var(--ts-radius-full);
  box-shadow: 0 10px 25px rgba(37,211,102,0.4);
  z-index: 4000;
  text-decoration: none;
  transform: translateY(150px);
  transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
  align-items: center;
}
.ts-sc-floating-btn.visible {
  transform: translateY(0);
}
.ts-sc-floating-inner {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 14px;
}

@media (max-width: 900px) {
  .ts-sc-grid { grid-template-columns: 1fr; gap: 48px; }
  .ts-sc-cta { padding: 60px 0; margin: 0 16px 60px; }
  .ts-sc-heading { text-align: center; }
  .ts-sc-sub { text-align: center; }
  .ts-sc-bullets { align-self: center; }
  .ts-sc-social-proof { justify-content: center; }
}
</style>

<script>
(function() {
  // Reveal
  const scRevealEls = document.querySelectorAll('#ts-sc-cta .ts-reveal-left, #ts-sc-cta .ts-reveal-right');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  scRevealEls.forEach(el => observer.observe(el));

  // Floating Button scroll behavior
  const floatingBtn = document.getElementById('ts-sc-floating-btn');
  if (floatingBtn) {
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const scrollPercent = (scrollY / (docHeight - winHeight)) * 100;

      if (scrollPercent > 50) {
        floatingBtn.classList.add('visible');
      } else {
        floatingBtn.classList.remove('visible');
      }
    }, { passive: true });
  }
})();
</script>

{% schema %}
{
  "name": "Selfish Club CTA",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0E2541"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the TruSea Selfish Club"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "3,200+ seafood lovers are already in. Join them for free."
    },
    {
      "type": "text",
      "id": "member_count",
      "label": "Member Count Text",
      "default": "3,247 members joined"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Login/Join URL"
    }
  ],
  "presets": [
    {
      "name": "Selfish Club CTA"
    }
  ]
}
{% endschema %}
