{% render 'trusea-selfish-club-cta' %}

{% schema %}
{
  "name": "Selfish Club CTA",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0E2541"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the TruSea Selfish Club"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "3,200+ seafood lovers are already in. Join them for free."
    },
    {
      "type": "text",
      "id": "member_count",
      "label": "Member Count Text",
      "default": "3,247 members joined"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Login/Join URL"
    }
  ],
  "presets": [
    {
      "name": "Selfish Club CTA"
    }
  ]
}
{% endschema %}
