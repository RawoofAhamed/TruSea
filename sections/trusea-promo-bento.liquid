    { "type": "text", "id": "card2_original", "label": "Original Price", "default": "699" },
    { "type": "image_picker", "id": "card2_image", "label": "Background Image" },
    { "type": "image_picker", "id": "card2_image2", "label": "Deal Product Image" },
