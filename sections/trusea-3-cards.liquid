<section class="trusea-3cards color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="trusea-3cards__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="trusea-3cards__grid">
      {% for block in section.blocks %}
        <article class="trusea-3cards__card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="trusea-3cards__media">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'trusea-3cards__img',
                  alt: block.settings.image.alt | default: block.settings.title | escape
              }}
            </div>
          {% endif %}

          <div class="trusea-3cards__body">
            {% if block.settings.title != blank %}
              <h3 class="trusea-3cards__title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="trusea-3cards__text rte">
                {{ block.settings.text }}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>

  <style>
    .trusea-3cards{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .trusea-3cards__heading{
      margin: 0 0 18px;
      text-align: center;
      font-weight: 800;
    }

    .trusea-3cards__grid{
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .trusea-3cards__card{
      border-radius: 16px;
      overflow: hidden;
      background: rgb(var(--color-background));
      border: 1px solid rgba(var(--color-foreground), 0.12);
      box-shadow: 0 14px 28px rgba(0,0,0,0.08);
      transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

    .trusea-3cards__card:hover{
      transform: translateY(-2px);
      border-color: rgba(var(--color-foreground), 0.18);
      box-shadow: 0 18px 34px rgba(0,0,0,0.12);
    }

    .trusea-3cards__media{
      aspect-ratio: 1 / 1;
      background: rgba(var(--color-foreground), 0.03);
    }

    .trusea-3cards__img{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .trusea-3cards__body{
      padding: 14px 14px 16px;
      text-align: center;
    }

    .trusea-3cards__title{
      margin: 0 0 8px;
      font-size: 18px;
      font-weight: 800;
      color: rgb(var(--color-foreground));
    }

    .trusea-3cards__text{
      font-size: 14px;
      line-height: 1.6;
      color: rgba(var(--color-foreground), 0.82);
    }

    .trusea-3cards__text p{
      margin: 0 0 10px;
    }
    .trusea-3cards__text p:last-child{
      margin-bottom: 0;
    }

    @media (max-width: 990px){
      .trusea-3cards__grid{
        grid-template-columns: 1fr;
        gap: 14px;
      }
      .trusea-3cards__media{
        aspect-ratio: 16 / 9;
      }
      .trusea-3cards__title{
        font-size: 17px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "TruSea – 3 Premium Cards",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why TruSea"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" },
        { "value": "h3", "label": "Small" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Add your description here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TruSea – 3 Premium Cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}