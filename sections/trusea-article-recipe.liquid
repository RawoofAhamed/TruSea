{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

<section class="ts-recipe-page ts-section" id="ts-recipe-{{ section.id }}" 
  style="--ts-rec-bg: {{ section.settings.bg_color | default: '#F5FBF6' }};"
>
  <div class="ts-container">
    <article class="ts-recipe-container">
      
      <!-- 1. Hero Header -->
      <div class="ts-recipe-hero ts-reveal">
        <div class="ts-recipe-img-wrap">
          {%- assign hero_image = section.settings.banner_image | default: article.image -%}
          {%- if hero_image -%}
            <img src="{{ hero_image | image_url: width: 1400 }}" alt="{{ hero_image.alt | default: article.title }}" class="ts-recipe-hero-img">
          {%- else -%}
             <div class="ts-rec-placeholder">
               <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuA1fNg_FId2fekpuGFe64eLB-UcLeGNLJyq1R2i73oquc-cjVEdX8jf9oyqUM0v98_f74xH-D-CKAy3eP7iumsoteDRUny91RMsqM-ei3p-8DdX21k9IfhP71V0_X5MEslkHywy95VYeDM3tOPBYAqHljV3VJtFh5NSv3x8JKMgAUlXjXKL8Fn9_v_wzovJxKMiQKqepBqcHS3GdUdD2pGBNCUZXa988MdYM6hkJ1UA-_sE7BoPMbsSrcpOrUKpKd9xIfl-f-1CALA" alt="Seer Fish Fry" class="ts-recipe-hero-img">
             </div>
          {%- endif -%}
          <div class="ts-recipe-tags">
            <span class="ts-recipe-tag">Seafood</span>
            <span class="ts-recipe-tag ts-tag-primary">Spicy</span>
          </div>
        </div>
      </div>

      <!-- 2. Title & Meta -->
      <div class="ts-recipe-header-grid ts-reveal">
        <div class="ts-recipe-main-info">
          <h1 class="ts-recipe-title">{{ article.title | default: 'Vanjaram Varuval ! Seer Fish Fry' }}</h1>
          <p class="ts-recipe-desc">
            {%- if article.excerpt.size > 0 -%}
              {{ article.excerpt | strip_html }}
            {%- else -%}
              {{ section.settings.default_desc | default: 'A classic South Indian coastal delicacy. Thick slices of firm seer fish marinated in a fiery blend of roasted spices, ginger, and garlic, then pan-fried to crispy perfection. The addition of rice flour ensures a perfect crust while locking in the ocean-fresh moisture.' }}
            {%- endif -%}
          </p>

          <!-- Meta Bento -->
          <div class="ts-recipe-meta-grid">
            <div class="ts-recipe-meta-item">
              <span class="ts-recipe-meta-label">Prep Time</span>
              <div class="ts-recipe-meta-val">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>{{ section.settings.prep_time | default: '15 m' }}</span>
              </div>
            </div>
            <div class="ts-recipe-meta-item">
              <span class="ts-recipe-meta-label">Cook Time</span>
              <div class="ts-recipe-meta-val">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 11V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><path d="M13 10V6"/><path d="M9 10V6"/><path d="M13 14V11"/><path d="M9 14V11"/></svg>
                <span>{{ section.settings.cook_time | default: '5 m' }}</span>
              </div>
            </div>
            <div class="ts-recipe-meta-item">
              <span class="ts-recipe-meta-label">Servings</span>
              <div class="ts-recipe-meta-val">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>{{ section.settings.servings | default: '4 people' }}</span>
              </div>
            </div>
            <div class="ts-recipe-meta-item">
              <span class="ts-recipe-meta-label">Author</span>
              <div class="ts-recipe-meta-val">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span>{{ article.author | default: section.settings.author | default: 'Srivalli' }}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="ts-recipe-ctas no-print">
          <button class="ts-btn ts-btn-primary ts-recipe-cta-btn" onclick="window.print()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v13a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Save Recipe
          </button>
          <button class="ts-btn ts-btn-outline ts-recipe-cta-btn" onclick="window.print()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Print
          </button>
        </div>
      </div>

      <hr class="ts-recipe-divider">

      <!-- 3. Recipe Content Split Layout -->
      <div class="ts-recipe-split">
        <!-- Sidebar: Ingredients -->
        <aside class="ts-recipe-sidebar">
          <div class="ts-recipe-ingredients-card">
            <h3 class="ts-sidebar-title">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ts-mint)" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Ingredients
            </h3>
            <ul class="ts-ingredients-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'ingredient' -%}
                  <li class="ts-ingredient-item" {{ block.shopify_attributes }}>
                    <span class="ts-ing-name">{{ block.settings.name }}</span>
                    <span class="ts-ing-qty">{{ block.settings.quantity }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            <!-- Nutrition Bento -->
            <div class="ts-nutrition-bento">
              <h4 class="ts-nutrition-title">Nutrition (per serving)</h4>
              <div class="ts-nutrition-grid">
                <div class="ts-nut-item"><span>Calories</span> <strong>{{ section.settings.calories | default: '250' }}</strong></div>
                <div class="ts-nut-item"><span>Protein</span> <strong>{{ section.settings.protein | default: '22g' }}</strong></div>
                <div class="ts-nut-item"><span>Fat</span> <strong>{{ section.settings.fat | default: '16g' }}</strong></div>
                <div class="ts-nut-item"><span>Carbs</span> <strong>{{ section.settings.carbs | default: '4g' }}</strong></div>
              </div>
            </div>
          </div>
        </aside>

        <!-- Main: Instructions -->
        <main class="ts-recipe-instructions">
          <h2 class="ts-instructions-title">Instructions</h2>
          <div class="ts-instructions-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'step' -%}
                <div class="ts-step-item group ts-reveal-up" {{ block.shopify_attributes }}>
                  <div class="ts-step-num">{{ forloop.index }}</div>
                  <div class="ts-step-content">
                    <h4 class="ts-step-title">{{ block.settings.title }}</h4>
                    <p class="ts-step-text">{{ block.settings.text }}</p>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- Social Share CTA -->
          <div class="ts-recipe-social-cta ts-reveal-up">
            <div class="ts-social-cta-content">
              <h3>Tried this recipe?</h3>
              <p>Mention <span class="ts-highlight">@truseafish</span> or tag <span class="ts-highlight">#TruSeaFish</span> on Instagram.</p>
            </div>
            <button class="ts-social-share-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              Share your dish
            </button>
          </div>
        </main>
      </div>

    </article>
  </div>
</section>

<style>
/* --- Layout & Base --- */
.ts-recipe-page {
  background-color: var(--ts-rec-bg, var(--ts-off-white));
  padding: 60px 0 120px;
  font-family: var(--ts-font);
  color: var(--ts-navy);
}

.ts-recipe-container {
  display: flex;
  flex-direction: column;
  gap: 60px;
}

/* --- Hero --- */
.ts-recipe-img-wrap {
  position: relative;
  width: 100%;
  height: 600px;
  border-radius: var(--ts-radius-lg);
  overflow: hidden;
  box-shadow: var(--ts-shadow-lg);
}

.ts-recipe-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.2, 0, 0.2, 1);
}

.ts-recipe-img-wrap:hover .ts-recipe-hero-img {
  transform: scale(1.05);
}

.ts-recipe-tags {
  position: absolute;
  bottom: 40px;
  left: 40px;
  display: flex;
  gap: 12px;
}

.ts-recipe-tag {
  background: rgba(255, 255, 255, 0.95);
  color: var(--ts-navy);
  padding: 6px 16px;
  border-radius: var(--ts-radius-full);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  backdrop-filter: blur(8px);
}

.ts-tag-primary {
  background: var(--ts-mint);
  color: var(--ts-white);
}

/* --- Header & Meta --- */
.ts-recipe-header-grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 60px;
  align-items: flex-start;
}

.ts-recipe-title {
  font-size: clamp(34px, 5vw, 54px);
  font-weight: 900;
  margin: 0 0 24px;
  line-height: 1.1;
  letter-spacing: -0.03em;
}

.ts-recipe-desc {
  font-size: 18px;
  line-height: 1.6;
  opacity: 0.8;
  max-width: 800px;
  margin-bottom: 40px;
}

.ts-recipe-meta-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  background: var(--ts-white);
  padding: 24px;
  border-radius: var(--ts-radius-md);
  border: 1px solid rgba(14, 37, 65, 0.08);
  box-shadow: var(--ts-shadow-sm);
}

.ts-recipe-meta-label {
  display: block;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  opacity: 0.5;
  margin-bottom: 8px;
}

.ts-recipe-meta-val {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 18px;
  font-weight: 700;
}

.ts-recipe-meta-val svg { color: var(--ts-mint); }

.ts-recipe-ctas {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 240px;
}

.ts-recipe-cta-btn {
  width: 100%;
  justify-content: center;
  padding: 16px;
}

.ts-recipe-divider {
  border: 0;
  height: 1px;
  background: var(--ts-gray-light);
  margin: 0;
}

/* --- Split Layout --- */
.ts-recipe-split {
  display: grid;
  grid-template-columns: 4fr 8fr;
  gap: 80px;
}

/* Sidebar: Ingredients */
.ts-recipe-ingredients-card {
  position: sticky;
  top: 40px;
  background: var(--ts-white);
  padding: 40px;
  border-radius: var(--ts-radius-lg);
  border: 1px solid rgba(14, 37, 65, 0.05);
  box-shadow: 0 10px 40px rgba(14, 37, 65, 0.04);
}

.ts-sidebar-title {
  font-size: 24px;
  font-weight: 900;
  margin-bottom: 32px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.ts-ingredients-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.ts-ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid rgba(14, 37, 65, 0.06);
}

.ts-ing-name { font-weight: 500; opacity: 0.9; }
.ts-ing-qty { font-weight: 800; font-size: 13px; opacity: 0.6; }

.ts-nutrition-bento {
  margin-top: 40px;
  padding-top: 32px;
  border-top: 2px dashed rgba(14, 37, 65, 0.1);
}

.ts-nutrition-title { font-size: 14px; font-weight: 800; margin-bottom: 16px; }

.ts-nutrition-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.ts-nut-item {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  padding: 6px 0;
}

.ts-nut-item span { opacity: 0.5; font-weight: 600; }

/* Main: Instructions */
.ts-instructions-title {
  font-size: 32px;
  font-weight: 900;
  margin-bottom: 40px;
}

.ts-instructions-list {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.ts-step-item {
  display: flex;
  gap: 24px;
  align-items: flex-start;
}

.ts-step-num {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--ts-off-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 20px;
  color: var(--ts-mint);
  flex-shrink: 0;
  transition: var(--ts-transition);
  border: 1px solid rgba(60, 191, 160, 0.1);
}

.ts-step-item:hover .ts-step-num {
  background: var(--ts-mint);
  color: var(--ts-white);
  transform: scale(1.1);
}

.ts-step-content {
  background: var(--ts-white);
  padding: 24px 32px;
  border-radius: var(--ts-radius-md);
  border: 1px solid rgba(14, 37, 65, 0.05);
  box-shadow: var(--ts-shadow-sm);
  flex: 1;
  transition: var(--ts-transition);
}

.ts-step-item:hover .ts-step-content {
  border-color: rgba(60, 191, 160, 0.2);
  transform: translateX(8px);
}

.ts-step-title { font-size: 20px; font-weight: 800; margin-bottom: 8px; }
.ts-step-text { font-size: 16px; opacity: 0.7; line-height: 1.6; }

/* Social CTA */
.ts-recipe-social-cta {
  margin-top: 80px;
  background: linear-gradient(135deg, var(--ts-mint) 0%, #2DA68A 100%);
  color: var(--ts-white);
  padding: 48px;
  border-radius: var(--ts-radius-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
  box-shadow: 0 20px 48px rgba(60, 191, 160, 0.25);
}

.ts-recipe-social-cta h3 { font-size: 28px; font-weight: 900; margin-bottom: 8px; }
.ts-recipe-social-cta p { font-size: 17px; opacity: 0.9; }
.ts-highlight { font-weight: 900; border-bottom: 2px solid rgba(255, 255, 255, 0.4); }

.ts-social-share-btn {
  background: var(--ts-navy);
  color: var(--ts-white);
  padding: 16px 32px;
  border-radius: var(--ts-radius-full);
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 12px;
  border: none;
  cursor: pointer;
  transition: var(--ts-transition);
  white-space: nowrap;
}

.ts-social-share-btn:hover {
  transform: translateY(-4px);
  background: var(--ts-navy-dark);
}

/* --- Responsive --- */
@media (max-width: 1100px) {
  .ts-recipe-split { grid-template-columns: 1fr; gap: 60px; }
  .ts-recipe-sidebar { order: 2; }
  .ts-recipe-ingredients-card { position: static; }
}

@media (max-width: 768px) {
  .ts-recipe-hero-grid { grid-template-columns: 1fr; }
  .ts-recipe-ctas { width: 100%; flex-direction: row; }
  .ts-recipe-meta-grid { grid-template-columns: repeat(2, 1fr); }
  .ts-recipe-social-cta { flex-direction: column; text-align: center; padding: 40px 24px; }
  .ts-recipe-header-grid { grid-template-columns: 1fr; gap: 32px; }
}

/* --- Print Styles --- */
@media print {
  .no-print, nav, footer, 
  .ts-social-share-btn, 
  .ts-recipe-social-cta,
  header { display: none !important; }

  .ts-recipe-page { padding: 0; background: white; color: black; }
  .ts-container { max-width: 100%; padding: 0; }
  .ts-recipe-hero { height: auto; }
  .ts-recipe-hero-img { border-radius: 0; max-height: 400px; }
  .ts-recipe-split { display: block; }
  .ts-recipe-ingredients-card { position: static; border: none; box-shadow: none; padding: 20px 0; }
  .ts-recipe-meta-grid { border: 1px solid #eee; grid-template-columns: repeat(4, 1fr); }
  .ts-step-num { border: 1px solid #000; }
  .ts-step-content { box-shadow: none; border: none; padding: 10px 0; }
  .ts-recipe-title { font-size: 32pt; }
  @page { margin: 2cm; }
}
</style>

<script>
(function() {
  const recRevealEls = document.querySelectorAll('.ts-recipe-page .ts-reveal, .ts-recipe-page .ts-reveal-up');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  recRevealEls.forEach(el => observer.observe(el));
})();
</script>

{% schema %}
{
  "name": "Recipe Page",
  "settings": [
    {
      "type": "image_picker",
