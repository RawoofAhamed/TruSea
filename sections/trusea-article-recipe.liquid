          "default": "Wash the fish well, ensuring it is thoroughly cleaned. Drain the water completely, then pat the slices dry with a paper towel to remove excess moisture."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipe Page",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Vanjaram fish slices", "quantity": "4 no" } },
        { "type": "ingredient", "settings": { "name": "Ginger Garlic Paste", "quantity": "1/2 tsp" } },
        { "type": "ingredient", "settings": { "name": "Red Chili powder", "quantity": "3/4 tsp" } },
        { "type": "ingredient", "settings": { "name": "Coriander powder", "quantity": "1/2 tsp" } },
        { "type": "ingredient", "settings": { "name": "Turmeric powder", "quantity": "1/4 tsp" } },
        { "type": "ingredient", "settings": { "name": "Salt", "quantity": "to taste" } },
        { "type": "ingredient", "settings": { "name": "Rice flour", "quantity": "1/2 tsp" } },
        { "type": "ingredient", "settings": { "name": "Oil", "quantity": "for cooking" } },
        { "type": "step", "settings": { "title": "Prep the Fish", "text": "Wash the fish well, ensuring it is thoroughly cleaned. Drain the water completely, then pat the slices dry with a paper towel to remove excess moisture." } },
        { "type": "step", "settings": { "title": "Prepare the Masala Paste", "text": "In a wide bowl, combine the Ginger Garlic paste, Red Chili powder, Coriander powder, Turmeric powder, and Salt. Add just enough water to create a thick, smooth paste." } },
        { "type": "step", "settings": { "title": "Marinate", "text": "Coat each fish slice evenly with the masala paste. Ensure both sides are covered. Just before resting, dust the slices lightly with rice flour. Allow the marinated fish to rest for 15 minutes." } },
        { "type": "step", "settings": { "title": "Pan Fry", "text": "Heat a non-stick pan and add cooking oil. Carefully place the marinated fish slices into the hot pan. Cook on medium heat for about 2 minutes. Flip the slices and cook the other side for another 2-3 minutes until golden brown and cooked through." } }
      ]
    }
  ]
}
{% endschema %}
