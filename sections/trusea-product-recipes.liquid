{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign recipes = product.metafields.custom.related_recipes.value
  assign has_recipes = false
  if recipes != blank
    assign has_recipes = true
  elsif section.blocks.size > 0
    assign has_recipes = true
  endif
-%}

{% if has_recipes %}
<section class="ts-recipes ts-product-recipes ts-section" id="ts-product-recipes-{{ section.id }}" 
  style="--ts-rec-bg: {{ section.settings.bg_color | default: 'var(--ts-bg-secondary)' }};"
>
  <div class="ts-container">
    <div class="ts-rec-header ts-reveal">
      <div class="ts-rec-header-titles">
        <div class="ts-tag">{{ section.settings.eyebrow | default: 'Try These Recipes' }}</div>
        <h2 class="ts-rec-heading">
          {{ section.settings.heading | default: 'What Are You Cooking Today?' }}
        </h2>
      </div>
      <div class="ts-rec-nav no-mobile">
        <button class="ts-scroll-btn ts-scroll-prev" aria-label="Previous">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        </button>
        <button class="ts-scroll-btn ts-scroll-next" aria-label="Next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>
    </div>

    <div class="ts-rec-scroll-container">
      <div class="ts-rec-grid scroll-x">
        {%- if recipes != blank -%}
          {%- for article in recipes -%}
            {%- render 'trusea-recipe-card', article: article, index: forloop.index -%}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- assign article = block.settings.article -%}
            {%- if article != blank -%}
              {%- render 'trusea-recipe-card', article: article, index: forloop.index -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="ts-rec-footer ts-reveal">
      <a href="{{ section.settings.all_recipes_url | default: '/blogs/news' }}" class="ts-rec-all-link">
        <span>See All Recipes</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
.ts-product-recipes {
  padding: 80px 0;
  border-top: 1px solid var(--ts-border);
  border-bottom: 1px solid var(--ts-border);
}
/* Re-use the same styles from trusea-recipes but scoped or as global classes */
/* The styles are already in trusea-recipes.liquid, but for product page consistency 
   we can either keep them global or copy relevant ones here. */
</style>

<script>
(function() {
  const container = document.querySelector('#ts-product-recipes-{{ section.id }} .ts-rec-grid');
  const prevBtn = document.querySelector('#ts-product-recipes-{{ section.id }} .ts-scroll-prev');
  const nextBtn = document.querySelector('#ts-product-recipes-{{ section.id }} .ts-scroll-next');

  if (container && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', () => {
      container.scrollBy({ left: container.offsetWidth * 0.8, behavior: 'smooth' });
    });
    prevBtn.addEventListener('click', () => {
      container.scrollBy({ left: -container.offsetWidth * 0.8, behavior: 'smooth' });
    });
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Product Specific Recipes",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "TruSea Kitchen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Are You Cooking Today?"
    },
    {
      "type": "url",
      "id": "all_recipes_url",
      "label": "All Recipes Link"
    }
  ],
  "blocks": [
    {
      "type": "recipe_article",
      "name": "Fallback Recipe",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Select Recipe Article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Specific Recipes"
    }
  ]
}
{% endschema %}
