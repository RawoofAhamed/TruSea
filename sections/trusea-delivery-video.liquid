{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-video-showcase ts-section" id="ts-video-showcase"
  style="
    --ts-video-bg: {{ section.settings.bg_color | default: 'var(--ts-bg-secondary)' }};
    --ts-video-text: {{ section.settings.text_color | default: 'var(--ts-text)' }};
  "
>
 

  <div class="ts-container">
    <div class="ts-video-header ts-reveal">
      <div class="ts-tag ts-tag-white">{{ section.settings.eyebrow | default: 'Our Process' }}</div>
      <h2 class="ts-video-heading" style="color: var(--ts-video-text);">{{ section.settings.heading | default: 'From the Sea to Your Plate — Watch How It Works' }}</h2>
    </div>

    <div class="ts-video-container ts-reveal ts-delay-1">
      <div class="ts-video-wrap" id="ts-video-wrap-{{ section.id }}">
        {% if section.settings.video_library != blank or section.settings.video_url != blank %}
          <!-- Main Video Area (Hidden until trigger click) -->
          <div class="ts-video-main" id="ts-video-main-{{ section.id }}" style="display:none; position:absolute; inset:0; z-index:10;">
            {% if section.settings.video_library != blank %}
              <video id="ts-video-lib-{{ section.id }}" controls style="width:100%; height:100%; object-fit:cover;">
                {% for source in section.settings.video_library.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              </video>
            {% elsif section.settings.video_url != blank %}
              {% if section.settings.video_url.type == 'youtube' %}
                <iframe id="ts-video-iframe-{{ section.id }}" data-src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen style="width:100%; height:100%;"></iframe>
              {% elsif section.settings.video_url.type == 'vimeo' %}
                <iframe id="ts-video-iframe-{{ section.id }}" data-src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen style="width:100%; height:100%;"></iframe>
              {% endif %}
            {% endif %}
          </div>

          <!-- Video Placeholder/Trigger -->
          <div class="ts-video-placeholder" id="ts-video-trigger-{{ section.id }}" style="z-index:20;">
            {% if section.settings.placeholder_image != blank %}
              <img src="{{ section.settings.placeholder_image | image_url: width: 1200 }}" alt="Video Placeholder" loading="lazy">
            {% else %}
              <div class="ts-video-no-img">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
            
            <div class="ts-video-play-overlay">
              <div class="ts-play-btn-lg">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
          </div>
        {% else %}
          <div class="ts-video-placeholder">
            <div class="ts-video-no-img">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-video-showcase {
  background: var(--ts-video-bg);
  padding: 100px 0;
  color: var(--ts-video-text);
  text-align: center;
}
.ts-video-header {
  max-width: 800px;
  margin: 0 auto 52px;
}
.ts-tag-white {
  background: rgba(255,255,255,0.1) !important;
  color: white !important;
}
.ts-video-heading {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-top: 20px;
}
.ts-video-container {
  max-width: 1000px;
  margin: 0 auto;
}
.ts-video-wrap {
  position: relative;
  padding-bottom: 56.25%; /* 16:9 */
  height: 0;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 40px 80px rgba(0,0,0,0.4);
  background: #000;
}
.ts-video-wrap iframe,
.ts-video-wrap video {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  border: none;
}
.ts-video-placeholder {
  position: absolute;
  inset: 0;
  cursor: pointer;
}
.ts-video-placeholder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.7;
  transition: transform 0.6s ease;
}
.ts-video-placeholder:hover img { transform: scale(1.05); }
.ts-video-no-img {
  width: 100%;
  height: 100%;
  background: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.4;
}
.ts-video-play-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.25);
  transition: background 0.3s ease;
  z-index: 100;
  pointer-events: none;
}
.ts-video-placeholder:hover .ts-video-play-overlay {
  background: rgba(14,37,65,0.4);
}
.ts-play-btn-lg {
  width: 96px;
  height: 96px;
  background: white;
  color: var(--ts-navy-dark);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 10px 40px rgba(0,0,0,0.5);
}
.ts-play-btn-lg svg {
  margin-left: 4px; /* Optical centering */
}
.ts-video-placeholder:hover .ts-play-btn-lg {
  transform: scale(1.1);
  background: var(--ts-mint);
  color: white;
}

/* Decorative Styling */
.ts-video-showcase { overflow: visible !important; }
.ts-deco--crab-v { top: 15%; left: -50px; animation: ts-pop-in 1.2s ease-out, ts-float 8s ease-in-out infinite 1.2s; }
.ts-deco--prawn-v { bottom: 20%; left: -30px; animation: ts-pop-in 1.4s ease-out, ts-float-alt 10s ease-in-out infinite 1.4s; }
.ts-deco--fish-v { top: 10%; right: -70px; animation: ts-pop-in-right 1.3s ease-out, ts-float 7s ease-in-out infinite 1.3s; }

@media (max-width: 900px) {
  .ts-deco--crab-v { left: -30px; transform: scale(0.6); }
  .ts-deco--prawn-v { left: -20px; transform: scale(0.6); }
  .ts-deco--fish-v { right: -40px; transform: scale(0.6); }
}
</style>

<script>
(function() {
  const videoRevealEls = document.querySelectorAll('#ts-video-showcase .ts-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  videoRevealEls.forEach(el => observer.observe(el));

  // Video Trigger Logic
  const trigger = document.getElementById('ts-video-trigger-{{ section.id }}');
  if (trigger) {
    trigger.onclick = () => {
      const vmain = document.getElementById('ts-video-main-{{ section.id }}');
      const vlib = document.getElementById('ts-video-lib-{{ section.id }}');
      const vifr = document.getElementById('ts-video-iframe-{{ section.id }}');
      
      if (vmain) {
        trigger.style.display = 'none';
        vmain.style.display = 'block';
        
        if (vlib) {
          vlib.play();
        } else if (vifr) {
          vifr.src = vifr.dataset.src;
        }
      }
    };
  }
})();
</script>

{% schema %}
{
  "name": "Delivery Video",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0E2541"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Process"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Sea to Your Plate — Watch How It Works"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "External Video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "video",
      "id": "video_library",
      "label": "Shopify Video Library"
    },
    {
      "type": "image_picker",
      "id": "placeholder_image",
      "label": "Placeholder/Thumbnail Image"
    }
  ],
  "presets": [
    {
      "name": "Delivery Video"
    }
  ]
}
{% endschema %}
