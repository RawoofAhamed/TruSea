{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-video-showcase ts-section" id="ts-video-showcase"
  style="
    --ts-video-bg: {{ section.settings.bg_color | default: '#0E2541' }};
    --ts-video-text: {{ section.settings.text_color | default: '#FFFFFF' }};
  "
>
  <div class="ts-container">
    <div class="ts-video-header ts-reveal">
      <div class="ts-tag ts-tag-white">{{ section.settings.eyebrow | default: 'Our Process' }}</div>
      <h2 class="ts-video-heading" style="color: #fff;">{{ section.settings.heading | default: 'From the Sea to Your Plate — Watch How It Works' }}</h2>
    </div>

    <div class="ts-video-container ts-reveal ts-delay-1">
      <div class="ts-video-wrap">
        {% if section.settings.video_url != blank %}
          {% if section.settings.video_url.type == 'youtube' %}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
          {% elsif section.settings.video_url.type == 'vimeo' %}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
          {% else %}
            <video controls preload="metadata" poster="{{ section.settings.placeholder_image | image_url: width: 1200 }}">
              <source src="{{ section.settings.video_url }}" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          {% endif %}
        {% else %}
          <div class="ts-video-placeholder">
            {% if section.settings.placeholder_image != blank %}
              <img src="{{ section.settings.placeholder_image | image_url: width: 1200 }}" alt="Video Placeholder" loading="lazy">
            {% else %}
              <div class="ts-video-no-img">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
            <div class="ts-video-play-overlay">
              <div class="ts-play-btn-lg">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-video-showcase {
  background: var(--ts-video-bg);
  padding: 100px 0;
  color: var(--ts-video-text);
  text-align: center;
}
.ts-video-header {
  max-width: 800px;
  margin: 0 auto 52px;
}
.ts-tag-white {
  background: rgba(255,255,255,0.1) !important;
  color: white !important;
}
.ts-video-heading {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-top: 20px;
}
.ts-video-container {
  max-width: 1000px;
  margin: 0 auto;
}
.ts-video-wrap {
  position: relative;
  padding-bottom: 56.25%; /* 16:9 */
  height: 0;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 40px 80px rgba(0,0,0,0.4);
  background: #000;
}
.ts-video-wrap iframe,
.ts-video-wrap video {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  border: none;
}
.ts-video-placeholder {
  position: absolute;
  inset: 0;
  cursor: pointer;
}
.ts-video-placeholder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.7;
  transition: transform 0.6s ease;
}
.ts-video-placeholder:hover img { transform: scale(1.05); }
.ts-video-no-img {
  width: 100%;
  height: 100%;
  background: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.4;
}
.ts-video-play-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(14,37,65,0.2);
  transition: background 0.3s ease;
}
.ts-video-placeholder:hover .ts-video-play-overlay {
  background: rgba(14,37,65,0.4);
}
.ts-play-btn-lg {
  width: 90px;
  height: 90px;
  background: white;
  color: var(--ts-navy);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}
.ts-video-placeholder:hover .ts-play-btn-lg {
  transform: scale(1.15);
  background: var(--ts-mint);
  color: white;
}
</style>

<script>
(function() {
  const videoRevealEls = document.querySelectorAll('#ts-video-showcase .ts-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  videoRevealEls.forEach(el => observer.observe(el));
})();
</script>

{% schema %}
{
  "name": "Delivery Video",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0E2541"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Process"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Sea to Your Plate — Watch How It Works"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "placeholder_image",
      "label": "Placeholder/Thumbnail Image"
    }
  ],
  "presets": [
    {
      "name": "Delivery Video"
    }
  ]
}
{% endschema %}
