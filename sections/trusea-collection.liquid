{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<div class="lc-coll-wrap">

  {%- paginate collection.products by section.settings.products_per_page -%}

  <!-- ── Collection Header ── -->
  <div class="lc-coll-header">
    <div class="lc-coll-header__inner">
      <div class="lc-coll-header__titles">
        <h1 class="lc-coll-title">{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <p class="lc-coll-desc">{{ collection.description | strip_html | truncatewords: 20 }}</p>
        {% endif %}
      </div>
      <div class="lc-coll-count">
        <span>{{ collection.products_count }} products</span>
      </div>
    </div>
  </div>

  <!-- ── Sort + Filter Bar ── -->
  <div class="lc-coll-toolbar">
    <div class="lc-coll-toolbar__inner">

      <div class="lc-coll-filters-scroll-wrap">
        <div class="lc-coll-filters" id="lc-filters">
          <button class="lc-filter-pill active" data-tag="all" onclick="lcFilterAll(this)">All</button>
          {%- for tag in collection.all_tags limit: 10 -%}
            <button class="lc-filter-pill {% if current_tags contains tag %}active{% endif %}"
                    data-tag="{{ tag | handleize }}"
                    onclick="lcFilterTag(this, '{{ tag | escape }}')">
              {{ tag }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <!-- Sort -->
      <div class="lc-coll-sort">
        <label for="lc-sortby" class="lc-sort-label">Sort</label>
        <div class="lc-sort-select-wrap">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <select id="lc-sortby" class="lc-sort-select"
                  onchange="window.location = '{{ collection.url }}?sort_by=' + this.value">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"
                      {% if option.value == sort_by %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
          <svg class="lc-sort-caret" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
      </div>

    </div>
  </div>

  <!-- ── Product Grid ── -->
  <div class="lc-coll-grid" id="lc-product-grid">
    {%- for product in collection.products -%}
      {% render 'trusea-product-card', product: product, section: section %}
    {%- else -%}
      <div class="lc-coll-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d8eeff" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <p>No products found in this collection.</p>
      </div>
    {%- endfor -%}
  </div>

  <!-- ── Pagination ── -->
  {%- if paginate.pages > 1 -%}
    <div class="lc-coll-pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="lc-page-btn">← Prev</a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="lc-page-btn">{{ part.title }}</a>
        {%- else -%}
          <span class="lc-page-btn lc-page-btn--active">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="lc-page-btn">Next →</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- endpaginate -%}
</div>

<style>
/* ── Collection Page Layout ── */
.lc-coll-wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding: 24px 20px 48px;
  font-family: var(--ts-font, 'Inter', sans-serif);
}

/* Header */
.lc-coll-header {
  margin-bottom: 24px;
  padding: 40px 0 24px;
  position: relative;
  overflow: hidden;
}
.lc-coll-header::before {
  content: '';
  position: absolute;
  top: -50px;
  right: -50px;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(216, 238, 255, 0.4) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  z-index: -1;
}
.lc-coll-header__inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
}
.lc-coll-title {
    font-size: 32px;
    font-weight: 800;
    color: #0d3d6e;
    margin: 0 0 4px;
    line-height: 1.1;
    font-family: var(--font-heading-family);
    letter-spacing: -0.5px;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
}
.lc-coll-desc {
  font-size: 13px;
  color: #4a5568;
  margin: 0;
  line-height: 1.5;
}
.lc-coll-count {
  font-size: 12px;
  font-weight: 700;
  color: #1a6ea8;
  background: #f0f8ff;
  border: 1px solid #d8eeff;
  border-radius: 20px;
  padding: 4px 14px;
  white-space: nowrap;
}

/* Toolbar */
.lc-coll-toolbar {
  position: sticky;
  top: var(--header-height, 0);
  z-index: 3; /* Stay above content but below drawers/modals */
  background: #fff;
  border-bottom: 1px solid #eef2f7;
  margin-bottom: 24px;
  padding: 12px 0;
  transition: top 0.3s ease;
}
.lc-coll-toolbar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

/* Filter pills */
.lc-coll-filters-scroll-wrap {
  position: relative;
  flex: 1;
  overflow: hidden;
}
.lc-coll-filters-scroll-wrap::before,
.lc-coll-filters-scroll-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 40px;
  z-index: 2;
  pointer-events: none;
  transition: opacity 0.3s;
}
.lc-coll-filters-scroll-wrap::before {
  left: 0;
  background: linear-gradient(to right, #fff, rgba(255,255,255,0));
}
.lc-coll-filters-scroll-wrap::after {
  right: 0;
  background: linear-gradient(to left, #fff, rgba(255,255,255,0));
}

.lc-coll-filters {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  width: 100%;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch; 
  padding: 8px 0;
}
.lc-coll-filters::-webkit-scrollbar { display: none; }
.lc-filter-pill {
  flex-shrink: 0; /* Prevent pills from squeezing */
  padding: 6px 16px;
  border-radius: 50px;
  border: 1.5px solid #d8eeff;
  background: #fff;
  font-size: 12px;
  font-weight: 700;
  color: #4a5568;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
}
.lc-filter-pill:hover { border-color: #1a6ea8; color: #0d3d6e; }
.lc-filter-pill.active {
  background: #0d3d6e;
  border-color: #0d3d6e;
  color: #fff;
}

/* Sort */
.lc-coll-sort { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.lc-sort-label { font-size: 11px; font-weight: 800; color: #0d3d6e; text-transform: uppercase; letter-spacing: 0.4px; }
.lc-sort-select-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.lc-sort-select {
  appearance: none;
  border: 1.5px solid #d8eeff;
  border-radius: 8px;
  padding: 6px 32px 6px 12px;
  font-size: 12px;
  font-weight: 600;
  color: #0d3d6e;
  background: #fff;
  cursor: pointer;
  outline: none;
}
.lc-sort-select:focus { border-color: #1a6ea8; }
.lc-sort-caret {
  position: absolute;
  right: 10px;
  width: 10px;
  color: #1a6ea8;
  pointer-events: none;
}

/* ── Product Grid ── */
.lc-coll-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: 20px;
}
@media (max-width: 1024px) {
  .lc-coll-header { padding: 30px 0 15px; }
  .lc-coll-title { font-size: 24px; }
  .lc-coll-toolbar__inner { gap: 16px; }
  .lc-coll-filters {
    margin-right: -10px;
    padding-right: 10px;
    overflow-x: scroll;
    max-width: 85vw;
  }
}

@media (max-width: 540px) {
    .lc-coll-filters {
        max-width: 90vw;
    }
}

@media (max-width: 600px) { 
  .lc-coll-grid { grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr); gap: 12px; } 
  .lc-coll-header { padding: 25px 0 15px; }
  
  .lc-coll-toolbar { 
    margin-left: -20px; 
    margin-right: -20px; 
    padding: 12px 20px;
  }
  
  .lc-coll-toolbar__inner {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }
  
  .lc-coll-filters {
    margin-right: -20px;
    padding-right: 20px;
  }
  
  .lc-filter-pill { padding: 6px 14px; font-size: 11px; }
  
  .lc-coll-sort {
    justify-content: space-between;
    border-top: 1px solid #f8fafc;
    padding-top: 12px;
  }
  
  .lc-sort-label { display: inline-block; font-size: 10px; opacity: 0.6; } 

  .lc-sort-select {
    font-size: 13px;
    padding: 8px 32px 8px 12px;
    flex: 1;
    max-width: 200px;
  }
}



/* Empty state */
.lc-coll-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 20px;
  color: #aaa;
  font-size: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

/* Pagination */
.lc-coll-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 40px;
}
.lc-page-btn {
  padding: 8px 16px;
  border-radius: 8px;
  border: 1.5px solid #d8eeff;
  background: #fff;
  color: #0d3d6e;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s;
}
.lc-page-btn:hover { background: #0d3d6e; color: #fff; border-color: #0d3d6e; }
.lc-page-btn--active {
  background: #0d3d6e;
  color: #fff;
  border-color: #0d3d6e;
}
</style>

<script>
// Tag filter (client-side URL redirect)
function lcFilterTag(btn, tag) {
  document.querySelectorAll('.lc-filter-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  window.location = '{{ collection.url }}/' + tag;
}
function lcFilterAll(btn) {
  document.querySelectorAll('.lc-filter-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  window.location = '{{ collection.url }}';
}
</script>

{% schema %}
{
  "name": "TruSea Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Card Ribbon Badge",
      "default": "Best Seller"
    },
    {
      "type": "text",
      "id": "image_ratio",
      "label": "Image Ratio (e.g. 100%, 75%, 65%)",
      "default": "75%"
    },
    {
      "type": "range",
      "id": "slider_interval",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "label": "Carousel Interval (seconds)"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "label": "Show Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_weight",
      "label": "Show Net Weight",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show Discount Badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show Delivery Badge",
      "default": true
    }
  ],
  "presets": [
    { "name": "TruSea Collection Grid" }
  ]
}
{% endschema %}
