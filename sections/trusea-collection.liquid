{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
/* ── Special Catch Banner ── */
.ts-catch-banner {
  background: var(--ts-bg-hero, linear-gradient(135deg, #050c18 0%, #0d1f35 50%, #0a2d25 100%));
  padding: 50px 30px;
  text-align: center;
  border-radius: 24px;
  margin-bottom: 32px;
  box-shadow: var(--ts-shadow-lg);
  position: relative;
  overflow: hidden;
}

[data-theme="light"] .ts-catch-banner {
  background: #0E2541; /* Keep it dark as per reference image */
}

.ts-catch-banner__content {
  max-width: 700px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.ts-catch-banner__tagline {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: var(--ts-mint, #3CBFA0);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.ts-catch-banner__heading {
  color: #FFFFFF !important;
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 900;
  line-height: 1.15;
  margin: 0 0 12px;
  letter-spacing: -0.01em;
  font-family: var(--ts-font, sans-serif);
}

.ts-catch-banner__subtext {
  color: rgba(255, 255, 255, 0.75);
  font-size: 15px;
  font-weight: 500;
  margin: 0;
  letter-spacing: 0.02em;
}

@media (max-width: 768px) {
  .ts-catch-banner {
    padding: 35px 20px;
    border-radius: 20px;
    margin-bottom: 24px;
  }
  .ts-catch-banner__heading {
    font-size: 24px;
  }
  .ts-catch-banner__subtext {
    font-size: 13px;
  }
}

/* ── Collection Page Layout ── */
.lc-coll-wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding: 24px 20px 48px;
  font-family: var(--ts-font, 'Inter', sans-serif);
}

/* Header */
.lc-coll-header {
  margin-bottom: 24px;
  padding: 40px 0 24px;
  position: relative;
  overflow: hidden;
}
.lc-coll-header::before {
  content: '';
  position: absolute;
  top: -50px;
  right: -50px;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(216, 238, 255, 0.4) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  z-index: -1;
}
.lc-coll-header__inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
}
.lc-coll-title {
    font-size: 32px;
    font-weight: 800;
    color: var(--ts-text-heading);
    margin: 0 0 4px;
    line-height: 1.1;
    font-family: var(--font-heading-family);
    letter-spacing: -0.5px;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
}
.lc-coll-desc {
  font-size: 13px;
  color: var(--ts-text);
  margin: 0;
  line-height: 1.5;
}
.lc-coll-count {
  font-size: 12px;
  font-weight: 700;
  color: var(--ts-mint);
  background: var(--ts-bg-secondary);
  border: 1px solid var(--ts-border);
  border-radius: 20px;
  padding: 4px 14px;
  white-space: nowrap;
}

/* Toolbar */
.lc-coll-toolbar {
  position: sticky;
  top: var(--header-height, 0);
  z-index: 3; /* Stay above content but below drawers/modals */
  background: var(--ts-bg-card);
  border-bottom: 1px solid var(--ts-border);
  margin-bottom: 24px;
  padding: 12px 0;
  transition: top 0.3s ease;
}
.lc-coll-toolbar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

/* Filter pills */
.lc-coll-filters-scroll-wrap {
  position: relative;
  flex: 1;
  overflow: hidden;
}
.lc-coll-filters-scroll-wrap::before,
.lc-coll-filters-scroll-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 40px;
  z-index: 2;
  pointer-events: none;
  transition: opacity 0.3s;
}
.lc-coll-filters-scroll-wrap::before {
  left: 0;
  background: linear-gradient(to right, var(--ts-bg-card), transparent);
}
.lc-coll-filters-scroll-wrap::after {
  right: 0;
  background: linear-gradient(to left, var(--ts-bg-card), transparent);
}

.lc-coll-filters {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  width: 100%;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch; 
  padding: 8px 0;
}
.lc-coll-filters::-webkit-scrollbar { display: none; }
.lc-filter-pill {
  flex-shrink: 0; /* Prevent pills from squeezing */
  padding: 6px 16px;
  border-radius: 50px;
  border: 1.5px solid var(--ts-border);
  background: var(--ts-bg-raised);
  font-size: 12px;
  font-weight: 700;
  color: var(--ts-text);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
}
.lc-filter-pill:hover { border-color: var(--ts-mint); color: var(--ts-mint); }
.lc-filter-pill.active {
  background: var(--ts-mint);
  border-color: var(--ts-mint);
  color: #fff;
}

/* Sort */
.lc-coll-sort { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.lc-sort-label { font-size: 11px; font-weight: 800; color: var(--ts-text-heading); text-transform: uppercase; letter-spacing: 0.4px; }
.lc-sort-select-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.lc-sort-select {
  appearance: none;
  border: 1.5px solid var(--ts-border);
  border-radius: 8px;
  padding: 6px 32px 6px 12px;
  font-size: 12px;
  font-weight: 600;
  color: var(--ts-text);
  background: var(--ts-bg-raised);
  cursor: pointer;
  outline: none;
}
.lc-sort-select:focus { border-color: var(--ts-mint); }
.lc-sort-caret {
  position: absolute;
  right: 10px;
  width: 10px;
  color: #1a6ea8;
  pointer-events: none;
}

/* ── Product Grid ── */
.lc-coll-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: 20px;
}
@media (max-width: 1024px) {
  .lc-coll-header { padding: 30px 0 15px; }
  .lc-coll-title { font-size: 24px; }
  .lc-coll-toolbar__inner { gap: 16px; }
  .lc-coll-filters {
    margin-right: -10px;
    padding-right: 10px;
    overflow-x: scroll;
    max-width: 85vw;
  }
}

@media (max-width: 540px) {
    .lc-coll-filters {
        max-width: 90vw;
    }
}

@media (max-width: 600px) { 
  .lc-coll-grid { grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr); gap: 12px; } 
  .lc-coll-header { padding: 25px 0 15px; }
  
  .lc-coll-toolbar { 
    margin-left: -20px; 
    margin-right: -20px; 
    padding: 12px 20px;
  }
  
  .lc-coll-toolbar__inner {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }
  
  .lc-coll-filters {
    margin-right: -20px;
    padding-right: 20px;
  }
  
  .lc-filter-pill { padding: 6px 14px; font-size: 11px; }
  
  .lc-coll-sort {
    justify-content: space-between;
    border-top: 1px solid #f8fafc;
    padding-top: 12px;
  }
  
  .lc-sort-label { display: inline-block; font-size: 10px; opacity: 0.6; } 

  .lc-sort-select {
    font-size: 13px;
    padding: 8px 32px 8px 12px;
    flex: 1;
    max-width: 200px;
  }
}

/* Empty state */
.lc-coll-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 20px;
  color: #aaa;
  font-size: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

/* Pagination */
.lc-coll-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 40px;
}
.lc-page-btn {
  padding: 8px 16px;
  border-radius: 8px;
  border: 1.5px solid var(--ts-border);
  background: var(--ts-bg-raised);
  color: var(--ts-text);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s;
}
.lc-page-btn:hover { background: var(--ts-mint); color: #fff; border-color: var(--ts-mint); }
.lc-page-btn--active {
  background: var(--ts-mint);
  color: #fff;
  border-color: var(--ts-mint);
}
</style>

{%- liquid
  assign collection_to_show = collection
  if collection.handle == 'limited-catch'
    assign collection_to_show = collections.all
  endif

  # Manual tag and sort detection
  assign current_filter_tag = ""
  assign current_sort_by = ""
  assign capture_params = content_for_header | split: '\"'
  for part in capture_params
    if part contains 'tag='
      assign current_filter_tag = part | split: 'tag=' | last | split: '&' | first | url_decode
    elsif part contains 'sort_by='
      assign current_sort_by = part | split: 'sort_by=' | last | split: '&' | first | url_decode
    endif
  endfor
-%}

<div class="lc-coll-wrap">

  {%- liquid
    assign limit = section.settings.products_per_page
    if collection.handle == 'limited-catch'
      assign limit = 250
    endif
  -%}
  {%- paginate collection_to_show.products by limit -%}

  {%- if collection.handle == 'limited-catch' -%}
    <!-- ── Special Catch Banner ── -->
    <div class="ts-catch-banner">
      <div class="ts-catch-banner__content">
        <div class="ts-catch-banner__tagline">
          <span class="ts-catch-banner__emoji">🐟</span>
          CHENNAI'S FRESHEST SEAFOOD
        </div>
        <h1 class="ts-catch-banner__heading">Daily Fresh Catch Straight to Your Door</h1>
        <p class="ts-catch-banner__subtext">Sourced daily &middot; Cleaned &amp; packed &middot; FREE delivery</p>
      </div>
    </div>
  {%- else -%}
    <!-- ── Default Collection Header ── -->
    <div class="lc-coll-header">
      <div class="lc-coll-header__inner">
        <div class="lc-coll-header__titles">
          <h1 class="lc-coll-title">{{ collection.title }}</h1>
          {% if collection.description != blank %}
            <p class="lc-coll-desc">{{ collection.description | strip_html | truncatewords: 20 }}</p>
          {% endif %}
        </div>
        <div class="lc-coll-count">
          <span>{{ collection_to_show.products_count }} products</span>
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- ── Sort + Filter Bar ── -->
  <div class="lc-coll-toolbar">
    <div class="lc-coll-toolbar__inner">

      <div class="lc-coll-filters-scroll-wrap">
        <div class="lc-coll-filters" id="lc-filters">
          <button class="lc-filter-pill {% if current_tags == blank and current_filter_tag == "" %}active{% endif %}" data-tag="all" onclick="lcFilterAll(this)">All</button>
          {%- for tag in collection_to_show.all_tags limit: 12 -%}
             {%- liquid
               assign is_active = false
               assign search_tag_lc = current_filter_tag | downcase
               assign tag_lc = tag | downcase
               if current_tags contains tag
                 assign is_active = true
               elsif search_tag_lc == tag_lc
                 assign is_active = true
               endif
             -%}
            <button class="lc-filter-pill {% if is_active %}active{% endif %}"
                    data-tag="{{ tag | handleize }}"
                    onclick="lcFilterTag(this, '{{ tag | escape }}')">
              {{ tag }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <!-- Sort -->
      <div class="lc-coll-sort">
        <label for="lc-sortby" class="lc-sort-label">Sort</label>
        <div class="lc-sort-select-wrap">
          {%- assign active_sort = current_sort_by | default: collection_to_show.sort_by | default: 'best-selling' -%}
          <select id="lc-sortby" class="lc-sort-select"
                  onchange="const url = new URL(window.location.href); url.searchParams.set('sort_by', this.value); window.location.href = url.toString();">
            {%- for option in collection_to_show.sort_options -%}
              <option value="{{ option.value }}"
                      {% if option.value == active_sort %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
          <svg class="lc-sort-caret" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
      </div>

    </div>
  </div>

  <!-- ── Product Grid ── -->
  <div class="lc-coll-grid" id="lc-product-grid">
    {%- for product in collection_to_show.products -%}
      {%- comment -%} Check if product matches current_tags or current_filter_tag if we are on the limited-catch override {%- endcomment -%}
      {%- if collection.handle == 'limited-catch' -%}
        {%- if current_tags != blank or current_filter_tag != "" -%}
          {%- assign matches_tags = true -%}
          {%- if current_filter_tag != "" -%}
            {%- liquid
              assign has_tag = false
              assign search_tag = current_filter_tag | downcase
              for tag in product.tags
                assign t = tag | downcase
                if t == search_tag
                  assign has_tag = true
                  break
                endif
              endfor
            -%}
            {%- unless has_tag -%}
              {%- assign matches_tags = false -%}
            {%- endunless -%}
          {%- else -%}
            {%- for tag in current_tags -%}
              {%- unless product.tags contains tag -%}
                {%- assign matches_tags = false -%}
                {%- break -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if matches_tags == false -%}{%- continue -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {%- liquid
        assign is_bestseller = false
        for tag in product.tags
          assign t = tag | downcase
          if t == 'best seller' or t == 'bestseller'
            assign is_bestseller = true
            break
          endif
        endfor

        if is_bestseller == false
          for coll in product.collections
            assign c = coll.handle | downcase
            if c contains 'best-seller' or c contains 'bestseller' or c contains 'best-selling'
              assign is_bestseller = true
              break
            endif
          endfor
        endif
      -%}
      <div class="lc-product-wrapper"
           data-is-bestseller="{{ is_bestseller }}"
           data-is-available="{{ product.available }}"
           data-title="{{ product.title | escape }}">
        {% render 'trusea-product-card', product: product, section: section %}
      </div>
    {%- else -%}
      <div class="lc-coll-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d8eeff" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <p>No products found in this collection.</p>
      </div>
    {%- endfor -%}
  </div>

  <!-- ── Pagination ── -->
  {%- if paginate.pages > 1 -%}
    <div class="lc-coll-pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="lc-page-btn">← Prev</a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="lc-page-btn">{{ part.title }}</a>
        {%- else -%}
          <span class="lc-page-btn lc-page-btn--active">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="lc-page-btn">Next →</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- endpaginate -%}
</div>

<script>
// ── Priority Sort ── runs immediately to reorder products on the limited-catch page
(function() {
  const grid = document.getElementById('lc-product-grid');
  if (!grid) return;

  const cards = Array.from(grid.querySelectorAll('.lc-product-wrapper'));
  if (cards.length === 0) return;

  // Assign priority: 0 = bestseller+available, 1 = regular+available, 2 = bestseller+unavailable, 3 = regular+unavailable
  cards.sort(function(a, b) {
    function priority(el) {
      const isBestseller = el.dataset.isBestseller === 'true';
      const isAvailable  = el.dataset.isAvailable  === 'true';
      if (isAvailable  && isBestseller)  return 0;
      if (isAvailable  && !isBestseller) return 1;
      if (!isAvailable && isBestseller)  return 2;
      return 3;
    }
    return priority(a) - priority(b);
  });

  // Re-attach in sorted order
  cards.forEach(function(card) { grid.appendChild(card); });
})();

// Tag filter
function lcFilterTag(btn, tag) {
  {%- assign is_lc = false -%}
  {%- if collection.handle == 'limited-catch' -%}{%- assign is_lc = true -%}{%- endif -%}
  const isLimitedCatch = {{ is_lc | json }};
  if (isLimitedCatch) {
    const url = new URL(window.location.href);
    url.searchParams.set('tag', tag);
    window.location.href = url.toString();
  } else {
    window.location.href = '{{ collection.url }}/' + tag;
  }
}

function lcFilterAll(btn) {
  {%- assign is_lc = false -%}
  {%- if collection.handle == 'limited-catch' -%}{%- assign is_lc = true -%}{%- endif -%}
  const isLimitedCatch = {{ is_lc | json }};
  if (isLimitedCatch) {
    const url = new URL(window.location.href);
    url.searchParams.delete('tag');
    window.location.href = url.toString();
  } else {
    window.location.href = '{{ collection.url }}';
  }
}
</script>

{% schema %}
{
  "name": "TruSea Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Card Ribbon Badge",
      "default": "Best Seller"
    },
    {
      "type": "text",
      "id": "image_ratio",
      "label": "Image Ratio (e.g. 100%, 75%, 65%)",
      "default": "75%"
    },
    {
      "type": "range",
      "id": "slider_interval",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "label": "Carousel Interval (seconds)"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "label": "Show Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_weight",
      "label": "Show Net Weight",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show Discount Badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show Delivery Badge",
      "default": true
    }
  ],
  "presets": [
    { "name": "TruSea Collection Grid" }
  ]
}
{% endschema %}
