<script>
(function() {
  // Search overlay
  const searchTrigger = document.getElementById('ts-search-trigger');
  const searchOverlay = document.getElementById('ts-search-overlay');
  const searchClose   = document.getElementById('ts-search-close');
  const searchInput   = document.getElementById('ts-search-input');

  if (searchTrigger) {
    searchTrigger.addEventListener('click', () => {
      searchOverlay.classList.add('open');
      setTimeout(() => searchInput.focus(), 100);
    });
  }
  if (searchClose) {
    searchClose.addEventListener('click', () => searchOverlay.classList.remove('open'));
  }
  if (searchOverlay) {
    searchOverlay.addEventListener('click', (e) => {
      if (e.target === searchOverlay) searchOverlay.classList.remove('open');
    });
  }

  // ── Location dropdown ──────────────────────────────────────────
  const locBtn      = document.getElementById('ts-location-btn');
  const locDropdown = document.getElementById('ts-location-dropdown');
  const locLabel    = document.getElementById('ts-location-label');

  function setLocation(label, pincode) {
    const displayText = pincode ? pincode + ' · ' + label : label;
    if (locLabel) locLabel.textContent = displayText;
    localStorage.setItem('ts_location_label', label);
    localStorage.setItem('ts_location_pincode', pincode || '');
    localStorage.setItem('ts_location', label);
    if (locDropdown) {
      locDropdown.classList.remove('open');
      locBtn && locBtn.setAttribute('aria-expanded', 'false');
    }
    document.querySelectorAll('.ts-location-option').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.label === label);
    });
  }

  if (locBtn && locDropdown) {
    locBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = locDropdown.classList.toggle('open');
      locBtn.setAttribute('aria-expanded', open);
      locDropdown.setAttribute('aria-hidden', !open);
    });
    document.addEventListener('click', (e) => {
      if (!locBtn.contains(e.target) && !locDropdown.contains(e.target)) {
        locDropdown.classList.remove('open');
        locBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Pre-fill saved location on page load
  const savedLabel   = localStorage.getItem('ts_location_label');
  const savedPincode = localStorage.getItem('ts_location_pincode');
  if (savedLabel && locLabel) {
    const displayText = savedPincode ? savedPincode + ' · ' + savedLabel : savedLabel;
    locLabel.textContent = displayText;
    document.querySelectorAll('.ts-location-option').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.label === savedLabel);
    });
  } else {
    const legacy = localStorage.getItem('ts_location');
    if (legacy && locLabel) locLabel.textContent = legacy;
  }

  // Location list – click on area name shortcuts
  document.querySelectorAll('.ts-location-option').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const label = e.currentTarget.dataset.label;
      const pin   = e.currentTarget.dataset.pincode;
      // Also pre-fill Zippy's input if present
      const zippyInput = document.querySelector('#ts-zippy-wrapper input.pin');
      if (zippyInput) {
        zippyInput.value = pin;
        const checkBtn = document.querySelector('#ts-zippy-wrapper button.checkPin');
        if (checkBtn) checkBtn.click();
      } else {
        setLocation(label, pin);
      }
    });
  });

  // ── Watch Zippy success card to update header label ──────────────
  const zippyWrapper = document.getElementById('ts-zippy-wrapper');
  if (zippyWrapper) {
    const observer = new MutationObserver(() => {
      // Zippy renders a success card with the pincode
      const successCard = zippyWrapper.querySelector('[class*="zippy-success-card"], [class*="zippy_success"]');
      if (successCard) {
        // Extract pincode: Zippy shows text like "DELIVER TO 600042"
        const text = successCard.textContent || '';
        const pincodeMatch = text.match(/\b(\d{6})\b/);
        if (pincodeMatch) {
          const pin = pincodeMatch[1];
          // Find matching area name from shortcuts
          let label = pin;
          document.querySelectorAll('.ts-location-option').forEach(btn => {
            if (btn.dataset.pincode === pin) label = btn.dataset.label;
          });
          setLocation(label, pin);
        }
      }
    });
    observer.observe(zippyWrapper, { childList: true, subtree: true, characterData: true });
  }

  // Mobile drawer
  const hamburger = document.getElementById('ts-hamburger');
  const drawer    = document.getElementById('ts-mobile-drawer');
  const backdrop  = document.getElementById('ts-drawer-backdrop');
  const drawerClose = document.getElementById('ts-drawer-close');

  function openDrawer() {
    drawer.classList.add('open');
    backdrop.classList.add('open');
    hamburger.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer.classList.remove('open');
    backdrop.classList.remove('open');
    hamburger.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (hamburger) hamburger.addEventListener('click', openDrawer);
  if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
  if (backdrop) backdrop.addEventListener('click', closeDrawer);

  // =============================================
  // MINI-CART POPUP
  // =============================================
  const cartTrigger    = document.getElementById('ts-cart-trigger');
  const minicart       = document.getElementById('ts-minicart');
  const minicartClose  = document.getElementById('ts-minicart-close');
  const minicartBd     = document.getElementById('ts-minicart-backdrop');
  const minicartBody   = document.getElementById('ts-minicart-body');
  const minicartFooter = document.getElementById('ts-minicart-footer');
  const minicartEmpty  = document.getElementById('ts-minicart-empty');
  const minicartCount  = document.getElementById('ts-minicart-count');
  const minicartTotal  = document.getElementById('ts-minicart-total');
  const minicartBadge  = document.getElementById('ts-cart-badge');
  const minicartLoading= document.getElementById('ts-minicart-loading');

  let cartData = null;

  // Format money (paise to rupees)
  function formatMoney(cents) {
    return '\u20B9' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Update header badge count
  function updateBadge(count) {
    if (!minicartBadge) return;
    minicartBadge.textContent = count;
    minicartBadge.style.display = count > 0 ? 'flex' : 'none';
  }

  // Render cart items into the panel
  function renderCart(data) {
    cartData = data;
    document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
    const itemCount = data.item_count || 0;

    // Update count badge
    if (minicartCount) minicartCount.textContent = itemCount;
    updateBadge(itemCount);

    // Hide loading
    if (minicartLoading) minicartLoading.style.display = 'none';

    // Clear previous items (keep loading / empty / footer)
    minicartBody.querySelectorAll('.ts-minicart-item').forEach(el => el.remove());

    if (itemCount === 0) {
      if (minicartEmpty) minicartEmpty.style.display = 'flex';
      if (minicartFooter) minicartFooter.style.display = 'none';
      return;
    }

    if (minicartEmpty) minicartEmpty.style.display = 'none';
    if (minicartFooter) minicartFooter.style.display = 'block';
    if (minicartTotal) minicartTotal.textContent = formatMoney(data.total_price);

    // Build item elements
    const frag = document.createDocumentFragment();
    (data.items || []).forEach(item => {
      const div = document.createElement('div');
      div.className = 'ts-minicart-item';
      div.dataset.key = item.key;
      div.innerHTML = `
        ${item.image
          ? `<img src="${item.image.replace('_grande', '_medium')}" alt="${item.product_title}" class="ts-minicart-img" loading="lazy">`
          : `<div class="ts-minicart-img-placeholder"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(60,191,160,.5)" stroke-width="1.5"><path d="M3 12s3-8 9-8 9 8 9 8-3 8-9 8-9-8-9-8z"/><circle cx="12" cy="12" r="3"/></svg></div>`
        }
        <div class="ts-minicart-item-info">
          <p class="ts-minicart-item-title">${item.product_title}</p>
          ${item.variant_title && item.variant_title !== 'Default Title' ? `<p class="ts-minicart-item-variant">${item.variant_title}</p>` : ''}
          <div class="ts-minicart-item-row">
            <div class="ts-qty-stepper" data-key="${item.key}">
              <button type="button" class="ts-qty-btn ts-qty-minus" aria-label="Decrease quantity">&minus;</button>
              <span class="ts-qty-val">${item.quantity}</span>
              <button type="button" class="ts-qty-btn ts-qty-plus" aria-label="Increase quantity">+</button>
            </div>
            <span class="ts-minicart-item-price">${formatMoney(item.final_line_price)}</span>
          </div>
        </div>
        <button type="button" class="ts-minicart-remove" data-key="${item.key}" aria-label="Remove ${item.product_title}">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      `;
      frag.appendChild(div);
    });
    minicartBody.prepend(frag);

    // Bind qty buttons
    minicartBody.querySelectorAll('.ts-qty-stepper').forEach(stepper => {
      const key = stepper.dataset.key;
      const valEl = stepper.querySelector('.ts-qty-val');
      stepper.querySelector('.ts-qty-minus').addEventListener('click', () => {
        const current = parseInt(valEl.textContent, 10);
        updateLineItem(key, Math.max(0, current - 1));
      });
      stepper.querySelector('.ts-qty-plus').addEventListener('click', () => {
        const current = parseInt(valEl.textContent, 10);
        updateLineItem(key, current + 1);
      });
    });

    // Bind remove buttons
    minicartBody.querySelectorAll('.ts-minicart-remove').forEach(btn => {
      btn.addEventListener('click', () => updateLineItem(btn.dataset.key, 0));
    });
  }

  // Fetch cart and render
  function fetchCart() {
    if (minicartLoading) minicartLoading.style.display = 'flex';
    fetch('/cart.js', { credentials: 'same-origin' })
      .then(r => r.json())
      .then(renderCart)
      .catch(() => {
        if (minicartLoading) minicartLoading.style.display = 'none';
      });
  }

  // Update line item quantity via AJAX
  function updateLineItem(key, quantity) {
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ updates: { [key]: quantity } })
    })
    .then(r => r.json())
    .then(data => {
      if (data.status && data.message) {
        console.error('Shopify Cart API Error:', data);
        return fetchCart(); // Recover by fetching fresh state
      }
      renderCart(data);
    })
    .catch(err => {
      console.error(err);
      fetchCart();
    });
  }

  // Open mini-cart
  function openMiniCart() {
    minicart.classList.add('open');
    document.body.classList.add('cart-drawer-open');
    cartTrigger.setAttribute('aria-expanded', 'true');
    fetchCart();
  }

  // Close mini-cart
  function closeMiniCart() {
    minicart.classList.remove('open');
    document.body.classList.remove('cart-drawer-open');
    cartTrigger.setAttribute('aria-expanded', 'false');
  }

  if (cartTrigger) cartTrigger.addEventListener('click', openMiniCart);
  if (minicartClose) minicartClose.addEventListener('click', closeMiniCart);
  if (minicartBd) minicartBd.addEventListener('click', closeMiniCart);
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && minicart.classList.contains('open')) closeMiniCart(); });

  // ---- Toast notification when item added to cart ----
  // Create toast element
  const toast = document.createElement('div');
  toast.className = 'ts-cart-toast';
  toast.setAttribute('role', 'status');
  toast.setAttribute('aria-live', 'polite');
  toast.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span id="ts-toast-msg">Added to cart!</span>`;
  document.body.appendChild(toast);

  function showToast(msg) {
    document.getElementById('ts-toast-msg').textContent = msg || 'Added to cart!';
    toast.classList.add('show');
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => toast.classList.remove('show'), 3000);
  }

  // Intercept Shopify add-to-cart forms / fetch so we can auto-open mini-cart
  // Hook into the global fetch to detect /cart/add.js calls
  const _origFetch = window.fetch;
  window.fetch = function(input, init) {
    const url = typeof input === 'string' ? input : (input && input.url) || '';
    if (url.indexOf('/cart/add') !== -1) {
      return _origFetch.apply(this, arguments).then(response => {
        // Clone so caller can still read it
        const clone = response.clone();
        clone.json().then(data => {
          if (data && data.title) {
            // Refresh badge
            fetch('/cart.js').then(r => r.json()).then(cart => {
              updateBadge(cart.item_count);
              showToast(data.title + ' added!');
              openMiniCart();
            });
          }
        }).catch(() => {});
        return response;
      });
    }
    return _origFetch.apply(this, arguments);
  };

})();

// Traditional Fixed Header via JS
document.addEventListener('DOMContentLoaded', () => {
  {% if section.settings.sticky %}
    const header = document.getElementById('ts-header');
    if (!header) return;
    
    // Ghost element to prevent layout jump
    const placeholder = document.createElement('div');
    placeholder.style.display = 'none';
    header.parentNode.insertBefore(placeholder, header);
    
    // Check original position
    const offset = header.offsetTop || 0;

    window.addEventListener('scroll', () => {
      if (window.scrollY > offset + 30) {
        if (!header.classList.contains('ts-is-fixed')) {
          placeholder.style.height = header.offsetHeight + 'px';
          placeholder.style.display = 'block';
          header.classList.add('ts-is-fixed');
        }
      } else {
        if (header.classList.contains('ts-is-fixed')) {
          header.classList.remove('ts-is-fixed');
          placeholder.style.display = 'none';
        }
      }
    });
  {% endif %}
});
</script>

