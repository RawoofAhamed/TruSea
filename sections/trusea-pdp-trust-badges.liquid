<div class="beauty-trust-badges page-width">
  <div class="beauty-trust-item">
    <div class="beauty-trust-icon">
      <!-- Fast Delivery / Shipping Icon -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M21 16V8C21 6.89543 20.1046 6 19 6H5C3.89543 6 3 6.89543 3 8V16C3 17.1046 3.89543 18 5 18H19C20.1046 18 21 17.1046 21 16Z" stroke="#B8860B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M3 10H21" stroke="#B8860B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M7 14H11" stroke="#B8860B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="beauty-trust-text">
      <h4>Free Shipping</h4>
      <p>Free shipping for orders over $50</p>
    </div>
  </div>

  <div class="beauty-trust-item">
    <div class="beauty-trust-icon">
      <!-- Flexible Payment Icon -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="2" y="5" width="20" height="14" rx="2" stroke="#B8860B" stroke-width="2"/>
        <path d="M2 10H22" stroke="#B8860B" stroke-width="2"/>
      </svg>
    </div>
    <div class="beauty-trust-text">
      <h4>Flexible Payment</h4>
      <p>Multiple secure payment options</p>
    </div>
  </div>

  <div class="beauty-trust-item">
    <div class="beauty-trust-icon">
      <!-- 24x7 Support Icon -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 13.5997 2.37562 15.1116 3.04346 16.4525C3.22094 16.8088 3.28001 17.2161 3.17712 17.6006L2.58151 19.8267C2.32295 20.793 3.20701 21.677 4.17335 21.4185L6.39939 20.8229C6.78393 20.72 7.19121 20.7791 7.54753 20.9565C8.88837 21.6244 10.4003 22 12 22Z" stroke="#B8860B" stroke-width="2" stroke-linejoin="round"/>
        <path d="M9 12H9.01" stroke="#B8860B" stroke-width="3" stroke-linecap="round"/>
        <path d="M15 12H15.01" stroke="#B8860B" stroke-width="3" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="beauty-trust-text">
      <h4>24x7 Support</h4>
      <p>We support online all days</p>
    </div>
  </div>
</div>

<style>
  .beauty-trust-badges {
    display: flex;
    justify-content: space-around;
    padding: 60px 0;
    margin-top: 20px;
    margin-bottom: 40px;
    border-bottom: 1px solid #f3f4f6;
    flex-wrap: wrap;
    gap: 20px;
  }
  .beauty-trust-item {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    min-width: 250px;
    justify-content: center;
  }
  .beauty-trust-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #FFFAF0; /* subtle gold tint */
    border: 1px solid rgba(184, 134, 11, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .beauty-trust-text h4 {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 700;
    color: #1f2937;
  }
  .beauty-trust-text p {
    margin: 0;
    font-size: 14px;
    color: #6b7280;
  }
  
  @media (max-width: 768px) {
    .beauty-trust-item {
      justify-content: flex-start;
      margin-left: 10%;
    }
  }
</style>

