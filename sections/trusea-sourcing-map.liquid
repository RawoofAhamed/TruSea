{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section %}
<section class="ts-map-section ts-section" id="ts-map-section"
  style="--ts-map-bg: {{ section.settings.bg_color | default: '#F8FAFC' }};"
>
  <!-- Decorative Assets -->
  <div class="ts-container" style="position: relative; z-index: 2;">
    <div class="ts-map-header">
      <h2 class="ts-map-heading">{{ section.settings.heading | default: 'Where Your Seafood Comes From' }}</h2>
      <p class="ts-map-sub">{{ section.settings.subtext | default: 'We source directly from 15+ major hubs along the coast, ensuring the shortest sea-to-plate time.' }}</p>
    </div>

    <div class="ts-map-outer">
      <div class="ts-map-wrapper">
        <div class="ts-map-scan-layer"></div>
        <!-- Main Map Image -->
        <img src="{{ 'map.png' | asset_url }}" alt="TruSea Sourcing Map" class="ts-map-image">
        
        <!-- Precision Overlapping Decors -->
        <div class="ts-map-deco ts-map-deco--crab" data-parallax="0.15">
          <img src="{{ 'crab.png' | asset_url }}" alt="Crab" width="90">
        </div>
        <div class="ts-map-deco ts-map-deco--fish" data-parallax="0.1">
          <img src="{{ 'Fish (1).png' | asset_url }}" alt="Fish" width="100">
        </div>
        <div class="ts-map-deco ts-map-deco--lobster" data-parallax="0.12">
          <img src="{{ 'lobster.png' | asset_url }}" alt="Lobster" width="110">
        </div>
        <div class="ts-map-deco ts-map-deco--prawn" data-parallax="0.2">
          <img src="{{ 'prawn.png' | asset_url }}" alt="Prawn" width="60">
        </div>
        <div class="ts-map-deco ts-map-deco--fish-r" data-parallax="0.15">
          <img src="{{ 'Fish (2).png' | asset_url }}" alt="Fish" width="150">
        </div>
      </div>
      <div class="ts-map-legend">
        <div class="ts-legend-item">
          <span class="ts-dot-live"></span>
          <span>Live Sourcing Hub</span>
        </div>
        <div class="ts-legend-item">
          <span>Eco-friendly catch methods</span>
        </div>
      </div>
    </div>
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-map-section {
  background: var(--ts-map-bg);
  padding: 100px 0;
  position: relative;
  overflow: visible !important;
}

.ts-map-header {
  text-align: center;
  margin-bottom: 60px;
}
.ts-map-heading {
  font-size: clamp(30px, 4vw, 42px);
  font-weight: 900;
  color: var(--ts-navy);
  margin-bottom: 16px;
}
.ts-map-sub {
  color: var(--ts-gray);
  max-width: 600px;
  margin: 0 auto;
}

.ts-map-outer {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ts-map-wrapper {
  position: relative;
  width: 100%;
  max-width: 1200px;
  background: white;
  min-height: 400px;
  border-radius: 40px;
  box-shadow: 0 40px 100px rgba(14,37,65,0.08);
  border: 1px solid rgba(14,37,65,0.03);
  overflow: visible; /* Allow decors to overlap */
  line-height: 0;
}

.ts-map-scan-layer {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: 40px;
  pointer-events: none;
  z-index: 5;
}

.ts-map-scan-layer::after {
  content: '';
  position: absolute;
  top: -100%;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, transparent, rgba(60, 191, 160, 0.1), transparent);
  animation: ts-map-scan 8s linear infinite;
}

@keyframes ts-map-scan {
  0% { top: -100%; }
  100% { top: 100%; }
}

.ts-map-image {
  width: 100%;
  height: auto;
  display: block;
  z-index: 1;
  border-radius: 40px;
}

/* Overlapping Decors */
.ts-map-deco {
  position: absolute;
  pointer-events: none;
  z-index: 10;
  transition: transform 0.3s ease;
}
.ts-map-deco img {
  filter: drop-shadow(0 10px 20px rgba(0,0,0,0.2));
  animation: ts-float 6s ease-in-out infinite;
}

.ts-map-deco--crab { top: 12%; left: 0; transform: translate(-50%, -50%); }
.ts-map-deco--fish { bottom: 18%; left: 0; transform: translate(-50%, 50%); }
.ts-map-deco--lobster { top: 8%; right: -20px; transform: translate(50%, -50%); }
.ts-map-deco--prawn { bottom: 12%; right: -10px; transform: translate(50%, 50%); }
.ts-map-deco--fish-r { top: 50%; right: 0; transform: translate(50%, -50%); }

@media (max-width: 900px) {
  .ts-map-deco img { width: 60px; height: auto; }
}

/* Hub Pins */
.ts-map-hubs {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.ts-map-pin {
  position: absolute;
  width: 20px;
  height: 20px;
  transform: translate(-50%, -50%);
  cursor: pointer;
  pointer-events: auto;
  z-index: 10;
}

.ts-pin-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 6px;
  height: 6px;
  background: var(--ts-mint);
  border-radius: 50%;
  z-index: 2;
  transition: all 0.3s ease;
  box-shadow: 0 0 15px var(--ts-mint);
}

.ts-map-pin:hover .ts-pin-dot {
  transform: translate(-50%, -50%) scale(2);
  background: var(--ts-white);
  box-shadow: 0 0 20px var(--ts-mint), 0 0 40px var(--ts-mint);
}

.ts-pin-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20px;
  height: 20px;
  background: rgba(60, 191, 160, 0.4);
  border-radius: 50%;
  animation: ts-pin-ripple 2s infinite;
  pointer-events: none;
}

@keyframes ts-pin-ripple {
  0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0.8; }
  100% { transform: translate(-50%, -50%) scale(3); opacity: 0; }
}

.ts-map-pin:hover .ts-pin-dot {
  transform: translate(-50%, -50%) scale(1.5);
  background: var(--ts-navy);
}

/* Popups */
.ts-map-popup {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: var(--ts-navy);
  color: white;
  padding: 12px 16px;
  border-radius: 12px;
  width: 180px;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  text-align: left;
  line-height: normal;
}
.ts-map-popup::after {
  content: '';
  position: absolute;
  bottom: -6px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 12px;
  height: 12px;
  background: var(--ts-navy);
}

.ts-map-pin:hover .ts-map-popup {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.ts-map-pin.active .ts-map-popup {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.ts-map-popup h4 { margin: 0 0 4px; font-size: 14px; color: var(--ts-mint); }
.ts-map-popup p { margin: 0 0 4px; font-size: 12px; opacity: 0.8; }
.ts-map-popup span { font-size: 10px; font-weight: 700; color: var(--ts-mint); text-transform: uppercase; }

.ts-map-legend {
  display: flex;
  gap: 32px;
  margin-top: 40px;
}
.ts-legend-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 600;
  color: var(--ts-navy);
}
.ts-deco--crab-map { top: 20%; left: -30px; animation: ts-pop-in 1.5s ease-out, ts-float 8s ease-in-out infinite 1.5s; }
.ts-deco--fish-map-l { bottom: 15%; left: -40px; animation: ts-pop-in 1.8s ease-out, ts-float-alt 7s ease-in-out infinite 1.8s; }
.ts-deco--lobster-map-r { top: 15%; right: -50px; animation: ts-pop-in-right 1.3s ease-out, ts-float-alt 9s ease-in-out infinite 1.3s; }
.ts-deco--prawn-map-r { bottom: 25%; right: -30px; animation: ts-pop-in-right 1.6s ease-out, ts-float 10s ease-in-out infinite 1.6s; }

@media (max-width: 900px) {
  .ts-deco--crab-map, .ts-deco--fish-map-l, .ts-deco--lobster-map-r, .ts-deco--prawn-map-r { transform: scale(0.6); }
  .ts-deco--crab-map { left: -10px; }
  .ts-deco--lobster-map-r { right: -10px; }
}
.ts-dot-live {
  width: 10px;
  height: 10px;
  background: var(--ts-navy);
  border-radius: 50%;
  animation: ts-fade-in 1s infinite alternate;
}

@media (max-width: 768px) {
  .ts-map-wrapper { border-radius: 20px; }
  .ts-map-legend { flex-direction: column; gap: 16px; align-items: center; }
}
</style>

<script>
(function() {
  // Reveal animation logic handled by global observer if needed
})();
</script>

{% schema %}
{
  "name": "Sourcing Map",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show", "default": true },
    { "type": "color", "id": "bg_color", "label": "BG", "default": "#F8FAFC" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where Your Seafood Comes From" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "We source directly from 15+ major hubs along the coast." }
  ],
  "presets": [
    {
      "name": "Sourcing Map"
    }
  ]
}
{% endschema %}
