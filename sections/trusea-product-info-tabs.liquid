{% assign protein = product.metafields.custom.protein | default: "14.4 g" %}
{% assign energy = "78 kcal" %}
{% assign total_fat = "1.4 g" %}
{% assign carbs = "0 g" %}

<section class="beauty-pdp-tabs" id="beauty-pdp-tabs-{{ section.id }}">
  <div class="page-width">
    <!-- Tab Navigation -->
    <div class="beauty-tabs-nav" role="tablist">
      <button class="beauty-tab-btn is-active" type="button" role="tab" data-target="description">Description</button>
      <button class="beauty-tab-btn" type="button" role="tab" data-target="additional">Additional Information</button>
      <button class="beauty-tab-btn" type="button" role="tab" data-target="reviews">Review</button>
    </div>

    <!-- Tab Panels -->
    <div class="beauty-tabs-panels">
      
      <!-- Description Tab -->
      <div class="beauty-tab-panel is-active" id="panel-description" role="tabpanel">
        <div class="beauty-description-content">
          {% if product.description != blank %}
            {{ product.description }}
          {% else %}
            <p><strong>{{ product.title }}</strong>: Freshly prepared into clean cuts with natural ocean flavour. Firm texture, mildly savoury taste and versatile for grills, fries or rich curries. Built for flavour lovers and quick weekday cooking.</p>
            <p><strong>Nutritional Information (Per 100g)</strong><br>
            Energy: {{ energy }}<br>
            Protein: {{ protein }}<br>
            Total Fat: {{ total_fat }}<br>
            Carbohydrates: {{ carbs }}</p>
          {% endif %}
        </div>
      </div>

      <!-- Additional Information Tab -->
      <div class="beauty-tab-panel" id="panel-additional" role="tabpanel">
        <table class="beauty-attributes-table">
          <thead>
            <tr>
              <th>Attribute</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Skin Type</td>
              <td>Normal, Oily, Dry, Combination, Sensitive skin</td>
            </tr>
            <tr>
              <td>Size/Volume</td>
              <td>30 ml, 60 ml, 80 ml, 100 ml</td>
            </tr>
            <tr>
              <td>Shelf Life</td>
              <td>24 months</td>
            </tr>
            <tr>
              <td>Application Time</td>
              <td>Morning and Evening</td>
            </tr>
            <tr>
              <td>Packaging</td>
              <td>Recyclable Glass Bottle</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Review Tab -->
      <div class="beauty-tab-panel" id="panel-reviews" role="tabpanel">
        <div id="beauty-review-container">
           <div class="beauty-review-placeholder">
             <p>No reviews yet. Be the first to write a review!</p>
           </div>
        </div>
      </div>

    </div>
  </div>

  <style>
    .beauty-pdp-tabs {
      padding: 60px 0;
      background: #ffffff;
      font-family: inherit;
    }
    
    /* Nav */
    .beauty-tabs-nav {
      display: flex;
      justify-content: center;
      gap: 50px;
      margin-bottom: 40px;
    }

    .beauty-tab-btn {
      background: none;
      border: none;
      font-size: 16px;
      font-weight: 700;
      color: #9ca3af;
      padding: 10px 0;
      cursor: pointer;
      position: relative;
      transition: color 0.2s ease;
    }

    .beauty-tab-btn:hover {
      color: #1B4332;
    }

    .beauty-tab-btn.is-active {
      color: #1B4332;
    }

    .beauty-tab-btn::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      width: 100%;
      height: 3px;
      background: #1B4332;
      transform: scaleX(0);
      transition: transform 0.3s ease;
    }

    .beauty-tab-btn.is-active::after {
      transform: scaleX(1);
    }

    /* Panels */
    .beauty-tab-panel {
      display: none;
      animation: fadeIn 0.4s ease;
    }
    
    .beauty-tab-panel.is-active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .beauty-description-content {
      color: #4b5563;
      line-height: 1.8;
      font-size: 14px;
      max-width: 900px;
      margin: 0 auto;
    }

    /* Table for Additional Info */
    .beauty-attributes-table {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      border-collapse: collapse;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #f3f4f6;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    
    .beauty-attributes-table thead {
      background: #1B4332;
      color: #fff;
    }
    
    .beauty-attributes-table th,
    .beauty-attributes-table td {
      padding: 16px 24px;
      text-align: left;
      font-size: 14px;
    }
    
    .beauty-attributes-table th {
      font-weight: 600;
    }
    
    .beauty-attributes-table tbody tr {
      background: #fff;
      border-bottom: 1px solid #f3f4f6;
    }
    
    .beauty-attributes-table tbody tr:nth-child(even) {
      background: #f9fafb;
    }
    
    .beauty-attributes-table tbody td:first-child {
      font-weight: 600;
      color: #1f2937;
      width: 30%;
      border-right: 1px solid #f3f4f6;
    }
    
    .beauty-attributes-table tbody td:last-child {
      color: #4b5563;
    }

    .beauty-review-placeholder {
      text-align: center;
      padding: 40px;
      color: #6b7280;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.beauty-tab-btn');
      const panels = document.querySelectorAll('.beauty-tab-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('is-active'));
          panels.forEach(p => p.classList.remove('is-active'));

          tab.classList.add('is-active');
          const target = tab.getAttribute('data-target');
          document.getElementById('panel-' + target).classList.add('is-active');
        });
      });

      // Move JDGM Review Widget into the Review Tab automatically if it exists on page
      setTimeout(() => {
        const jdgmWidget = document.querySelector('.jdgm-review-widget');
        const reviewContainer = document.getElementById('beauty-review-container');
        if (jdgmWidget && reviewContainer) {
          reviewContainer.innerHTML = '';
          reviewContainer.appendChild(jdgmWidget);
        }
      }, 500);
    });
  </script>
</section>

{% schema %}
{
  "name": "Beauty Tabs Redesign",
  "settings": [],
  "presets": [
    { "name": "Beauty Tabs Redesign" }
  ]
}
{% endschema %}