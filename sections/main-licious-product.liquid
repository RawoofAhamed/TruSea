</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Simple gallery slider
  const dots = document.querySelectorAll('.lc-gallery__dot');
  const thumbs = document.querySelectorAll('.lc-gallery__thumb');
  const slides = document.querySelectorAll('.lc-gallery__slide');
  
  function switchSlide(index) {
    if (slides[index]) {
      slides.forEach(s => s.classList.remove('active'));
      if (dots.length) dots.forEach(d => d.classList.remove('active'));
      if (thumbs.length) {
        thumbs.forEach(t => t.classList.remove('active'));
        thumbs[index].classList.add('active');
        // Scroll active thumbnail into center of carousel
        thumbs[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
      
      slides[index].classList.add('active');
      if (dots[index]) dots[index].classList.add('active');
    }
  }

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => switchSlide(index));
  });

  thumbs.forEach((thumb, index) => {
    thumb.addEventListener('click', () => switchSlide(index));
  });

  // Thumbnail Carousel Scroll
  const thumbContainer = document.querySelector('.lc-gallery__thumbs');
  const thumbPrev = document.querySelector('.lc-gallery__thumbs-nav.lc-prev');
  const thumbNext = document.querySelector('.lc-gallery__thumbs-nav.lc-next');

  if (thumbContainer && thumbPrev && thumbNext) {
    thumbPrev.addEventListener('click', () => {
      thumbContainer.scrollBy({ left: -thumbContainer.offsetWidth / 2, behavior: 'smooth' });
    });
    thumbNext.addEventListener('click', () => {
      thumbContainer.scrollBy({ left: thumbContainer.offsetWidth / 2, behavior: 'smooth' });
    });
  }

  // Quantity control
  const btnMinus = document.querySelector('.js-lc-minus');
  const btnPlus = document.querySelector('.js-lc-plus');
  const qtyVal = document.querySelector('.lc-pdp-qty__val');

  if(btnMinus && btnPlus && qtyVal) {
    btnMinus.addEventListener('click', () => {
      let v = parseInt(qtyVal.value);
      if(v > 1) qtyVal.value = v - 1;
    });
    btnPlus.addEventListener('click', () => {
      let v = parseInt(qtyVal.value);
      qtyVal.value = v + 1;
    });
  }

  // Variant change logic
  const radioInputs = document.querySelectorAll('.lc-variant-radio');
  const jsonEl = document.querySelector('.lc-variants-json');
  const formIdInput = document.querySelector('form.lc-pdp-form input[name="id"]');
  if (radioInputs.length > 0 && jsonEl && formIdInput) {
    const variants = JSON.parse(jsonEl.textContent);
    radioInputs.forEach(radio => {
      radio.addEventListener('change', updateVariantInfo);
    });

    function updateVariantInfo() {
      const checkedValues = Array.from(document.querySelectorAll('.lc-variant-radio:checked')).map(el => el.value);
      const selectedVariant = variants.find(variant => {
        return variant.options.every((val, index) => val === checkedValues[index]);
      });
      if (selectedVariant) {
        formIdInput.value = selectedVariant.id;
        
        // Switch gallery image if variant has featured image
        if (selectedVariant.featured_media) {
           const mediaId = selectedVariant.featured_media.id;
           const targetSlide = document.querySelector(`.lc-gallery__slide[data-media-id="${mediaId}"]`);
           if (targetSlide) {
             const index = Array.from(slides).indexOf(targetSlide);
             if (index !== -1) switchSlide(index);
           }
        }

        const priceSale = document.querySelector('.lc-pdp-price__sale');
        if(priceSale) {
          priceSale.innerHTML = '₹' + (selectedVariant.price / 100).toFixed(2);
        }
        const priceReg = document.querySelector('.lc-pdp-price__regular');
        const priceDisc = document.querySelector('.lc-pdp-price__discount');
        if(selectedVariant.compare_at_price > selectedVariant.price) {
          if(priceReg) priceReg.innerHTML = 'MRP ₹' + (selectedVariant.compare_at_price / 100).toFixed(2);
          if(priceDisc) priceDisc.innerHTML = '(' + Math.round((selectedVariant.compare_at_price - selectedVariant.price) / selectedVariant.compare_at_price * 100) + '% off)';
          if(priceReg) priceReg.style.display = 'inline';
          if(priceDisc) priceDisc.style.display = 'inline';
        } else {
          if(priceReg) priceReg.style.display = 'none';
          if(priceDisc) priceDisc.style.display = 'none';
        }

        const addBtn = document.querySelector('.lc-pdp-add-btn');
        if(addBtn) {
          addBtn.disabled = !selectedVariant.available;
          addBtn.innerHTML = selectedVariant.available ? 'Add to Cart' : 'Sold Out';
        }

        // Update Meta Info (Weight, Pieces, Serves)
        const metaWeight = document.querySelector('.js-lc-meta-weight');
        const metaPieces = document.querySelector('.js-lc-meta-pieces');
        const metaServes = document.querySelector('.js-lc-meta-serves');

        if (metaWeight && selectedVariant.weight) metaWeight.textContent = selectedVariant.weight;
        if (metaPieces && selectedVariant.pieces) metaPieces.textContent = selectedVariant.pieces;
        if (metaServes && selectedVariant.serves) metaServes.textContent = selectedVariant.serves;
      }
    }

    // Initialize on load
    updateVariantInfo();
  }
});
</script>

