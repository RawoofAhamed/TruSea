{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% render 'whatsapp-reviews-pdp',
  id: section.id,
  reviews_data: product.metafields.custom.whatsapp_reviews.value,
  fallback_blocks: section.blocks,
  heading: section.settings.heading,
  bg_color: section.settings.bg_color
%}

{% schema %}
{
  "name": "Product WA Reviews",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F9F7"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT OUR CUSTOMERS ARE SAYING"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Fallback Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Reviewer Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer Name",
          "default": "Sarah L."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "2 Days Ago"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Title",
          "default": "AMAZING EXPERIENCE!"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Absolutely love my fish delivery! The quality was fresh and better than local markets."
        },
        {
          "type": "text",
          "id": "hashtag",
          "label": "Hashtag",
          "default": "HappyCustomer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product WhatsApp Reviews",
      "blocks": [
        { "type": "review", "settings": { "name": "Sarah L.", "text": "Absolutely love my fish delivery!" } },
        { "type": "review", "settings": { "name": "David R.", "text": "The way they cut the fish is so professional." } }
      ]
    }
  ]
}
{% endschema %}
