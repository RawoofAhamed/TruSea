{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-recipes ts-section" id="ts-recipes" 
  style="--ts-rec-bg: {{ section.settings.bg_color | default: '#F5F9F7' }};"
>
  <div class="ts-container">
    <div class="ts-rec-header ts-reveal">
      <div class="ts-rec-header-titles">
        <div class="ts-tag">{{ section.settings.eyebrow | default: 'TruSea Kitchen' }}</div>
        <h2 class="ts-rec-heading">
          <span class="ts-lang-en">{{ section.settings.heading_en | default: 'What Are You Cooking Today?' }}</span>
          <span class="ts-lang-ta" style="display:none;">{{ section.settings.heading_ta | default: 'இன்று நீங்கள் என்ன சமைக்கிறீர்கள்?' }}</span>
        </h2>
      </div>
      <div class="ts-lang-toggle">
        <button class="ts-lang-btn active" data-lang="en">EN</button>
        <button class="ts-lang-btn" data-lang="ta">தமிழ்</button>
      </div>
    </div>

    <div class="ts-rec-grid">
      {% for block in section.blocks %}
        {% if block.type == 'recipe' %}
          <div class="ts-rec-card ts-reveal ts-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="ts-rec-img-wrap">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title_en }}" loading="lazy">
              {% else %}
                <div class="ts-rec-placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ts-rec-difficulty">{{ block.settings.difficulty | default: 'Easy' }}</div>
            </div>
            <div class="ts-rec-content">
              <div class="ts-rec-meta">
                <div class="ts-rec-time">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span>{{ block.settings.time | default: '30 mins' }}</span>
                </div>
              </div>
              <h3 class="ts-rec-title">
                <span class="ts-lang-en">{{ block.settings.title_en }}</span>
                <span class="ts-lang-ta" style="display:none;">{{ block.settings.title_ta }}</span>
              </h3>
              <a href="{{ block.settings.product_url | default: '#' }}" class="ts-btn ts-btn-outline ts-rec-btn">
                <span class="ts-lang-en">Buy Ingredients</span>
                <span class="ts-lang-ta" style="display:none;">தேவையானவை வாங்க</span>
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ts-rec-footer ts-reveal">
      <a href="{{ section.settings.all_recipes_url | default: '#' }}" class="ts-rec-all-link">
        <span class="ts-lang-en">See All Recipes</span>
        <span class="ts-lang-ta" style="display:none;">அனைத்து குறிப்புகளையும் காண்க</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-recipes {
  background: var(--ts-rec-bg);
  padding: 100px 0;
}
.ts-rec-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 52px;
}
.ts-rec-heading {
  font-size: clamp(28px, 4.5vw, 42px);
  font-weight: 900;
  color: var(--ts-navy);
  margin: 12px 0 0;
  letter-spacing: -0.02em;
}
.ts-lang-toggle {
  display: flex;
  background: white;
  padding: 4px;
  border-radius: var(--ts-radius-full);
  box-shadow: var(--ts-shadow-sm);
  border: 1px solid rgba(14,37,65,0.05);
}
.ts-lang-btn {
  border: none;
  background: none;
  padding: 6px 16px;
  border-radius: var(--ts-radius-full);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  color: var(--ts-gray);
  transition: all 0.3s ease;
}
.ts-lang-btn.active {
  background: var(--ts-mint);
  color: white;
}

.ts-rec-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
.ts-rec-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 12px 32px rgba(14,37,65,0.06);
  border: 1px solid rgba(14,37,65,0.04);
  transition: transform 0.3s ease;
}
.ts-rec-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 48px rgba(14,37,65,0.12);
}
.ts-rec-img-wrap {
  position: relative;
  padding-bottom: 75%; /* 4:3 */
  overflow: hidden;
}
.ts-rec-img-wrap img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.ts-rec-card:hover .ts-rec-img-wrap img {
  transform: scale(1.08);
}
.ts-rec-difficulty {
  position: absolute;
  top: 16px;
  left: 16px;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(4px);
  padding: 4px 12px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--ts-navy);
}
.ts-rec-content {
  padding: 24px;
}
.ts-rec-meta {
  display: flex;
  gap: 16px;
  margin-bottom: 12px;
}
.ts-rec-time {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--ts-gray);
}
.ts-rec-title {
  font-size: 18px;
  font-weight: 800;
  color: var(--ts-navy);
  margin: 0 0 20px;
  line-height: 1.4;
  height: 2.8em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ts-rec-btn {
  width: 100%;
  justify-content: center;
}

.ts-rec-footer {
  margin-top: 52px;
  display: flex;
  justify-content: center;
}
.ts-rec-all-link {
  font-size: 16px;
  font-weight: 700;
  color: var(--ts-navy);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: color 0.3s ease;
}
.ts-rec-all-link:hover {
  color: var(--ts-mint);
}

@media (max-width: 900px) {
  .ts-rec-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 600px) {
  .ts-rec-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .ts-rec-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
(function() {
  const recipes = document.getElementById('ts-recipes');
  if (!recipes) return;

  const langBtns = recipes.querySelectorAll('.ts-lang-btn');
  const enTexts = recipes.querySelectorAll('.ts-lang-en');
  const taTexts = recipes.querySelectorAll('.ts-lang-ta');

  langBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang;
      langBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      if (lang === 'en') {
        enTexts.forEach(el => el.style.display = 'inline-block');
        taTexts.forEach(el => el.style.display = 'none');
      } else {
        enTexts.forEach(el => el.style.display = 'none');
        taTexts.forEach(el => el.style.display = 'inline-block');
      }
    });
  });

  // Reveal
  const recRevealEls = document.querySelectorAll('#ts-recipes .ts-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  recRevealEls.forEach(el => observer.observe(el));
})();
</script>

{% schema %}
{
  "name": "Recipe Preview",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F9F7"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "TruSea Kitchen"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Heading (English)",
      "default": "What Are You Cooking Today?"
    },
    {
      "type": "text",
      "id": "heading_ta",
      "label": "Heading (Tamil)",
      "default": "இன்று நீங்கள் என்ன சமைக்கிறீர்கள்?"
    },
    {
      "type": "url",
      "id": "all_recipes_url",
      "label": "All Recipes Link"
    }
  ],
  "blocks": [
    {
      "type": "recipe",
      "name": "Recipe",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Recipe Photo"
        },
        {
          "type": "text",
          "id": "title_en",
          "label": "Title (English)",
          "default": "Chettinad Fish Curry"
        },
        {
          "type": "text",
          "id": "title_ta",
          "label": "Title (Tamil)",
          "default": "செட்டிநாடு மீன் குழம்பு"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time (e.g. 30 mins)",
          "default": "30 mins"
        },
        {
          "type": "select",
          "id": "difficulty",
          "label": "Difficulty",
          "options": [
            { "value": "Easy", "label": "Easy" },
            { "value": "Medium", "label": "Medium" }
          ],
          "default": "Easy"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product Link (Buy Ingredients)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipe Preview",
      "blocks": [
        { "type": "recipe", "settings": { "title_en": "Chettinad Fish Curry", "title_ta": "செட்டிநாடு மீன் குழம்பு" } },
        { "type": "recipe", "settings": { "title_en": "Grilled Pomfret with Garlic Butter", "title_ta": "பூண்டு வெண்ணெய் வறுவல்" } },
        { "type": "recipe", "settings": { "title_en": "Fish Fry Masala", "title_ta": "மீன் வறுவல் மசாலா" } }
      ]
    }
  ]
}
{% endschema %}
