{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-recipes ts-section" id="ts-recipes" 
  style="--ts-rec-bg: {{ section.settings.bg_color | default: 'var(--ts-bg-secondary)' }};"
>
  <div class="ts-container">
    <div class="ts-rec-header ts-reveal">
      <div class="ts-rec-header-titles">
        <div class="ts-tag">{{ section.settings.eyebrow | default: 'TruSea Kitchen' }}</div>
        <h2 class="ts-rec-heading">
          {{ section.settings.heading_en | default: 'What Are You Cooking Today?' }}
        </h2>
      </div>
      <div class="ts-rec-nav no-mobile">
        <button class="ts-scroll-btn ts-scroll-prev" aria-label="Previous">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        </button>
        <button class="ts-scroll-btn ts-scroll-next" aria-label="Next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>
    </div>

    <div class="ts-rec-scroll-container">
      <div class="ts-rec-grid scroll-x">
        {% for block in section.blocks %}
          {% if block.type == 'recipe_article' %}
            {% assign article = block.settings.article %}
            {% if article != blank %}
              {%- assign hero_image = article.metafields.custom.recipe_banner.value | default: article.image -%}
              {%- assign prep_time = article.metafields.custom.recipe_prep_time.value -%}
              {%- assign cook_time = article.metafields.custom.recipe_cook_time.value -%}
              
              <div class="ts-rec-card ts-reveal ts-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
                <a href="{{ article.url }}" class="ts-rec-card-link">
                  <div class="ts-rec-img-wrap">
                    {% if hero_image != blank %}
                      <img src="{{ hero_image | image_url: width: 600 }}" alt="{{ article.title }}" loading="lazy">
                    {% else %}
                      <div class="ts-rec-placeholder">
                        {{ 'image' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                    
                    <div class="ts-rec-times">
                      {% if prep_time != blank %}
                        <div class="ts-rec-time-badge">
                          <span class="label">Prep</span>
                          <span class="val">{{ prep_time }}</span>
                        </div>
                      {% endif %}
                      {% if cook_time != blank %}
                        <div class="ts-rec-time-badge">
                          <span class="label">Cook</span>
                          <span class="val">{{ cook_time }}</span>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                  
                  <div class="ts-rec-content">
                    <h3 class="ts-rec-title">{{ article.title }}</h3>
                    <div class="ts-rec-footer-cta">
                      <span class="ts-text-link">View Recipe</span>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                    </div>
                  </div>
                </a>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ts-rec-footer ts-reveal">
      <a href="{{ section.settings.all_recipes_url | default: '/blogs/news' }}" class="ts-rec-all-link">
        <span>See All Recipes</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-recipes {
  background: var(--ts-rec-bg);
  padding: 100px 0;
  overflow: hidden;
}

.ts-rec-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 52px;
}

.ts-rec-heading {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 900;
  color: var(--ts-text-heading);
  margin: 12px 0 0;
  letter-spacing: -0.03em;
}

.ts-rec-nav {
  display: flex;
  gap: 12px;
}

.ts-scroll-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid var(--ts-border);
  background: var(--ts-bg-card);
  color: var(--ts-text-heading);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.ts-scroll-btn:hover {
  background: var(--ts-mint);
  color: white;
  border-color: var(--ts-mint);
  transform: translateY(-2px);
}

.ts-rec-scroll-container {
  margin: 0 -20px;
  padding: 0 20px;
  overflow: visible;
}

.ts-rec-grid.scroll-x {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding: 10px 20px 40px;
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.ts-rec-grid.scroll-x::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.ts-rec-card {
  flex: 0 0 calc(33.333% - 14px);
  min-width: 300px;
  scroll-snap-align: start;
  background: var(--ts-bg-card);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: var(--ts-shadow-md);
  border: 1px solid var(--ts-border);
  transition: all 0.4s cubic-bezier(0.2, 0, 0.2, 1);
}

.ts-rec-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 30px 60px rgba(14,37,65,0.12);
}

.ts-rec-card-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.ts-rec-img-wrap {
  position: relative;
  padding-bottom: 70%;
  overflow: hidden;
}

.ts-rec-img-wrap img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.ts-rec-card:hover .ts-rec-img-wrap img {
  transform: scale(1.08);
}

.ts-rec-times {
  position: absolute;
  bottom: 16px;
  left: 16px;
  display: flex;
  gap: 8px;
}

.ts-rec-time-badge {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  padding: 6px 12px;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.ts-rec-time-badge .label {
  font-size: 8px;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--ts-mint);
  margin-bottom: 2px;
}

.ts-rec-time-badge .val {
  font-size: 13px;
  font-weight: 800;
  color: var(--ts-navy-dark); /* Keep dark for light badges or make it theme aware */
}

.ts-rec-content {
  padding: 24px 28px;
}

.ts-rec-title {
  font-size: 20px;
  font-weight: 800;
  color: var(--ts-text-heading);
  margin: 0 0 16px;
  line-height: 1.3;
  height: 2.6em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ts-rec-footer-cta {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--ts-mint);
  font-weight: 800;
  font-size: 14px;
}

.ts-rec-footer-cta svg {
  transition: transform 0.3s ease;
}

.ts-rec-card:hover .ts-rec-footer-cta svg {
  transform: translate(3px, -3px);
}

.ts-rec-footer {
  margin-top: 40px;
}

@media (max-width: 1200px) {
  .ts-rec-card { flex: 0 0 calc(50% - 12px); }
}

@media (max-width: 600px) {
  .ts-rec-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .ts-rec-grid.scroll-x {
    gap: 16px;
    padding-left: 20px;
    padding-right: 20px;
  }
  .ts-rec-card { 
    flex: 0 0 88%; 
    min-width: unset; 
  }
  .no-mobile { display: none; }
}
</style>

<script>
(function() {
  const container = document.querySelector('.ts-rec-grid');
  const prevBtn = document.querySelector('.ts-scroll-prev');
  const nextBtn = document.querySelector('.ts-scroll-next');

  if (container && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', () => {
      container.scrollBy({ left: container.offsetWidth * 0.8, behavior: 'smooth' });
    });
    prevBtn.addEventListener('click', () => {
      container.scrollBy({ left: -container.offsetWidth * 0.8, behavior: 'smooth' });
    });
  }

  // Reveal
  const recRevealEls = document.querySelectorAll('#ts-recipes .ts-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  recRevealEls.forEach(el => observer.observe(el));
})();
</script>

{% schema %}
{
  "name": "Recipe Preview Scroll",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F9F7"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "TruSea Kitchen"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Heading",
      "default": "What Are You Cooking Today?"
    },
    {
      "type": "url",
      "id": "all_recipes_url",
      "label": "All Recipes Link"
    }
  ],
  "blocks": [
    {
      "type": "recipe_article",
      "name": "Recipe Article",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Select Recipe Article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipe Preview Scroll",
      "blocks": [
        { "type": "recipe_article" },
        { "type": "recipe_article" },
        { "type": "recipe_article" }
      ]
    }
  ]
}
{% endschema %}
