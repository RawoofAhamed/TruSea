{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-how-it-works ts-section" id="ts-how-it-works"
  style="--ts-hiw-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};"
>


  <div class="ts-container">
    <div class="ts-hiw-header ts-reveal">
      <h2 class="ts-hiw-heading">{{ section.settings.heading | default: 'Fresh Seafood in 3 Easy Steps' }}</h2>
    </div>

    <div class="ts-hiw-grid">
      <div class="ts-hiw-step ts-reveal ts-delay-1">
        <div class="ts-hiw-icon">1</div>
        <h3>Select Catch</h3>
        <p>Choose from our daily fresh catch directly from local fishermen.</p>
      </div>
      <div class="ts-hiw-step ts-reveal ts-delay-2">
        <div class="ts-hiw-icon">2</div>
        <h3>Expert Cutting</h3>
        <p>Hygienically prepared and cut to your exact preference.</p>
      </div>
      <div class="ts-hiw-step ts-reveal ts-delay-3">
        <div class="ts-hiw-icon">3</div>
        <h3>Fast Delivery</h3>
        <p>Doorstep delivery within hours, still chilled and fresh.</p>
      </div>
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-how-it-works { padding: 100px 0; overflow: visible !important; position: relative; }
.ts-hiw-header { text-align: center; margin-bottom: 64px; }
.ts-hiw-heading { font-size: clamp(28px, 4vw, 40px); font-weight: 900; color: var(--ts-navy); }
.ts-hiw-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
.ts-hiw-step { text-align: center; }
.ts-hiw-icon { 
  width: 60px; height: 600x; /* Wait, typo */
  width: 60px; height: 60px;
  background: var(--ts-mint); color: white;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 24px; font-weight: 800; margin: 0 auto 24px;
  box-shadow: 0 10px 20px rgba(60,191,160,0.3);
}
.ts-hiw-step h3 { font-size: 20px; font-weight: 800; color: var(--ts-navy); margin-bottom: 12px; }
.ts-hiw-step p { color: var(--ts-gray); font-size: 15px; line-height: 1.6; }

/* Decorative */

@media (max-width: 900px) {
  .ts-hiw-grid { grid-template-columns: 1fr; gap: 48px; }
}
</style>

<script>
(function() {
  const hiwRevealEls = document.querySelectorAll('#ts-how-it-works .ts-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  hiwRevealEls.forEach(el => observer.observe(el));
})();
</script>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh Seafood in 3 Easy Steps" }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}
