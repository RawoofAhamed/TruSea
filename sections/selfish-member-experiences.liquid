{% schema %}
{
  "name": "Member Only Experiences",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Member-Only Experiences"
    }
  ],
  "blocks": [
    {
      "type": "experience",
      "name": "Experience Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Experience Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Overlay Title",
          "default": "Experience title"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Member Only Experiences",
      "blocks": [
        { "type": "experience" },
        { "type": "experience" }
      ]
    }
  ]
}
{% endschema %}

<section class="member-exp-section">
  <div class="member-exp-container">
    <h2 class="member-exp-heading">{{ section.settings.section_heading }}</h2>

    <div class="member-exp-grid">
      {% for block in section.blocks %}
        <div class="member-exp-card" {{ block.shopify_attributes }}>
          
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.title }}"
            >
          {% endif %}

          <div class="member-exp-overlay">
            {{ block.settings.title }}
          </div>

        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
/* SECTION */
.member-exp-section {
  padding: 40px 0 30px;
}

.member-exp-container {
  max-width: 1400px;
  margin: auto;
  padding: 0 24px;
}

.member-exp-heading {
  text-align: center;
  font-size: 32px;
  margin-bottom: 26px;
}

/* GRID */
.member-exp-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
}

/* CARD */
.member-exp-card {
  position: relative;
  border-radius: 22px;
  overflow: hidden;
  border: 2px solid #e8c97a;
  box-shadow: 0 14px 36px rgba(0, 30, 60, 0.25);
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.member-exp-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* HOVER */
.member-exp-card:hover {
  transform: translateY(-6px);
  box-shadow:
    0 20px 48px rgba(0, 30, 60, 0.35),
    0 0 30px rgba(232,201,122,0.55);
}

/* OVERLAY TITLE */
.member-exp-overlay {
  position: absolute;
  left: 18px;
  bottom: 18px;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  padding: 10px 16px;
  border-radius: 14px;
  font-size: 16px;
  font-weight: 600;
  backdrop-filter: blur(4px);
}

/* MOBILE */
@media (max-width: 768px) {
  .member-exp-grid {
    grid-template-columns: 1fr;
  }
}
</style>
