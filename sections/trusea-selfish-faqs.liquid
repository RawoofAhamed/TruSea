{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-selfish-faqs ts-section" id="ts-selfish-faqs"
  style="
    --ts-faq-bg: {{ section.settings.bg_color | default: '#F5F9F7' }};
    --ts-faq-accent: {{ section.settings.accent_color | default: '#3CBFA0' }};
  "
>
  <div class="ts-container">
    <div class="ts-section-header ts-reveal-up">
      <div class="ts-tag">{{ section.settings.eyebrow | default: 'GOT QUESTIONS?' }}</div>
      <h2 class="ts-section-title">{{ section.settings.heading | default: 'FAQs' }}</h2>
    </div>

    <div class="ts-faq-list">
      {% for block in section.blocks %}
        <div class="ts-faq-item ts-reveal-up ts-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <details class="ts-faq-details" {% if forloop.first and section.settings.first_open %}open{% endif %}>
            <summary class="ts-faq-summary">
              <span class="ts-faq-qtext">{{ block.settings.question }}</span>
              <span class="ts-faq-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="ts-faq-content">
              <div class="ts-faq-inner">
                {{ block.settings.answer | newline_to_br }}
              </div>
            </div>
          </details>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-selfish-faqs {
  background: var(--ts-faq-bg);
  padding: 100px 0;
  font-family: var(--ts-font);
}

.ts-faq-list {
  max-width: 800px;
  margin: 60px auto 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.ts-faq-item {
  background: #fff;
  border-radius: 20px;
  border: 1.5px solid rgba(14,37,65,0.05);
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(14,37,65,0.02);
  transition: all .3s ease;
}
.ts-faq-item:hover {
  border-color: var(--ts-faq-accent);
  box-shadow: 0 10px 30px rgba(14,37,65,0.06);
}

.ts-faq-summary {
  list-style: none;
  cursor: pointer;
  padding: 24px 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  user-select: none;
}
.ts-faq-summary::-webkit-details-marker { display: none; }

.ts-faq-qtext {
  font-size: 18px;
  font-weight: 700;
  color: var(--ts-navy);
}

.ts-faq-icon {
  width: 40px; height: 40px;
  background: var(--ts-mint-pale);
  color: var(--ts-faq-accent);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .4s cubic-bezier(.34,1.56,.64,1);
  flex-shrink: 0;
}
.ts-faq-details[open] .ts-faq-icon {
  transform: rotate(180deg);
  background: var(--ts-faq-accent);
  color: #fff;
}

.ts-faq-content {
  overflow: hidden;
}

.ts-faq-inner {
  padding: 0 30px 30px;
  font-size: 15px;
  color: var(--ts-gray);
  line-height: 1.65;
  animation: ts-fade-in .3s ease;
}

@keyframes ts-fade-in {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 600px) {
  .ts-faq-summary { padding: 20px; }
  .ts-faq-qtext { font-size: 16px; }
  .ts-faq-inner { padding: 0 20px 20px; }
}
</style>

<script>
(function() {
  const revealEls = document.querySelectorAll('#ts-selfish-faqs .ts-reveal-up');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  revealEls.forEach(el => observer.observe(el));
})();
</script>

{% schema %}
{
  "name": "SelFish FAQs",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F9F7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#3CBFA0"
    },
    {
       "type": "text",
       "id": "eyebrow",
       "label": "Eyebrow tag",
       "default": "GOT QUESTIONS?"
    },
    {
       "type": "text",
       "id": "heading",
       "label": "Heading",
       "default": "FAQs"
    },
    {
      "type": "checkbox",
      "id": "first_open",
      "label": "Open first FAQ by default",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I get first access to the day’s catch?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Members can order from 5:45 AM, right after the catch lands at 5:30 AM. Public orders open only at 7:00 AM, so you always get the freshest and best selection first."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SelFish FAQs (Animated Accordion)"
    }
  ]
}
{% endschema %}
