{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-selfish-promo ts-section" id="ts-selfish-promo"
  style="
    --ts-sp-bg: {{ section.settings.bg_color | default: '#0E2541' }};
    --ts-sp-accent: {{ section.settings.accent_color | default: '#3CBFA0' }};
    --ts-sp-heading: {{ section.settings.heading_color | default: '#FFFFFF' }};
    --ts-sp-text: {{ section.settings.text_color | default: 'rgba(255,255,255,.65)' }};
  "
>
  <div class="ts-container">
    <!-- Header -->
    <div class="ts-sp-header ts-reveal">
      <div class="ts-tag">{{ section.settings.eyebrow | default: 'Join the SelFish Club' }}</div>
      <h2 class="ts-sp-title ">
        {{ section.settings.headline | default: 'Selfish Club | INAUGURAL YEAR OFFER — Free for a Year' }}
      </h2>
      <p class="ts-sp-subtitle">
        {{ section.settings.subtitle | default: "No forms. No fees. No fuss. Just sign up on TruSea and place your first order — you're automatically a SelFish Club member." }}
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="ts-sp-cards-grid">
      <!-- Card 1 -->
      <div class="ts-sp-benefit-card ts-reveal ts-delay-1">
        <div class="ts-sp-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ts-sp-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
        </div>
        <div class="ts-sp-card-content">
          <div class="ts-sp-card-label">Welcome Bonus</div>
          <h3 class="ts-sp-card-title">₹1,000 Credits on Us</h3>
          <p class="ts-sp-card-text">Get ₹1,000 SelFish Credits on joining, redeemable for an entire year.</p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="ts-sp-benefit-card ts-reveal ts-delay-2">
        <div class="ts-sp-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ts-sp-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="3"/><path d="M12 22V8"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/></svg>
        </div>
        <div class="ts-sp-card-content">
          <div class="ts-sp-card-label">Exclusive Experience</div>
          <h3 class="ts-sp-card-title">SelFish Sea Ride</h3>
          <p class="ts-sp-card-text">Go out to sea with our fishermen and watch the catch happen live.</p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="ts-sp-benefit-card ts-reveal ts-delay-3">
        <div class="ts-sp-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ts-sp-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.8V4a2 2 0 1 1 4 0v9.8"/><path d="M13 10c0-2 1.5-3 3-3s3 1 3 3v3.8"/><path d="M6 14h13a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2Z"/></svg>
        </div>
        <div class="ts-sp-card-content">
          <div class="ts-sp-card-label">For the food lover</div>
          <h3 class="ts-sp-card-title">Private Chef Sessions</h3>
          <p class="ts-sp-card-text">One-on-one cooking lessons with a professional 5-star chef at your home.</p>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="ts-sp-benefit-card ts-reveal ts-delay-4">
        <div class="ts-sp-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ts-sp-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        </div>
        <div class="ts-sp-card-content">
          <div class="ts-sp-card-label">Rare & Exclusive</div>
          <h3 class="ts-sp-card-title">First Access to Catches</h3>
          <p class="ts-sp-card-text">Get private notifications for rare species like Ghol and Yellowfin Tuna.</p>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="ts-sp-cta-actions ts-reveal ts-delay-5">
      <div class="ts-sp-buttons">
        <a href="/account/login" class="ts-btn ts-btn-primary">Join Now</a>
        <a href="/pages/selfish-club" class="ts-btn ts-btn-outline" style="border-color: rgba(255,255,255,0.2); color: #fff;">Know More</a>
      </div>
      <p class="ts-sp-limit-note">{{ section.settings.note | default: 'Limited to the first 1000 members.' }}</p>
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-selfish-promo {
  position: relative;
  background: var(--ts-sp-bg, var(--ts-navy));
  padding: 100px 0;
  font-family: var(--ts-font);
  overflow: hidden;
  color: var(--ts-sp-white, #FFFFFF);
}

.ts-sp-header { text-align: center; margin-bottom: 60px; }
.ts-sp-title { 
  font-size: clamp(32px, 5vw, 48px); font-weight: 900; line-height: 1.1; 
  margin: 12px 0 20px; letter-spacing: -.02em; 
  color: var(--ts-sp-accent);
}
.ts-sp-subtitle { font-size: 16px; opacity: 0.7; max-width: 600px; margin: 0 auto; line-height: 1.6; }

.ts-sp-cards-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  max-width: 1000px;
  margin: 0 auto 60px;
}

.ts-sp-benefit-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 24px;
  padding: 32px;
  display: flex;
  gap: 20px;
  align-items: flex-start;
  transition: var(--ts-transition);
}
.ts-sp-benefit-card:hover {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.15);
  transform: translateY(-5px);
}

.ts-sp-card-icon { 
  background: rgba(60,191,160,0.1); 
  width: 48px; height: 48px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ts-sp-card-label { font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--ts-sp-accent); letter-spacing: 0.05em; margin-bottom: 8px; }
.ts-sp-card-title { font-size: 20px; font-weight: 800; margin-bottom: 10px; color: #fff; }
.ts-sp-card-text { font-size: 14px; opacity: 0.6; line-height: 1.5; margin: 0; }

.ts-sp-cta-actions { text-align: center; }
.ts-sp-buttons { display: flex; justify-content: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.ts-sp-limit-note { font-size: 14px; font-weight: 700; color: var(--ts-sp-accent); opacity: 0.9; }

@media (max-width: 768px) {
  .ts-sp-cards-grid { grid-template-columns: 1fr; }
  .ts-sp-benefit-card { padding: 24px; }
  .ts-sp-buttons .ts-btn { width: 100%; justify-content: center; }
}
</style>

<script>
(function() {
  const els = document.querySelectorAll('#ts-selfish-promo .ts-reveal');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('ts-revealed'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  els.forEach(el => obs.observe(el));
})();
</script>

{% schema %}
{
  "name": "SelFish Club Promo",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0e2541"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#3cbfa0"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Join the SelFish Club"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Selfish Club - Inaugural Year Offer — Free for a Year"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "No forms. No fees. No fuss. Just sign up on TruSea and place your first order — you're automatically a SelFish Club member."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Limit Note",
      "default": "Limited to the first 1000 members."
    }
  ],
  "presets": [
    {
      "name": "SelFish Club Promo"
    }
  ]
}
{% endschema %}
