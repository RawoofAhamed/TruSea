{{ 'trusea-homepage.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_section != false %}
<section class="ts-selfish-pricing ts-section" id="ts-selfish-pricing"
  style="
    --ts-sp-bg: {{ section.settings.bg_color | default: '#F8FAFC' }};
    --ts-sp-accent: {{ section.settings.accent_color | default: '#3CBFA0' }};
  "
>
  <div class="ts-container">
    <div class="ts-section-header ts-reveal-up">
      <div class="ts-tag">{{ section.settings.eyebrow | default: 'CHOOSE YOUR PLAN' }}</div>
      <h2 class="ts-section-title">{{ section.settings.heading | default: 'Membership Plans' }}</h2>
    </div>

    <div class="ts-sp-grid">
      <!-- Monthly Plan -->
      <div class="ts-sp-card ts-reveal-up ts-delay-1">
        <div class="ts-sp-card-header">
          <h3 class="ts-sp-plan-name">Lite Monthly</h3>
          <div class="ts-sp-price-wrap">
            <span class="ts-sp-currency">₹</span>
            <span class="ts-sp-amount">{{ section.settings.month_price | replace: '₹', '' }}</span>
            <span class="ts-sp-period">/{{ section.settings.month_unit }}</span>
          </div>
        </div>
        <div class="ts-sp-card-body">
          <ul class="ts-sp-benefits">
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> 5:45 AM Early Access</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Unlimited Free Delivery</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> 10% SelFish Credits</li>
          </ul>
          <a href="/cart/add" class="ts-btn ts-btn-outline" style="width:100%; justify-content:center;">Get Lite</a>
        </div>
      </div>

      <!-- Annual Plan (Featured) -->
      <div class="ts-sp-card ts-sp-card--featured ts-reveal-up ts-delay-2">
        <div class="ts-sp-badge">MOST POPULAR</div>
        <div class="ts-sp-card-header">
          <h3 class="ts-sp-plan-name">Pro Annual</h3>
          <div class="ts-sp-price-wrap">
            <span class="ts-sp-currency">₹</span>
            <span class="ts-sp-amount">{{ section.settings.year_price | replace: '₹', '' }}</span>
            <span class="ts-sp-period">/{{ section.settings.year_unit }}</span>
          </div>
          <div class="ts-sp-save-note">{{ section.settings.badge_text | newline_to_br }}</div>
        </div>
        <div class="ts-sp-card-body">
          <ul class="ts-sp-benefits">
             <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> All Lite Features</li>
             <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Priority Delivery Slots</li>
             <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> 100% Joining Fee Credited*</li>
          </ul>
          <a href="/cart/add" class="ts-btn ts-btn-primary" style="width:100%; justify-content:center;">Join Pro Club</a>
        </div>
        
        {% if section.settings.ribbon_text != blank %}
        <div class="ts-sp-ribbon">
          <p>{{ section.settings.ribbon_text }}</p>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<style>
.ts-selfish-pricing {
  background: var(--ts-sp-bg);
  padding: 100px 0 140px;
  font-family: var(--ts-font);
}

.ts-sp-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
  max-width: 900px;
  margin: 60px auto 0;
  align-items: center;
}

.ts-sp-card {
  background: #fff;
  border-radius: 32px;
  padding: 48px;
  position: relative;
  border: 1px solid rgba(14,37,65,0.05);
  box-shadow: 0 10px 40px rgba(14,37,65,0.04);
  transition: all .4s cubic-bezier(.165,.84,.44,1);
}

.ts-sp-card--featured {
  background: var(--ts-navy);
  color: #fff;
  padding: 64px 48px;
  box-shadow: 0 30px 70px rgba(14,37,65,0.15);
  border: 4px solid var(--ts-sp-accent);
  transform: scale(1.05);
  z-index: 2;
}
.ts-sp-card--featured .ts-sp-plan-name { color: var(--ts-sp-accent); }
.ts-sp-card--featured .ts-sp-amount { color: #fff; }
.ts-sp-card--featured .ts-sp-benefits li { color: rgba(255,255,255,0.8); }
.ts-sp-card--featured .ts-sp-benefits li svg { color: var(--ts-sp-accent); }

.ts-sp-plan-name {
  font-size: 18px;
  font-weight: 800;
  color: var(--ts-navy);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 20px;
}

.ts-sp-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 4px;
}
.ts-sp-currency { font-size: 24px; font-weight: 700; }
.ts-sp-amount { font-size: 64px; font-weight: 950; color: var(--ts-navy); line-height: 1; }
.ts-sp-period { font-size: 16px; font-weight: 600; color: var(--ts-gray); }

.ts-sp-save-note {
  margin-top: 12px;
  font-size: 13px;
  font-weight: 700;
  color: var(--ts-sp-accent);
  line-height: 1.4;
}

.ts-sp-benefits {
  list-style: none;
  padding: 0;
  margin: 40px 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.ts-sp-benefits li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 15px;
  font-weight: 500;
  color: var(--ts-gray);
}
.ts-sp-benefits li svg { color: var(--ts-sp-accent); flex-shrink: 0; }

.ts-sp-badge {
  position: absolute;
  top: 24px; right: 24px;
  background: var(--ts-sp-accent);
  color: var(--ts-navy);
  font-size: 11px;
  font-weight: 800;
  padding: 6px 14px;
  border-radius: 20px;
}

.ts-sp-ribbon {
  position: absolute;
  bottom: -40px;
  left: 50%;
  transform: translateX(-50%);
  background: radial-gradient(circle at top left, #FEF3C7, #FDE68A);
  color: #92400E;
  padding: 12px 24px;
  border-radius: 16px;
  font-size: 12px;
  font-weight: 800;
  text-align: center;
  width: 90%;
  box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  border: 1px solid #FCD34D;
}
.ts-sp-ribbon p { margin: 0; }

@media (max-width: 900px) {
  .ts-sp-grid { grid-template-columns: 1fr; max-width: 450px; gap: 60px; }
  .ts-sp-card--featured { transform: scale(1); }
}
</style>

<script>
(function() {
  const revealEls = document.querySelectorAll('#ts-selfish-pricing .ts-reveal-up');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  revealEls.forEach(el => observer.observe(el));
})();
</script>

{% schema %}
{
  "name": "SelFish Pricing Plans",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F8FAFC"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#3CBFA0"
    },
    {
       "type": "text",
       "id": "eyebrow",
       "label": "Eyebrow tag",
       "default": "CHOOSE YOUR PLAN"
    },
    {
       "type": "text",
       "id": "heading",
       "label": "Heading",
       "default": "Membership Plans"
    },
    {
       "type": "text",
       "id": "month_price",
       "label": "Month Price",
       "default": "₹249"
    },
    {
       "type": "text",
       "id": "month_unit",
       "label": "Month Unit",
       "default": "month"
    },
    {
       "type": "text",
       "id": "year_price",
       "label": "Year Price",
       "default": "₹1999"
    },
    {
       "type": "text",
       "id": "year_unit",
       "label": "Year Unit",
       "default": "year"
    },
    {
      "type": "textarea",
      "id": "badge_text",
      "label": "Yearly Save Badge Text",
      "default": "Just 167rs\nper month\npaid annually"
    },
    {
      "type": "text",
      "id": "ribbon_text",
      "label": "Ribbon Text",
      "default": "100% of joining fee credited as SelFish Credits for the first 100 members"
    }
  ],
  "presets": [
    {
      "name": "SelFish Pricing (Premium Cards)"
    }
  ]
}
{% endschema %}
