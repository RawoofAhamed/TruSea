;\n      justify-content:space-between;\n      gap:10px;\n      margin-bottom: 8px;\n    }\n\n    .ts-club-badge{\n      font-size: 12px;\n      font-weight: 900;\n      padding: 6px 10px;\n      border-radius: 999px;\n      color:#0b1f33;\n      background: linear-gradient(180deg, #f6de97 0%, #d4af63 100%);\n      border: 1px solid rgba(150,110,35,.25);\n      box-shadow: 0 10px 18px rgba(212,175,99,.22);\n      position: relative;\n      overflow:hidden;\n    }\n    .ts-club-badge::after{\n      content:\"\";\n      position:absolute;\n      inset:-20px;\n      background: linear-gradient(110deg, transparent 35%, rgba(255,255,255,.55) 50%, transparent 65%);\n      transform: translateX(-140%);\n      animation: tsClubShine 4.6s ease-in-out infinite;\n      opacity:.6;\n      pointer-events:none;\n      mix-blend-mode: screen;\n    }\n    @keyframes tsClubShine{\n      0%{ transform: translateX(-140%); }\n      55%{ transform: translateX(140%); }\n      100%{ transform: translateX(140%); }\n    }\n\n    .ts-club-save{\n      font-size: 12px;\n      font-weight: 900;\n      color: rgba(11,31,51,.9);\n      padding: 6px 10px;\n      border-radius: 999px;\n      border: 1px solid rgba(11,31,51,.14);\n      background: rgba(240,247,255,.72);\n    }\n\n    .ts-club-title{\n      font-weight: 900;\n      font-size: 14px;\n      color:#0b1f33;\n      margin: 0 0 4px;\n    }\n\n    .ts-club-sub{\n      font-size: 12.5px;\n      line-height: 1.45;\n      color: rgba(13,43,68,.82);\n      margin: 0 0 10px;\n    }\n\n    .ts-club-actions{\n      display:flex;\n      gap:10px;\n    }\n\n    .ts-club-btn{\n      flex:1;\n      text-align:center;\n      padding: 10px 12px;\n      border-radius: 12px;\n      text-decoration:none;\n      font-weight: 900;\n      font-size: 12.5px;\n      transition: transform .15s ease, box-shadow .2s ease, opacity .2s ease;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      min-height: 44px;\n      box-sizing:border-box;\n    }\n\n    .ts-club-btn--gold{\n      color:#0b1f33;\n      background: linear-gradient(180deg, #f6de97 0%, #d4af63 100%);\n      border: 1px solid rgba(150,110,35,.28);\n      box-shadow: 0 14px 26px rgba(212,175,99,.22);\n      position: relative;\n      overflow:hidden;\n    }\n    .ts-club-btn--gold::after{\n      content:\"\";\n      position:absolute;\n      inset:-20px;\n      background: linear-gradient(110deg, transparent 35%, rgba(255,255,255,.50) 50%, transparent 65%);\n      transform: translateX(-140%);\n      animation: tsClubBtnShine 5.0s ease-in-out infinite;\n      opacity:.55;\n      pointer-events:none;\n      mix-blend-mode: screen;\n    }\n    @keyframes tsClubBtnShine{\n      0%{ transform: translateX(-140%); }\n      55%{ transform: translateX(140%); }\n      100%{ transform: translateX(140%); }\n    }\n\n    .ts-club-btn--ghost{\n      color:#0b1f33;\n      background: rgba(255,255,255,.78);\n      border: 1px solid rgba(11,31,51,.16);\n      box-shadow: 0 12px 22px rgba(0,30,60,.06);\n    }\n\n    .ts-club-btn:hover{ transform: translateY(-1px); }\n  </style>\n{% endif %}"
