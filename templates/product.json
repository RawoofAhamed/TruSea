          "settings": {
            "custom_liquid": "<style>\n  .bubble-wrapper {\n    margin: 20px 0;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  .bubble-label-main {\n    font-weight: bold;\n    margin-bottom: 10px;\n    display: block;\n    font-size: 14px;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  .bubble-options-container {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n\n  .bubble-item {\n    position: relative;\n  }\n\n  /* Hide the actual radio input */\n  .bubble-item input[type=\"radio\"] {\n    position: absolute;\n    opacity: 0;\n    width: 0;\n    height: 0;\n  }\n\n  /* Style for the Bubble/Pill */\n  .bubble-item label {\n    display: inline-block;\n    padding: 10px 20px;\n    border: 1px solid #d1d1d1;\n    border-radius: 50px;\n    cursor: pointer;\n    font-size: 14px;\n    transition: all 0.2s ease;\n    background-color: #fff;\n    color: #333;\n    text-align: center;\n  }\n\n  /* Hover State */\n  .bubble-item label:hover {\n    border-color: #000;\n    background-color: #f9f9f9;\n  }\n\n  /* Selected State - Black background with white text */\n  .bubble-item input[type=\"radio\"]:checked + label {\n    background-color: #000;\n    color: #fff;\n    border-color: #000;\n  }\n</style>\n\n<div class=\"bubble-wrapper\">\n  <span class=\"bubble-label-main\">Cut Type</span>\n  \n  <div class=\"bubble-options-container\">\n    {%- assign prep_options = \"Curry Cut, Fry Cut, Steak\" | split: \", \" -%}\n    \n    {%- for option in prep_options -%}\n      <div class=\"bubble-item\">\n        <input \n          type=\"radio\" \n          id=\"prep-{{ forloop.index }}\" \n          name=\"properties[Preparation Style]\" \n          value=\"{{ option }}\" \n          {% if option == \"Curry Cut\" %}checked{% endif %}\n          form=\"product-form-{{ section.id }}\"\n        >\n        <label for=\"prep-{{ forloop.index }}\">\n          {{ option }}\n        </label>\n      </div>\n    {%- endfor -%}\n  </div>\n</div>"
