        "step_VyAT7p": {
          "type": "step",
          "settings": {
            "title": "Prep the Fish",
            "text": "Wash the fish well with cold water, lime, and salt. Drain completely, then pat each slice dry with a paper towel. Patting dry is essential — soggy fish won't hold the spice paste."
          }
        },
        "step_nL7Ytt": {
          "type": "step",
          "settings": {
            "title": "Make the marinade",
            "text": "Combine turmeric, red chilli, coriander powder, pepper, ginger garlic paste, tamarind pulp, rice flour, and salt. Mix into a thick paste — do not add water. Use a few drops of lime juice if needed to bring it together."
          }
        },
        "step_n4kWkq": {
          "type": "step",
          "settings": {
            "title": "Marinate overnight",
            "text": "Apply the masala paste evenly on both sides of each fish slice. Cover and refrigerate overnight for the spices to fully penetrate the flesh. This step is the key to ultimate depth of flavour."
          }
        },
        "step_MrqATi": {
          "type": "step",
          "settings": {
            "title": "Bring to room temperature",
            "text": "Remove the fish from the refrigerator 30–40 minutes before frying. Cold fish placed in hot oil will remain raw at the centre."
          }
        },
        "step_DzbC4i": {
          "type": "step",
          "settings": {
            "title": "Pan fry to perfection",
            "text": "Heat oil in a pan on medium-low flame. Place the fish slices in and fry each side for 6–7 minutes undisturbed. Do not flip repeatedly — this causes the fish to break and cook unevenly. Serve hot."
          }
        },
