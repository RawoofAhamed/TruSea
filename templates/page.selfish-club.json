        "faq_TwkhYd": {
          "type": "faq",
          "settings": {
            "question": "How do I get first access to the day’s catch?",
            "answer": "Members can order from 5:45 AM, right after the catch lands at 5:30 AM. Public orders open only at 7:00 AM, so you always get the freshest and best selection first."
          }
        },
        "faq_jjRTxk": {
          "type": "faq",
          "settings": {
            "question": "What benefits do I get with free delivery?",
            "answer": "SelFish members enjoy unlimited free delivery with no minimum order value and access to priority delivery slots, even during peak demand."
          }
        },
        "faq_Ej6tmR": {
          "type": "faq",
          "settings": {
            "question": "How do SelFish Credits work?",
            "answer": "You earn 10% SelFish Credits on every order. These credits can be redeemed on future purchases with no restrictions or expiry."
          }
        },
        "faq_RWxxFH": {
          "type": "faq",
          "settings": {
            "question": "Can I access rare or seasonal fish?",
            "answer": "Yes. Limited and seasonal varieties are first shown to members before they are listed for regular customers."
          }
        },
        "faq_6maVFb": {
          "type": "faq",
          "settings": {
            "question": "Can I customize my orders?",
            "answer": "Your preferred cut style, boneless options, pack weight, and TruSea flavours are auto-saved for faster and personalized reordering."
          }
        }
